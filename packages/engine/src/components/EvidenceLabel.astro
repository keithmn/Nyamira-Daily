---
// Evidence labels identify the kind of source, not the scope or completeness of a check. Each site passes its own name.
// `text` and `meaning` replace the English wording where a page is in another language.
interface Props {
  kind: 'verified' | 'audit' | 'official' | 'unverified';
  site: string;
  what?: string;
  method?: string;
  checkedOn?: string;
  checkedBy?: string;
  text?: string;
  meaning?: string;
}
const { kind, site, what, method, checkedOn, checkedBy, text: givenText, meaning: givenMeaning } = Astro.props;
const text = givenText ?? { verified: 'Verified', audit: 'Audit finding', official: 'Official claim', unverified: 'Unverified' }[kind];
const meaning = givenMeaning ?? {
  verified: `${site} checked this specific claim; see the details for scope and method.`,
  audit: `This is a finding reported by an Auditor-General report, not a separate judgment by ${site}.`,
  official: 'This is what an official source states; it has not necessarily been independently verified.',
  unverified: 'This information has not yet been confirmed.',
}[kind];
const hasDetails = Boolean(what || method || checkedOn || checkedBy);
---
<span class={`label ${kind}`} aria-label={`${text}. ${meaning}`}>{text}</span>
{hasDetails && (
  <details class="evidence-detail small">
    <summary>Evidence details</summary>
    <dl>
      {what && <><dt>Claim checked</dt><dd>{what}</dd></>}
      {method && <><dt>Method</dt><dd>{method}</dd></>}
      {checkedOn && <><dt>Checked on</dt><dd>{checkedOn}</dd></>}
      {checkedBy && <><dt>Checked by</dt><dd>{checkedBy}</dd></>}
    </dl>
  </details>
)}
