---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CommunityRules from '../../components/CommunityRules.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Community" description="Our history, culture and language, recorded with people's consent so it stays with us.">
  <PageHead
    eyebrow="Living Heritage & Language"
    title="Community, Abagusii culture & Ekegusii"
    lead="Much of what our elders know has never been written down. We are recording history, stories and spoken Ekegusii with informed consent — so it stays with the community for generations."
  />

  <div class="stack-lg">
    <div class="fg-trio-blocks">
      <a class="fg-block-card is-charcoal" href="/community/abagusii/">
        <span class="fg-bc-icon"><Icon name="people" size={24} /></span>
        <h3>The Abagusii</h3>
        <p>Documented history and culture, with every account naming its book, archive or speaker.</p>
      </a>

      <a class="fg-block-card is-white" href="/community/archive/">
        <span class="fg-bc-icon"><Icon name="community" size={24} /></span>
        <h3>Culture archive</h3>
        <p>Recorded stories, oral histories and community knowledge checked by elders and a historian.</p>
      </a>

      <a class="fg-block-card is-signal" href="/community/language/">
        <span class="fg-bc-icon"><Icon name="explain" size={24} /></span>
        <h3>Ekegusii language</h3>
        <p>An open, speaker-consented Ekegusii text and speech dataset for schools, research and language tools.</p>
      </a>
    </div>

    <!-- Ekegusii summary (marked for native-speaker review) -->
    <div class="sw" lang="guz">
      <span class="eyebrow">Okoandikwa kw'Ekegusii</span>
      <p>Ebinto ebi abakori baito baramanyete tibierigwa. Tori koandika amang'ana, ebitanyi n'Ekegusii n'oboisanio — egento eki giatiywe n'abanto baito.</p>
    </div>

    <div class="fg-center-actions">
      <a class="fg-cta-btn" href="/community/share/">Share a recording or volunteer</a>
    </div>

    <CommunityRules />
  </div>
</Base>
