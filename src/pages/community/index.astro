---
// Community (decision #58): the social life of Nyamira's people, alongside the numbers.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EvidenceLabel from '../../components/EvidenceLabel.astro';
import Icon from '../../components/Icon.astro';
import CommunityCensus from '../../components/CommunityCensus.astro';
import census from '../../data/census.json';
import { sections } from '../../nav.js';
import { peopleAndPlaces } from '../../data/topics.js';
import { num } from '../../lib/fmt.js';
import { planned } from '../../config.js';
const c = census.county;
const community = sections.find((s) => s.label === 'Community');
const about = {
  '/community/people-and-places/': { tone: 'bloom', text: peopleAndPlaces.question },
  '/people/': { tone: 'harvest', text: 'Nurses, farmers, teachers and others who keep the county running, with their consent.' },
  '/whats-working/': { tone: 'avocado', text: 'Projects and services that do what they promised, with the evidence.' },
  '/heritage/': { tone: 'earth', text: 'Places, history and traditions of Nyamira, with sources.' },
  '/community/nyamira-since-2013/': { tone: 'rain', text: 'What has changed since devolution began, from the figures we hold.' },
};
---
<Base title="Community" description="The people of Nyamira: who lives here, what is working, the county's heritage and how it has changed since 2013.">
  <div class="sec-bloom">
    <PageHead eyebrow="Community" title="The people of Nyamira" lead="Who lives here, what is working, the county's heritage and how it has changed, alongside the numbers." tone="bloom" />
    <div class="stack-lg" style="margin-top:16px">
    <section class="card stack" aria-labelledby="community-count">
      <h2 id="community-count" class="vh">Nyamira's population</h2>
      <span class="figure"><span class="num">{num(c.population)}</span></span>
      <p class="say">people lived in Nyamira at the 2019 census, in {num(c.households)} households of about {c.avgHouseholdSize} people each.</p>
      <p class="source"><EvidenceLabel kind="official" /> <a href={c.url} rel="noopener">KNBS 2019 Kenya Population and Housing Census</a>, Volume I, {c.page.split(';')[0]}</p>
    </section>
    <CommunityCensus />
    <section class="stack" aria-labelledby="community-pages">
    <h2 id="community-pages">Explore Community</h2>
    <div class="sector-tiles">
      {community.pages.map((p) => (
        <a class={`sector-tile sec-${about[p.href]?.tone ?? 'bloom'}`} href={p.href}>
          <Icon name={p.icon} size={28} badge />
          <h2>{p.label}</h2>
          <p>{about[p.href]?.text ?? p.desc}</p>
          {planned.has(p.href) && <span class="tag-planned" style="align-self:flex-start;color:inherit;border-color:currentColor">Planned</span>}
          <span class="go" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    </section>
    </div>
  </div>
</Base>
