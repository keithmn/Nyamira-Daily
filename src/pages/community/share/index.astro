---
// Share or volunteer (decision #122): offer a story or record, volunteer to record, or send a tip or concern.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ContactForm from '../../../components/ContactForm.astro';
import CommunityRules from '../../../components/CommunityRules.astro';
const ways = [
  ['01', 'Share a story or record', 'Tell us what you have and who holds it. We get in touch before anything is recorded.'],
  ['02', 'Volunteer to record', 'We train you in field recording and informed consent across Nyamira wards.'],
  ['03', 'Send a tip or concern', 'Flag anything we should know about this work, including anything we have got wrong.'],
];
---
<Base title="Share or volunteer" description="Offer a story, a song or a record, volunteer to record elders, or send a concern.">
  <PageHead eyebrow="Community · Take Part" title="Share or volunteer" lead="Do you know a story, a song or an elder we should record? Tell us, or join us as a volunteer." crumbs={[{ href: '/community/', label: 'Community' }]} />
  <div class="stack-lg">
    <section class="fg-sheet">
      <div class="fg-sec-head" style="margin-bottom:20px">
        <span class="fg-kicker">THREE WAYS TO TAKE PART</span>
        <h2>Contribute with <em>full speaker agreement</em></h2>
        <p class="fg-sec-sub">Please do not send a recording of another person without their agreement. See <a href="/about/careers/">careers and volunteering</a> for volunteer roles.</p>
      </div>
      <div class="fg-ticket-grid" style="margin-bottom:24px">
        {ways.map(([n, t, d], i) => (
          <div class={`fg-ticket${i === 0 ? ' is-next' : ''}`}>
            <div class="fg-ticket-stub"><span class="fg-stub-k">WAY</span><strong class="fg-stub-d">{n}</strong></div>
            <div class="fg-ticket-body"><h3>{t}</h3><p>{d}</p></div>
          </div>
        ))}
      </div>
      <ContactForm topics={['story', 'volunteer', 'tip', 'concern']} preset="story" />
    </section>
    <CommunityRules />
  </div>
</Base>
