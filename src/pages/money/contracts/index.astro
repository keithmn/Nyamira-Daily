---
// Contracts & NG-CDF (design/field-guide): ticket summary cards, offset-shadow search box, county vs national separate.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ContractRow from '../../../components/ContractRow.astro';
import EvidenceLabel from '../../../components/EvidenceLabel.astro';
import { contracts, byGroup, groups, groupOrder, totals } from '../../../lib/contracts.js';
import { ksh } from '../../../lib/fmt.js';

const largest = (list) => [...list].filter((c) => c.amount != null).sort((a, b) => b.amount - a.amount).slice(0, 5);
const byG = groupOrder.map((g) => {
  const list = byGroup(g);
  return { g, info: groups[g], list, t: totals(list) };
});
const county = byG.filter((x) => !x.info.who.startsWith('National'));
const national = byG.filter((x) => x.info.who.startsWith('National'));
---
<Base title="Contracts and NG-CDF in Nyamira" description="1,628 contracts and allocations in Nyamira: the county's own, national roads, and NG-CDF, each with its source and page.">
  <PageHead
    eyebrow="Public Books · Procurement & Allocations"
    title="Contracts, national roads & NG-CDF in Nyamira"
    lead={`${contracts.length.toLocaleString('en-GB')} contracts and allocations consolidated from official sources — county and national money kept strictly separate, every row naming its report and page.`}
    crumbs={[{ href: '/money/', label: 'Money' }, { href: '/money/contracts/', label: 'Contracts' }]}
  />

  <div class="stack-lg">
    <ul class="fg-ticket-grid">
      {byG.map(({ g, info, t }) => (
        <li class={`fg-ticket${!info.who.startsWith('National') ? ' is-next' : ''}`}>
          <div class="fg-ticket-stub">
            <span class="fg-stub-by">{info.who.startsWith('National') ? 'National' : 'County'}</span>
            <b>{t.count.toLocaleString('en-GB')}</b>
            <span class="fg-stub-yr">{t.count === 1 ? 'record' : 'records'}</span>
          </div>
          <div class="fg-ticket-body">
            <a href={`/money/contracts/?group=${g}`}>{info.label}</a>
            <p>{t.withAmount ? `${ksh(t.value)} across ${t.withAmount.toLocaleString('en-GB')} priced ${t.withAmount === 1 ? 'row' : 'rows'}` : 'Official records'}</p>
          </div>
        </li>
      ))}
    </ul>

    <section class="fg-solid-sheet stack" aria-labelledby="find">
      <div class="row-head">
        <h2 id="find">Search all <span class="fg-hl">{contracts.length.toLocaleString('en-GB')} records</span></h2>
        <a class="fg-outline-btn" href="/files/contracts.csv">Download CSV (CC BY 4.0)</a>
      </div>
      <form class="tk-filters" data-ct-search action="/money/contracts/" method="get">
        <label class="tk-f">Search
          <input type="search" name="q" placeholder="A road, a school, a contractor, a tender number..." autocomplete="off" />
        </label>
        <label class="tk-f">Whose money
          <select name="group"><option value="">All registers</option>{groupOrder.map((g) => <option value={g}>{groups[g].label}</option>)}</select>
        </label>
        <p class="tk-count small muted" data-ct-status aria-live="polite">Type to search all {contracts.length.toLocaleString('en-GB')}. The list loads when you start (about 120 KB).</p>
      </form>
      <ul class="ct-list" data-ct-results></ul>
      <noscript><p class="small">Without JavaScript, download <a href="/files/contracts.csv">every contract as a CSV file</a>.</p></noscript>
    </section>

    {[['County money', county], ['National money spent in Nyamira', national]].map(([title, list]) => (
      <section class="fg-dashed-sheet stack">
        <h2>{title}</h2>
        {title !== 'County money' && <p class="small muted">National agencies' contracts and NG-CDF allocations in Nyamira. This is national money: it is never added to the county's figures.</p>}
        {list.map(({ g, info, list: items, t }) => (
          <details>
            <summary>{info.label}: {t.count.toLocaleString('en-GB')} {t.count === 1 ? 'record' : 'records'}{t.withAmount ? `, ${ksh(t.value)} in ${t.withAmount.toLocaleString('en-GB')} priced ${t.withAmount === 1 ? 'row' : 'rows'}` : ''}</summary>
            <p class="small" style="margin-top:8px">{info.blurb} Amounts are contract sums or allocations as printed, not money paid.</p>
            <h3 class="mini">The five largest</h3>
            <ul class="ct-list">{largest(items).map((c) => <ContractRow c={c} />)}</ul>
            <p class="small" style="margin-top:8px"><a href={`/money/contracts/?group=${g}`}>Search only {info.label} →</a></p>
          </details>
        ))}
      </section>
    ))}

    <p class="source"><EvidenceLabel kind="official" /> From the Public Procurement Information Portal, the county's own reports, KeRRA, KURA, KeNHA and the NG-CDF Board. Each result names its source and page.</p>
    <p class="small muted">Updated when new contracts are published on PPIP, new NG-CDF allocations appear on the CDF Board website, or KeRRA/KURA/KeNHA publish new awards. Last checked: October 2026.</p>

    <!-- Kiswahili: needs native-speaker review -->
    <div class="sw" lang="sw"><span class="eyebrow">Muhtasari kwa Kiswahili</span><p>Mikataba yote ya kaunti na ya kitaifa iliyotolewa Nyamira — tenda za kaunti, miradi ya NG-CDF, na barabara za kitaifa — kila moja ikionyesha chanzo chake, kiasi na mwaka wa fedha.</p></div>
  </div>

  <script is:inline>
  (function () {
    var form = document.querySelector('[data-ct-search]'); if (!form) return;
    var q = form.querySelector('[name=q]'), g = form.querySelector('[name=group]');
    var st = form.querySelector('[data-ct-status]'), out = document.querySelector('[data-ct-results]');
    var data = null, loading = null;
    var ksh = function (n) { return n >= 1e9 ? 'KSh ' + (n/1e9).toFixed(2).replace(/\.?0+$/,'') + 'B' : n >= 1e6 ? 'KSh ' + (n/1e6).toFixed(1).replace(/\.0$/,'') + 'M' : n >= 1e3 ? 'KSh ' + Math.round(n/1e3).toLocaleString('en-GB') + 'K' : 'KSh ' + n; };
    function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
    function load() {
      if (data) return Promise.resolve(data);
      if (!loading) { st.textContent = 'Loading the contract list\u2026'; loading = fetch('/money/contracts/search.json').then(function (r) { return r.json(); }).then(function (d) { data = d; return d; }); }
      return loading;
    }
    function run() {
      var words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean), gv = g.value;
      if (!words.length && !gv) { out.innerHTML = ''; st.textContent = 'Type to search, or pick a group.'; return; }
      load().then(function (d) {
        var hits = d.rows.filter(function (r) {
          if (gv && r.g !== gv) return false;
          if (!words.length) return true;
          var hay = (r.t + ' ' + (r.c || '') + ' ' + (r.w || '') + ' ' + (r.f || '') + ' ' + (r.y || '')).toLowerCase();
          return words.every(function (w) { return hay.indexOf(w) >= 0; });
        });
        var shown = hits.slice(0, 60);
        st.textContent = hits.length.toLocaleString('en-GB') + (hits.length === 1 ? ' match' : ' matches') + (hits.length > shown.length ? ' (showing the largest ' + shown.length + '; narrow your search to see the rest)' : '') + '.';
        out.innerHTML = shown.map(function (r) {
          var meta = [d.groups[r.g], r.y, r.w, r.f].filter(Boolean).map(esc).join(' \u00b7 ');
          var s = r.s ? '<span class="ct-st st-' + r.s + '">' + (r.s === 'ongoing' ? 'In progress' : r.s === 'complete' ? 'Finished' : 'Ended early') + '</span>' : '';
          return '<li class="ct-row"><div class="ct-main"><span class="ct-title">' + esc(r.t) + '</span>'
            + (r.c ? '<span class="ct-co">' + esc(r.c) + '</span>' : '')
            + '<span class="ct-meta">' + meta + '</span>'
            + '<span class="ct-src">Source: ' + esc(d.sources[r.src]) + (r.p ? ', ' + esc(r.p) : '') + '</span></div>'
            + '<div class="ct-amt">' + (r.a != null ? '<b>' + ksh(r.a) + '</b>' : '<span class="muted">not printed</span>') + s + '</div></li>';
        }).join('');
      });
    }
    q.addEventListener('input', run); g.addEventListener('change', run);
    form.addEventListener('submit', function (e) { e.preventDefault(); run(); });
    var p = new URLSearchParams(location.search);
    if (p.get('q')) q.value = p.get('q');
    if (p.get('group')) g.value = p.get('group');
    if (q.value || g.value) run();
  })();
  </script>
</Base>
