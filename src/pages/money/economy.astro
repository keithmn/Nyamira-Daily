---
// The Nyamira economy (decision #116): the money that comes into the county and how it moves, from the figures we
// hold, each with its source. County money, national money and private income are different measures and are never
// added together. Where there is no figure, the page says so.
import MoneyShell from '../../components/money/MoneyShell.astro';
import EvidenceLabel from '../../components/EvidenceLabel.astro';
import { ksh } from '../../lib/fmt.js';
import { fig, shortTitle } from '../../lib/county-registry.js';
import N from '../../data/ngcdf.json';
import T from '../../data/teamilk.json';
import { contracts, groups } from '../../lib/contracts.js';
import prices from '../../data/living/prices.json';

const S = 'ke.fy2025-26.spent.county.nyamira';
const eqGot = fig(`${S}.equitable-share-received`);
const osrA = fig(`${S}.osr-actual`);
const m = (v) => ksh(v * 1e6); // registry figures are in KSh million

// NG-CDF: the latest year all four constituencies report
const fys = [...new Set(N.allocations.map((a) => a.fy))].sort();
const full = fys.filter((fy) => N.allocations.filter((a) => a.fy === fy).length >= 4);
const cdfFy = full.at(-1);
const cdf = N.allocations.filter((a) => a.fy === cdfFy);
const cdfTotal = cdf.reduce((n, a) => n + a.amountKsh, 0);
const cdfSrc = N.sources.find((s) => s.id === cdf[0]?.sourceId);

// National agencies' contracts awarded in Nyamira, by financial year (contract sums, not payments)
const nat = contracts.filter((c) => c.national && c.kind === 'contract' && c.amount != null && c.fy);
const natYears = [...new Set(nat.map((c) => c.fy))].sort().slice(-3).reverse();
const natRows = natYears.map((fy) => { const l = nat.filter((c) => c.fy === fy); return { fy, n: l.length, v: l.reduce((s, c) => s + c.amount, 0) }; });

// Tea: the latest bonus each factory announced, in KSh per kg (no totals: we do not hold the kilograms)
const latestTea = Object.values(T.tea.reduce((acc, r) => { if (r.measure === 'bonus' && (!acc[r.factory] || r.fy > acc[r.factory].fy)) acc[r.factory] = r; return acc; }, {})).sort((a, b) => b.kshPerKg - a.kshPerKg);
const teaSrc = (id) => T.sources.find((s) => s.id === id);

// Market prices from the field form (fieldwork/README.md): the latest price per item and unit
const latestPrices = Object.values(prices.reduce((acc, p) => { const k = `${p.item}|${p.unit}`; if (!acc[k] || p.observed_on > acc[k].observed_on) acc[k] = p; return acc; }, {}));
---
<MoneyShell title="The Nyamira economy: county and national money" lead="The money that comes into Nyamira, where it comes from, and how it moves. Each figure has its source. County money, national money and what households earn are different things, so we never add them together." crumbs={[{ href: '/money/economy/', label: 'The economy' }]}>
  <section class="stack" aria-labelledby="in">
    <h2 id="in">Money coming in</h2>
    <div class="table-box"><table class="cards">
      <thead><tr><th>What</th><th>Amount</th><th>Period</th><th>Whose money</th><th>Source</th></tr></thead>
      <tbody>
        <tr><td>The county's share of national revenue (equitable share), received</td><td data-label="Amount"><strong>{m(eqGot.value)}</strong></td><td data-label="Period">FY2025/26</td><td data-label="Whose money">County</td><td data-label="Source"><EvidenceLabel kind={eqGot.label} /> <a href={eqGot.doc.url} rel="noopener">{shortTitle(eqGot.doc)}</a>, {eqGot.page}</td></tr>
        <tr><td>Money the county raised itself (fees, rates, charges)</td><td data-label="Amount"><strong>{m(osrA.value)}</strong></td><td data-label="Period">FY2025/26</td><td data-label="Whose money">County</td><td data-label="Source"><EvidenceLabel kind={osrA.label} /> <a href={osrA.doc.url} rel="noopener">{shortTitle(osrA.doc)}</a>, {osrA.page}</td></tr>
        {cdfFy && <tr><td>NG-CDF allocations to Nyamira's four constituencies</td><td data-label="Amount"><strong>{ksh(cdfTotal)}</strong></td><td data-label="Period">FY{cdfFy}</td><td data-label="Whose money">National</td><td data-label="Source"><EvidenceLabel kind="official" /> {cdfSrc ? <a href={cdfSrc.url} rel="noopener">{cdfSrc.publisher}</a> : 'NG-CDF Board'}, one row per constituency</td></tr>}
      </tbody>
    </table></div>
    <p class="small"><a href="/money/revenue/">Where the county's money comes from, year by year</a></p>
  </section>

  <section class="stack" style="margin-top:32px" aria-labelledby="national">
    <h2 id="national">National agencies' contracts in Nyamira</h2>
    <p>Road, water, school and other works that national agencies awarded in the county. These are contract sums as printed, not money paid, and they are national money.</p>
    <div class="table-box"><table>
      <thead><tr><th>Financial year</th><th class="num">Contracts with an amount</th><th class="num">Contract sums</th></tr></thead>
      <tbody>{natRows.map((r) => <tr><td>FY{r.fy}</td><td class="num">{r.n}</td><td class="num">{ksh(r.v)}</td></tr>)}</tbody>
    </table></div>
    <p class="small"><EvidenceLabel kind="official" /> From the agencies' published awards. <a href="/money/contracts/">Every contract, with its source</a>. Groups: {Object.values(groups).filter((g) => g.who.startsWith('National')).map((g) => g.label).join(', ')}.</p>
  </section>

  <section class="stack" style="margin-top:32px" aria-labelledby="tea">
    <h2 id="tea">Tea: what factories pay farmers</h2>
    <p>The bonus each tea factory announced, per kilogram of green leaf. We do not yet hold how many kilograms each factory bought, so we cannot add these up to a total for the county.</p>
    <div class="table-box"><table class="cards">
      <thead><tr><th>Factory</th><th class="num">Bonus, KSh per kg</th><th>Year</th><th>Source</th></tr></thead>
      <tbody>{latestTea.map((r) => <tr><td>{r.factory}</td><td class="num" data-label="KSh per kg">{r.kshPerKg}</td><td data-label="Year">{r.fy}</td><td data-label="Source">{teaSrc(r.sourceId) ? <a href={teaSrc(r.sourceId).url} rel="noopener">{teaSrc(r.sourceId).publisher ?? teaSrc(r.sourceId).title}</a> : r.sourceId}</td></tr>)}</tbody>
    </table></div>
    <p class="small"><a href="/money/farming/">More on farming</a></p>
  </section>

  <section class="stack" style="margin-top:32px" aria-labelledby="prices">
    <h2 id="prices">Market prices</h2>
    <p class="small muted">Market prices are collected by our field team on market days. The national KAMIS system (kamis.kilimo.go.ke) is not publicly accessible without a Kenyan IP address, so this section updates only when our team visits a market.</p>
    {latestPrices.length === 0 ? (
      <p>No market prices recorded yet. Our field team records them on market days with the market prices form.</p>
    ) : (
      <div class="table-box"><table class="cards">
        <thead><tr><th>Item</th><th class="num">Price</th><th>Unit</th><th>Seen</th><th>Label</th></tr></thead>
        <tbody>{latestPrices.map((p) => <tr><td>{p.item}</td><td class="num" data-label="Price">{ksh(p.price_ksh / (p.quantity || 1))}</td><td data-label="Unit">per {p.unit}</td><td data-label="Seen">{p.observed_on}</td><td data-label="Label"><EvidenceLabel kind={p.evidence} /></td></tr>)}</tbody>
      </table></div>
    )}
  </section>

  <section class="stack" style="margin-top:32px" aria-labelledby="missing">
    <h2 id="missing">What we do not measure yet</h2>
    <ul>
      <li><strong>The size of the county's economy, by sector.</strong> The Kenya National Bureau of Statistics publishes a Gross County Product report; we have not loaded it yet.</li>
      <li><strong>Money sent home</strong> by people from Nyamira working elsewhere.</li>
      <li><strong>Milk prices</strong> paid to farmers: no published figures found yet.</li>
      <li><strong>How much tea each factory bought</strong>, so the bonuses can be turned into money paid.</li>
    </ul>
    <p class="small">Know a source for one of these? <a href="/about/rules/#corrections">Tell us</a>.</p>
  </section>

  <!-- Kiswahili: needs native-speaker review -->
  <div class="sw" lang="sw"><span class="eyebrow">Muhtasari kwa Kiswahili</span><p>Pesa zinazoingia Kaunti ya Nyamira — mgao sawa kutoka serikali kuu, mapato ya ndani, mikataba ya kitaifa, na bonasi za chai kwa wakulima. Kila takwimu inataja chanzo chake.</p></div>
</MoneyShell>
