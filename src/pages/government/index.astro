---
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { planned } from '../../config.js';
import PageHead from '../../components/PageHead.astro';
const parts = [
  { i: 'question', href: '/government/whos-in-charge/', title: "Who's in charge?", text: 'Pick a problem and see who is responsible for fixing it: the county, the national government, or someone else.' },
  { i: 'people', href: '/government/leaders/', title: 'Leaders', text: 'Every elected leader in Nyamira, what their job is, and how to reach their office.' },
  { i: 'office', href: '/government/executive/', title: 'The Executive', text: 'The Governor and the county departments that run services and spend the money.' },
  { i: 'government', href: '/government/assembly/', title: 'The Assembly', text: 'What the County Assembly debated and decided, sitting by sitting.' },
  { i: 'search', href: '/government/watchdogs/', title: 'Watchdogs and complaints', text: 'The bodies that check the county, and how to use them.' },
];
---
<Base title="Government">
  <PageHead eyebrow="Government" title="How Nyamira is run" lead="Who spends the money, who makes the laws, who is responsible for each problem, and who checks them." tools={false} />
  <div class="grid" style="margin-top:16px">
    {parts.map((p) => (<a class={`card${planned.has(p.href) ? ' is-planned' : ''}`} href={p.href}><Icon name={p.i ?? 'source'} size={26} badge /><h2 style="font-size:18px">{p.title} {planned.has(p.href) && <span class="tag-planned">Planned</span>}</h2><p class="muted">{p.text}</p></a>))}
  </div>
</Base>
