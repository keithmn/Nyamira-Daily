---
// NY Watch (decision #63, recast by #79): the data review podcast, hosted by the founder. Each episode reviews one
// set of figures on this site: what the records say, what they leave out, and the questions to ask. Guests are
// optional; when office holders appear, every office is offered the same access (EDITORIAL_RULES section 14).
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import NyWatchLogo from '../../components/NyWatchLogo.astro';
import { entries } from '../../lib/content.js';
import { date } from '../../lib/fmt.js';
import { media } from '../../config.js';
import { publisher } from '../../county.js';
import ElectionNotice from '../../components/ElectionNotice.astro';
const list = (await entries('episodes')).filter((e) => e.data.series === 'ny-watch').sort((a, b) => b.data.date - a.data.date);
const offices = [...new Set(list.flatMap((e) => e.data.guests.map((g) => g.office)))];
---
<Base title="NY Watch" description={`The data review podcast from Nyamira Daily, hosted by ${publisher.founder}.`}>
  <PageHead eyebrow="Today" title="NY Watch" lead={`The data review podcast, hosted by ${publisher.founder}. Each episode takes one set of figures from this site, such as the county budget, a ward's projects or a list of contracts, and goes through what the records say, what they leave out, and the questions to ask.`} crumbs={[{ href: '/', label: 'Today' }, { href: '/ny-watch/', label: 'NY Watch' }]} />
  <div class="nyw" style="margin-top:16px"><NyWatchLogo /></div>
  <ElectionNotice />
  <p class="small muted">Every figure in an episode comes from this site, with its source and evidence label, and each episode page links the data it reviews. NY Watch reviews records, not politicians: it does not campaign for or against any party, candidate or office holder.</p>
  {media.podcastUrl && <p><a class="btn" href={media.podcastUrl} rel="noopener">Listen to the podcast</a></p>}
  {list.length === 0 && <p class="muted">Nothing published here yet.</p>}
  <ul class="rows" style="margin-top:16px">
    {list.map((e) => <li><a class="row-link" href={`/ny-watch/${e.id}/`}><span><span class="t">{e.data.title}</span><span class="d">Episode {e.data.number} · {date(e.data.date.toISOString())}{e.data.guests.length > 0 && ` · With ${e.data.guests.map((g) => g.office).join(', ')}`}</span></span><span class="go" aria-hidden="true">→</span></a></li>)}
  </ul>
  {offices.length > 0 && <p class="small muted">Offices that have appeared: {offices.join('; ')}. Every office is offered the same time and the same questions.</p>}
</Base>
