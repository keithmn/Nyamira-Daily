---
// The county map (decision #55): one map with several views, like layers in a map app.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import AtlasMap from '../../components/AtlasMap.astro';
import { getAlerts, isLive } from '../../lib/alerts-data.js';
const liveAlerts = (await getAlerts()).filter(isLive);
---
<Base title="Map" description="One map of Nyamira County with views for finding your ward, our facility list, ward project money and civic alerts.">
  <PageHead eyebrow="Wards" title="Map of Nyamira" lead="One map, four views. Switch between wards, facilities, ward money and alerts; zoom in, and tap a ward to see its details." icon="map" crumbs={[{ href: '/ward/', label: 'Wards' }, { href: '/maps/', label: 'Map' }]} />
  <div style="margin-top:16px"><AtlasMap alerts={liveAlerts} /></div>
</Base>
