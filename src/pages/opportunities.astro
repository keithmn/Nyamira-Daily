---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import O from '../data/opportunities.json';
import { date } from '../lib/fmt.js';
import { opportunitiesAt, daysUntilDeadline } from '../lib/opportunity-status.js';
import { publicationTime } from '../lib/publication.js';
const checkedAt = publicationTime;
const items = opportunitiesAt(O.items, checkedAt);
const open = items.filter((i) => i.availability === 'open');
const past = items.filter((i) => i.availability === 'closed');
const cancelled = items.filter((i) => i.availability === 'cancelled');
const unknown = items.filter((i) => ['deadline_unknown', 'unknown'].includes(i.availability));
const typeName = { job: 'Job', tender: 'Tender', bursary: 'Bursary', programme: 'Programme' };
---
<Base title="Opportunities">
  <PageHead title="Opportunities" lead="County jobs, tenders, bursaries and programmes, with deadlines and how to apply." />
  <p class="updated">Deadline status calculated at build time ({checkedAt.toLocaleString('en-GB', { timeZone: 'Africa/Nairobi', dateStyle: 'medium', timeStyle: 'short' })} EAT). Source details last checked {date(O.checked)}. Rebuild to refresh status, and confirm details with the office named before you apply.</p>
  <div class="stack-lg" style="margin-top:16px">
    <section class="stack">
      <h2>Open at the last build ({open.length})</h2>
      {open.length === 0 && <p class="muted">Nothing open at the moment. See the recent examples below for what to watch for.</p>}
      {open.map((i) => (
        <article class="card">
          <span class="eyebrow">{typeName[i.type]} · closes {i.closes}</span>
          <h3>{i.title}</h3>
          <span class="due">Closes {date(i.closes)}{daysUntilDeadline(i, checkedAt) === 0 ? ' · today' : daysUntilDeadline(i, checkedAt) === 1 ? ' · tomorrow' : ` · in ${daysUntilDeadline(i, checkedAt)} days`}</span>
          <span class="small muted">{i.by}</span>
          {i.reserved ? <span class="label verified">Reserved: {i.reserved}</span> : <span class="small">Open to all qualified applicants (not reserved).</span>}
          <details><summary>How to apply</summary><p class="small">{i.howToApply}</p></details>
          <a class="small" href={i.url} rel="noopener">Official notice (published {date(i.published)})</a>
        </article>
      ))}
    </section>

    <section class="stack">
      <h2>How it works</h2>
      {O.howTo.map((h) => (
        <details>
          <summary>{h.title}</summary>
          <ol class="small">{h.steps.map((s) => <li>{s}</li>)}</ol>
          {h.url && <a class="small" href={h.url} rel="noopener">Source</a>}
        </details>
      ))}
    </section>

    <section class="stack">
      <h2>Closed</h2>
      <p class="muted small">These notices are no longer open according to their recorded status or deadline.</p>
      <div class="table-box">
        <table class="cards">
          <thead><tr><th>What</th><th>Type</th><th>Deadline/status</th><th>Notice</th></tr></thead>
          <tbody>{past.map((i) => (<tr><td>{i.title}</td><td data-label="Type">{typeName[i.type]}</td><td data-label="Deadline/status">{i.closes ?? 'Closed; date not stated'}</td><td data-label="Notice"><a href={i.url} rel="noopener">Source</a></td></tr>))}</tbody>
        </table>
      </div>
    </section>
    {cancelled.length > 0 && <section class="stack"><h2>Cancelled</h2><ul>{cancelled.map((i) => <li>{i.title} · <a href={i.url} rel="noopener">official notice</a></li>)}</ul></section>}
    {unknown.length > 0 && <section class="stack"><h2>Deadline or status unknown</h2><p class="muted">These are not counted as open because the recorded deadline or status is missing or unclear.</p><ul>{unknown.map((i) => <li>{i.title} · {i.closes ?? 'No closing date recorded'} · <a href={i.url} rel="noopener">official notice</a></li>)}</ul></section>}
    <div class="sw" lang="sw">
      <span class="eyebrow">Muhtasari kwa Kiswahili</span>
      <p>Hapa utapata nafasi za kazi za kaunti, zabuni, basari na mipango ya vijana, pamoja na tarehe za mwisho. Thibitisha kila tangazo na ofisi husika kabla ya kutuma maombi.</p>
    </div>
  </div>
</Base>
