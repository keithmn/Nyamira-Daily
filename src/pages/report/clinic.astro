---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ReportForm from '../../components/ReportForm.astro';
---
<Base title="Clinic check" description="Tell us about your visit to a dispensary or health centre: medicines, staff, opening hours and waiting time.">
  <PageHead eyebrow="Places · Health Facilities" title="Clinic check" lead="After a visit to a dispensary or health centre, tell us four things: medicines, staff on duty, opening hours and waiting time. Results are shown per facility, as community reports, once checked." crumbs={[{ href: '/map/', label: 'Places' }, { href: '/report/', label: 'Report a place' }]} />
  <div class="fg-sheet fg-sheet-solid stack">
    <div class="fg-report-head">
      <div>
        <span class="fg-kicker">FOUR QUICK QUESTIONS · 125 LISTED HEALTH FACILITIES</span>
        <h2>Check a dispensary or health centre</h2>
      </div>
      <a class="fg-outline-btn" href="/report/">← All place types</a>
    </div>
    <ReportForm clinic />
    <p class="small muted">Please don't include names of patients or staff, or anything about your own health. We publish only totals per facility.</p>
  </div>
  <div class="sw" lang="sw" style="margin-top:24px"><span class="eyebrow">Muhtasari kwa Kiswahili</span><p>Baada ya kutembelea zahanati, tuambie kuhusu dawa, wahudumu, saa za kufungua na muda wa kusubiri.</p></div>
</Base>
