---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import NumberCard from '../../components/NumberCard.astro';
import { getNumbers, weekOf } from '../../lib/numbers.js';
const list = await getNumbers();
const [latest, ...past] = list;
---
<Base title="Number of the week">
  <PageHead eyebrow="Stories · Weekly Figure" title="Number of the week" lead="One checked figure each week, what it means, and where it comes from. Radio stations may read the script on air with credit to Nyamira Daily." crumbs={[{ href: '/watch/', label: 'Stories' }]} />
  <!-- Kiswahili: needs native-speaker review -->
  <div class="sw" lang="sw"><span class="eyebrow">Muhtasari kwa Kiswahili</span><p>Nambari moja iliyothibitishwa kila wiki — maana yake na chanzo chake. Vituo vya redio vinaweza kusoma hati ya redio hewani kwa kumtaja Nyamira Daily.</p></div>

  {latest && <div class="fg-article-sheet"><NumberCard e={latest} /></div>}
  {past.length > 0 && (
    <section class="stack" style="margin-top:40px">
      <h2>Earlier weeks</h2>
      <ul class="rows">{past.map((e) => <li><a class="row-link" href={`#${e.id}`}><span><span class="t">{e.data.figure} {e.data.sentence}</span><span class="d">{weekOf(e.data.week)}</span></span><span class="go" aria-hidden="true">→</span></a></li>)}</ul>
      {past.map((e) => <div class="fg-article-sheet"><NumberCard e={e} /></div>)}
    </section>
  )}
</Base>
