---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EvidenceLabel from '../../components/EvidenceLabel.astro';
import { roads, roadDetail, roadPath, roadsForWard, subtypeLabel } from '../../lib/roads.js';
import { amountLabel } from '../../lib/project-amounts.js';
import { gradeLabel } from '../../lib/road-conditions.js';
import wards from '../../data/wards.json';
import identities from '../../../data-src/road-identities.json';

const groups = [
  ...wards.map((w) => ({ title: `${w.name} Ward`, href: `/ward/${w.slug}/#svc-roads`, list: roadsForWard(w.slug) })),
  { title: 'Ward not stated in the documents', href: null, list: roads.filter((r) => r.wards.length === 0) },
].filter((g) => g.list.length);
const detailById = new Map(roads.map((r) => [r.id, roadDetail(r)]));
const siteVisits = [...detailById.values()].filter((d) => d.questions.some((q) => q.siteVisit)).length;
const excluded = Object.keys(identities.notRoads).length;
const reported = [...detailById.values()].filter((d) => d.condition).length;
---
<Base title="Roads" description="Every road and road structure named in Nyamira County's road-works records and Auditor-General reports, with the money and the questions to ask.">
  <PageHead title="Roads" lead="Roads and bridges named in the county's own records and in Auditor-General reports: the money, who paid, and what to ask." />
  <div class="stack-lg" style="margin-top:16px">
    <section class="card stack">
      <span class="figure"><span class="num">{roads.length}</span></span>
      <p class="say">roads and road structures are named in the county's road-works records (FY2023/24 to FY2025/26) and in Auditor-General findings. {siteVisits} of them have a question that needs a site visit.</p>
      <p class="source"><EvidenceLabel kind="official" /> County budgets, development plans and Controller of Budget reports; Auditor-General reports</p>
      <p class="muted small">{reported === 0 ? 'Condition is unknown for every road: no dated, editor-reviewed condition report is recorded yet.' : `${reported} of ${roads.length} roads have a dated, editor-reviewed condition report; the rest are unknown.`} Road class and the responsible road authority are not yet confirmed from the official classification.</p>
    </section>

    {groups.map((g) => (
      <section class="stack">
        <h2>{g.href ? <a href={g.href}>{g.title}</a> : g.title}</h2>
        <div class="table-box">
          <table class="cards">
            <thead><tr><th>Road</th><th>Latest record</th><th>Condition</th><th>Questions</th></tr></thead>
            <tbody>{g.list.map((road) => {
              const d = detailById.get(road.id);
              return (
                <tr>
                  <td><a href={roadPath(road.id)}>{road.name}</a>{road.subtype !== 'road' && <span class="small muted"> · {subtypeLabel[road.subtype]}</span>}</td>
                  <td data-label="Latest record">{d.latest ? `${amountLabel(d.latest.amount)} · ${d.latest.kind}, FY${d.latest.fy}${d.latest.status ? ` · ${d.latest.status}` : ''}` : 'Auditor-General finding only'}</td>
                  <td data-label="Condition">{d.condition ? `${gradeLabel[d.condition.grade]} (${d.condition.observedOn})` : 'Unknown'}</td>
                  <td data-label="Questions">{d.questions.length}</td>
                </tr>
              );
            })}</tbody>
          </table>
        </div>
      </section>
    ))}

    <details>
      <summary>What is not listed here</summary>
      <p>{excluded} road-works records name no single road or bridge: for example murram supply for two wards, culverts, fuel and machinery, or "roads across the ward". They stay with each ward's county projects. Records from before FY2023/24 are not yet in our project data, apart from Auditor-General findings.</p>
    </details>
  </div>
</Base>
