---
// Data sectors (decision #30): Money, Health, Education, Farming, People and places, Open data.
// Each opens with its headline figures; the rest sits in Notion-style toggles.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Toggle from '../../components/Toggle.astro';
import { topics } from '../../data/topics.js';
import MyWard from '../../components/MyWard.astro';
import MoneyPage from '../../components/MoneyPage.astro';
import ProjectsPage from '../../components/ProjectsPage.astro';
import PeoplePage from '../../components/PeoplePage.astro';
import ComparePage from '../../components/data/ComparePage.astro';
import TeaMilkPage from '../../components/data/TeaMilkPage.astro';
import HealthPage from '../../components/data/HealthPage.astro';
import SchoolsPage from '../../components/data/SchoolsPage.astro';
import SubLocationsPage from '../../components/data/SubLocationsPage.astro';
import AuditPage from '../../components/data/AuditPage.astro';
import ServicesBlock from '../../components/ServicesBlock.astro';
import SectorProjects from '../../components/SectorProjects.astro';
import CommunityReports from '../../components/CommunityReports.astro';
import OpenData from '../../components/OpenData.astro';
import wards from '../../data/wards.js';

export function getStaticPaths() {
  return topics.map((t) => ({ params: { topic: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const healthCount = wards.reduce((n, w) => n + (w.counts.Health ?? 0), 0);
---
<Base title={t.title}>
  <div class={`sec-${t.tone}`}>
    <PageHead eyebrow="Data" title={t.title} lead={t.question} tone={t.tone} crumbs={[{ href: '/data/', label: 'Data' }, { href: `/data/${t.slug}/`, label: t.title }]} />

    {t.slug === 'money' && (
      <>
        <div style="margin-top:16px"><MyWard topic="projects" /></div>
        <MoneyPage />
        <div class="stack" style="margin-top:32px">
          <Toggle id="projects" title="Ward projects: what each ward was promised" meta="FY2025/26 budget lines, progress, questions to ask"><ProjectsPage /></Toggle>
          <Toggle id="audit" title="What the Auditor-General found" meta="Audit opinion every year, 354 findings"><AuditPage /></Toggle>
          <Toggle id="compare" title="How Nyamira compares with its neighbours" meta="Spending per person, development, local revenue"><ComparePage /></Toggle>
          <Toggle id="tools" title="Try it yourself" meta="Budget simulator, what money could build">
            <ul class="rows">
              <li><a class="row-link" href="/tools/budget-simulator/"><span><span class="t">You run the county</span><span class="d">Share out the 2025/26 budget and see the trade-offs.</span></span><span class="go" aria-hidden="true">→</span></a></li>
              <li><a class="row-link" href="/tools/what-it-builds/"><span><span class="t">What could it build?</span><span class="d">Classrooms, boreholes, health blocks and roads, from the county's own costs.</span></span><span class="go" aria-hidden="true">→</span></a></li>
            </ul>
          </Toggle>
        </div>
      </>
    )}

    {t.slug === 'health' && (
      <>
        <HealthPage />
        <div class="stack" style="margin-top:32px">
          <Toggle id="facilities" title="Health facilities by ward" meta={`${healthCount} listed`}>
            <ul class="small">{wards.map((w) => <li><a href={`/ward/${w.slug}/`}>{w.name}</a>: {w.counts.Health ?? 0}</li>)}</ul>
            <p class="source"><span class="label official">Official claim</span> Mostly from the Kenya Master Health Facility List (2017 export). Each ward page lists the facilities.</p>
          </Toggle>
          <Toggle id="clinic-checks" title="Clinic checks by residents"><CommunityReports /></Toggle>
          <Toggle id="health-projects" title="Health projects in the wards"><SectorProjects match="health|medical|dispensary|opd" /></Toggle>
        </div>
      </>
    )}

    {t.slug === 'education' && (
      <>
        <SchoolsPage />
        <div class="stack" style="margin-top:32px">
          <Toggle id="school-projects" title="ECDE and school projects in the wards"><SectorProjects match="education|ecde|vocational|polytechnic" note="Nursery (ECDE) classrooms and village polytechnics are county jobs; primary and secondary schools are national." /></Toggle>
          <Toggle id="schools-listed" title="Schools listed in each ward">
            <ul class="small">{wards.map((w) => <li><a href={`/ward/${w.slug}/`}>{w.name}</a>: {w.counts.Education ?? 0}</li>)}</ul>
            <p class="small muted">Schools are badly under-listed so far; see each ward page.</p>
          </Toggle>
        </div>
      </>
    )}

    {t.slug === 'farming' && (
      <>
        <TeaMilkPage />
        <div class="stack" style="margin-top:32px">
          <Toggle id="farming-projects" title="Crop and livestock projects in the wards"><SectorProjects match="crop|livestock|agri|fisher|dairy|tea buying" /></Toggle>
        </div>
      </>
    )}

    {t.slug === 'people' && (
      <>
        <PeoplePage />
        <div class="stack" style="margin-top:32px">
          <Toggle id="sub-locations" title="Find your sub-location" meta="2019 census, all 113"><SubLocationsPage /></Toggle>
          <Toggle id="services" title="Public places and services in each ward"><ServicesBlock /></Toggle>
        </div>
      </>
    )}

    {t.slug === 'open-data' && <OpenData />}
  </div>
</Base>
