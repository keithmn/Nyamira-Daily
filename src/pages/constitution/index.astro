---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
const parts = [
  { href: '/constitution/devolution/', title: 'Devolution (Chapter Eleven)', text: 'Why counties exist and how county government works, article by article.' },
  { href: '/constitution/fourth-schedule/', title: 'What the county must do', text: 'The 14 functions the Constitution gives county governments.' },
  { href: '/constitution/your-rights/', title: 'Your rights', text: 'Rights that county services must respect: health, water, a clean environment, information and more.' },
  { href: '/constitution/county-laws/', title: 'County laws', text: 'The laws that put devolution into practice, and Nyamira\'s own Assembly Acts.' },
];
---
<Base title="Constitution">
  <PageHead eyebrow="Constitution" title="The Constitution, for Nyamira" lead="What the law says the county must do for you, and how you can hold it to that." tools={false} />
  <div class="grid" style="margin-top:16px">
    {parts.map((p) => (<a class="card" href={p.href}><h2 style="font-size:22px">{p.title}</h2><p class="muted">{p.text}</p></a>))}
  </div>
  <p class="small muted" style="margin-top:16px">Official text: Constitution of Kenya, 2010 (Kenya Law). Plain-language explanations are ours and are marked as such.</p>
</Base>
