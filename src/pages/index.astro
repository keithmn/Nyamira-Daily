---
// Nyamira Daily Front Page (design/field-guide): information presentation inspired by civictech.guide,
// using 100% Nyamira Daily colours, self-hosted fonts, real records, evidence labels and official sources.
import Base from '../layouts/Base.astro';
import HeroMap from '../components/HeroMap.astro';
import EvidenceLabel from '../components/EvidenceLabel.astro';
import Icon from '../components/Icon.astro';
import { getNumbers } from '../lib/numbers.js';
import { entries } from '../lib/content.js';
import { allVideos, videoPath } from '../lib/videos.js';
import { places, currentState } from '../lib/places.js';
import { contracts, byGroup, forWard } from '../lib/contracts.js';
import { liveItems } from '../lib/now.js';
import { date } from '../lib/fmt.js';
import money from '../lib/county-money.js';
import wards from '../data/wards.js';
import leaders from '../data/leaders.json';
import sectors from '../data/budget-sectors.json';
import steps from '../data/budget-steps.js';
import { hundred } from '../lib/hundred.js';
import { roads, roadsForWard } from '../lib/roads.js';
import { subCounties } from '../nav.js';

const nowItems = liveItems();
const facilities = places.filter((p) => p.kind === 'facility');
const checked = facilities.filter((p) => currentState(p).lastChecked).length;

// County money (strictly separate from national money)
const last = money.years[money.years.length - 1];
const bn = (m) => 'KSh ' + parseFloat((m / 1000).toFixed(2)) + 'B';
const spentPct = Math.round((last.spent * 100) / last.budget);
const gapPct = 100 - spentPct;
const split = hundred(sectors.departments);
const topShares = split.slice(0, 5);
const wageInHundred = Math.round(sectors.wageBill.sharePct);
const devInHundred = 38;

// Contracts & NG-CDF (county vs national strictly separated)
const countyContracts = byGroup('county').length + byGroup('assembly').length;
const ngcdfContracts = byGroup('ng-cdf').length;
const natRoadContracts = byGroup('roads').length;
const otherNatContracts = byGroup('national').length;
const totalNatContracts = ngcdfContracts + natRoadContracts + otherNatContracts;

// Facilities by category
const countCat = (c) => facilities.filter((f) => f.type === c).length;
const healthCount = countCat('Health');
const schoolCount = countCat('Education');
const marketCount = countCat('Market');
const waterCount = countCat('Water');
const officeCount = countCat('Public office');

// Stories & briefings
const numbers = await getNumbers();
const explainers = await entries('explainers');
const iso = (d) => (d instanceof Date ? d.toISOString().slice(0, 10) : String(d || ''));
const stories = [
  ...allVideos.map((v) => ({ kind: 'Video briefing', fig: null, title: v.title, note: v.summary, href: videoPath(v.id), when: iso(v.published_on) })),
  ...numbers.map((n) => ({ kind: 'Number of the week', fig: n.data.figure, title: `${n.data.figure} ${n.data.sentence}`, note: n.data.sources[0]?.name ?? '', href: `/number-of-the-week/#${n.id}`, when: iso(n.data.week) })),
  ...explainers.map((e) => ({ kind: 'Plain-language explainer', fig: null, title: e.data.title, note: e.data.summary, href: `/explainers/${e.id}/`, when: iso(e.data.updated) })),
].sort((a, b) => b.when.localeCompare(a.when));

// Curated 3-column Field Guide directory (inspired by civictech.guide)
const dirPlaces = [
  { href: '/map/', label: `Interactive facility map (${facilities.length})` },
  { href: '/ward/', label: 'All 20 wards & receipts', bold: true },
  { href: '/map/health/', label: `Health facilities (${healthCount})` },
  { href: '/map/education/', label: `Schools & education (${schoolCount})` },
  { href: '/map/#roads', label: `Roads tracker (${roads.length})` },
  { href: '/money/farming/', label: `Farming & markets (${marketCount})` },
  { href: '/administration/', label: 'Who holds each seat' },
  { href: '/administration/duties/', label: 'How Nyamira is governed' },
];
const dirMoney = [
  { href: '/money/', label: `Money overview (${last.fy})`, bold: true },
  { href: '/money/2025-26/', label: `County budget (${bn(last.budget)})` },
  { href: '/money/2025-26/departments/', label: 'All 24 county departments' },
  { href: '/money/track/', label: `What was spent (${bn(last.spent)})`, bold: true },
  { href: '/money/revenue/', label: 'Where money comes from & fees' },
  { href: '/money/history/', label: 'Twelve years since 2013/14' },
  { href: '/money/contracts/', label: `Contracts & NG-CDF (${contracts.length.toLocaleString('en-GB')})` },
  { href: '/money/economy/', label: 'The county economy' },
];
const dirCommunity = [
  { href: '/watch/', label: 'Stories & video explainers', bold: true },
  { href: '/number-of-the-week/', label: 'Number of the week' },
  { href: '/community/abagusii/', label: 'The Abagusii (history & culture)' },
  { href: '/community/archive/', label: 'Community culture archive' },
  { href: '/community/language/', label: 'Open Ekegusii language dataset', bold: true },
];
const dirOpen = [
  { href: '/about/data/', label: 'Open data, CSVs & JSON API' },
  { href: '/about/rules/', label: 'Guiding rules & 4 evidence labels' },
  { href: '/about/glossary/', label: 'Plain-language civic glossary' },
];

// Budget calendar milestones sorted soonest first from today
const shortMonths = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const today = new Date();
const t0 = new Date(today.getFullYear(), today.getMonth(), today.getDate());
const orderedSteps = steps.map((s) => {
  let dt = new Date(t0.getFullYear(), s.m - 1, s.d);
  if (dt < t0) dt = new Date(t0.getFullYear() + 1, s.m - 1, s.d);
  return { ...s, days: Math.round((dt - t0) / 86400000), year: dt.getFullYear() };
}).sort((a, b) => a.days - b.days);

// Saved ward records
const wardRows = wards.map((w) => ({
  w,
  mca: leaders.mcas[w.slug],
  health: w.counts.Health ?? 0,
  schools: w.counts.Education ?? 0,
  r: roadsForWard(w.slug).length,
  c: forWard(w.slug).length,
}));
---
<Base title="Today" description="Nyamira Daily: every public place mapped across 20 wards, county budgets and national contracts with sources, plain-language explainers and community heritage." tools={false}>
  <Fragment slot="hero">
    {nowItems.length > 0 && (
      <aside class="now-strip" aria-label="Happening now">
        <div class="wrap now-inner">
          <span class="now-tag"><span class="live" aria-hidden="true"></span>Happening now</span>
          <ul>
            {nowItems.map((it) => <li><a href={it.href}>{it.headline}</a> <span class="now-meta">{it.source} · {date(it.date)}</span></li>)}
          </ul>
        </div>
      </aside>
    )}
    <HeroMap />
  </Fragment>

  <!-- BAND 1: THE DIRECTORY — 3-column curated category pill stacks + floating search/ward box -->
  <section class="fg-band fg-band-white" aria-labelledby="dir-h">
    <div class="wrap">
      <header class="fg-sec-head">
        <span class="fg-kicker">The Directory</span>
        <h2 id="dir-h">Browse <span class="fg-hl">every public record</span> in<br />our carefully organised guide</h2>
      </header>

      <div class="fg-dir-grid">
        <div class="fg-dir-col is-places">
          <div class="fg-dir-top">
            <span class="fg-dir-pre">The</span>
            <h3><a href="/map/">Places</a></h3>
            <p>Explore clinics, schools, water points, roads, wards and elected seats across Nyamira.</p>
          </div>
          <ul class="fg-pill-stack">
            {dirPlaces.map((item) => (
              <li>
                <a class={item.bold ? 'is-key' : undefined} href={item.href}>
                  <span class="fg-ne" aria-hidden="true">↗</span>
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="fg-dir-col is-money">
          <div class="fg-dir-top">
            <span class="fg-dir-pre">The</span>
            <h3><a href="/money/">Books</a></h3>
            <p>Follow county budgets, spending, audit reports and national contracts from official sources.</p>
          </div>
          <ul class="fg-pill-stack">
            {dirMoney.map((item) => (
              <li>
                <a class={item.bold ? 'is-key' : undefined} href={item.href}>
                  <span class="fg-ne" aria-hidden="true">↗</span>
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="fg-dir-col is-comm">
          <div class="fg-dir-top">
            <h3><a href="/community/">Community &amp; Stories</a></h3>
            <span class="fg-dir-pre">&amp; Open Knowledge</span>
            <p>Plain-language explainers, recorded Abagusii heritage and the open Ekegusii language dataset.</p>
          </div>
          <ul class="fg-pill-stack">
            {dirCommunity.map((item) => (
              <li>
                <a class={item.bold ? 'is-key' : undefined} href={item.href}>
                  <span class="fg-ne" aria-hidden="true">↗</span>
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
          <h4 class="fg-dir-sub">Data, rules &amp; reference</h4>
          <ul class="fg-pill-stack">
            {dirOpen.map((item) => (
              <li>
                <a href={item.href}>
                  <span class="fg-ne" aria-hidden="true">↗</span>
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Floating knowledgebase search & 20-ward quick jumper -->
      <div class="fg-kb-wrap">
        <p class="fg-kb-caption">Or search our entire Nyamira knowledgebase &amp; 20 wards</p>
        <div class="fg-kb-box">
          <form class="fg-kb-form" action="/search/" method="get" role="search">
            <label class="vh" for="kb-q">Search every record on Nyamira Daily</label>
            <Icon name="search" size={20} />
            <input id="kb-q" type="search" name="q" placeholder="Search a ward, dispensary, school, road, department or law..." autocomplete="off" />
            <button class="fg-cta-btn" type="submit">Search guide</button>
          </form>

          <div class="fg-kb-constituencies" data-ward-only="">
            {subCounties.map((sc) => (
              <div class="fg-kb-sc">
                <span class="fg-kb-sc-name">{sc} Constituency</span>
                <div class="fg-kb-chips">
                  {wards.filter((w) => w.subCounty === sc).map((w) => (
                    <a href={`/ward/${w.slug}/`}>{w.name}</a>
                  ))}
                </div>
              </div>
            ))}
          </div>

          {wardRows.map(({ w, mca, health, schools, r, c }) => (
            <div class="fg-saved-ward" data-ward-only={w.slug} hidden>
              <div class="fg-sw-head">
                <div>
                  <span class="fg-kicker">Your saved ward · {w.subCounty}</span>
                  <h3>{w.name} Ward</h3>
                  <p class="small">MCA: <a href={`/administration/#ward-${w.slug}`}><strong>{mca ? mca.name : 'not confirmed'}</strong></a>{mca?.party ? ` (${mca.party})` : ''} · Source: IEBC</p>
                </div>
                <a class="fg-cta-btn" href={`/ward/${w.slug}/`}>Open {w.name} →</a>
              </div>
              <ul class="fg-sw-stats">
                <li><b>{health}</b><span>health facilities</span></li>
                <li><b>{schools}</b><span>schools</span></li>
                <li><b>{r}</b><span>roads listed</span></li>
                <li><b>{c}</b><span>contracts &amp; CDF</span></li>
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- BAND 2: INSIDE THE RECORDS — full-bleed soft-mint topographic showcase with 4 visual preview cards -->
  <section class="fg-band fg-band-mint" aria-labelledby="peek-h">
    <svg class="fg-topo" viewBox="0 0 1440 620" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.15">
        <ellipse cx="180" cy="480" rx="320" ry="210" />
        <ellipse cx="180" cy="480" rx="210" ry="135" />
        <ellipse cx="180" cy="480" rx="110" ry="68" />
        <path d="M-80 220 C 220 90, 520 260, 820 130 S 1220 20, 1520 170" />
        <path d="M-80 310 C 240 180, 540 350, 840 220 S 1240 110, 1520 260" />
        <ellipse cx="1290" cy="440" rx="280" ry="185" />
        <ellipse cx="1290" cy="440" rx="170" ry="110" />
      </g>
    </svg>

    <div class="wrap fg-rel">
      <header class="fg-sec-head">
        <span class="fg-kicker">Inside the Records</span>
        <h2 id="peek-h">Preview <span class="fg-hl">key county &amp; national figures</span><br />with every source attached</h2>
      </header>

      <div class="fg-peek-grid">
        <a class="fg-peek-card" href="/money/">
          <div class="fg-peek-art is-dark">
            <span class="fg-art-tag">County Budget · FY{last.fy}</span>
            <b class="fg-art-big">{bn(last.spent)}</b>
            <div class="fg-art-bar" aria-hidden="true">
              <i class="is-fill" style={`width:${spentPct}%`}></i>
              <i class="is-gap" style={`width:${gapPct}%`}></i>
            </div>
            <span class="fg-art-sub">{spentPct}% spent of {bn(last.budget)} · {gapPct}% gap</span>
          </div>
          <div class="fg-peek-body">
            <h3>County spending in {last.fy}</h3>
            <p>Controller of Budget year-end report ({bn(last.spent)}). The county's own Q4 report prints KSh 7.11B — both shown with sources.</p>
            <span class="fg-peek-meta"><EvidenceLabel kind="official" /></span>
          </div>
        </a>

        <a class="fg-peek-card" href="/money/2025-26/">
          <div class="fg-peek-art is-paper">
            <span class="fg-art-tag">Out of every KSh 100</span>
            <ul class="fg-mini-bars" aria-hidden="true">
              {topShares.map((s) => (
                <li>
                  <span>{s.name.split(/[\s,]+/)[0]}</span>
                  <i><b style={`width:${Math.round((s.share / topShares[0].share) * 100)}%`}></b></i>
                  <em>{s.share}</em>
                </li>
              ))}
            </ul>
            <span class="fg-art-sub">Staff pay: KSh {wageInHundred} · Development: KSh {devInHundred}</span>
          </div>
          <div class="fg-peek-body">
            <h3>Where every KSh 100 goes</h3>
            <p>{topShares[0].name} gets KSh {topShares[0].share}, followed by {topShares[1].name.toLowerCase()} (KSh {topShares[1].share}) and {topShares[2].name} (KSh {topShares[2].share}). Source: PBB 2025/26.</p>
            <span class="fg-peek-meta"><EvidenceLabel kind="official" /></span>
          </div>
        </a>

        <a class="fg-peek-card" href="/money/contracts/">
          <div class="fg-peek-art is-green">
            <span class="fg-art-tag">Kept strictly separate</span>
            <div class="fg-art-split">
              <div><b>{countyContracts}</b><span>County &amp; Assembly</span></div>
              <div><b>{totalNatContracts.toLocaleString('en-GB')}</b><span>NG-CDF &amp; National</span></div>
            </div>
            <span class="fg-art-sub">{ngcdfContracts.toLocaleString('en-GB')} NG-CDF · {natRoadContracts} national roads</span>
          </div>
          <div class="fg-peek-body">
            <h3>Contracts &amp; NG-CDF lists</h3>
            <p>{contracts.length.toLocaleString('en-GB')} records from PPIP, county reports, NG-CDF Board, KeRRA, KURA and KeNHA. National money is never added to county figures.</p>
            <span class="fg-peek-meta"><EvidenceLabel kind="official" /></span>
          </div>
        </a>

        <a class="fg-peek-card" href="/map/">
          <div class="fg-peek-art is-mint">
            <span class="fg-art-tag">20 Wards · Facility Atlas</span>
            <b class="fg-art-big">{checked} / {facilities.length}</b>
            <div class="fg-art-bar" aria-hidden="true">
              <i class="is-fill" style={`width:${Math.round((checked / facilities.length) * 100)}%`}></i>
              <i class="is-gap" style={`width:${100 - Math.round((checked / facilities.length) * 100)}%`}></i>
            </div>
            <span class="fg-art-sub">{healthCount} health · {schoolCount} schools · {waterCount + officeCount} water &amp; offices</span>
          </div>
          <div class="fg-peek-body">
            <h3>Facility map &amp; site checks</h3>
            <p>{facilities.length} public places and {roads.length} roads listed from OpenStreetMap and official registers, awaiting on-site checks of real condition.</p>
            <span class="fg-peek-meta"><EvidenceLabel kind="unverified" /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- BAND 3: STORIES, VIDEOS & STANDARDS — overlapping dashed-border + hard-shadow card on contour paper -->
  <section class="fg-band fg-band-topo fg-overlap-band" aria-labelledby="ins-h">
    <div class="wrap">
      <div class="fg-dashed-sheet">
        <header class="fg-sec-head">
          <span class="fg-kicker">Stories &amp; Briefings</span>
          <h2 id="ins-h">Read and watch <span class="fg-hl">latest explainers &amp; figures</span><br />turned into plain language</h2>
        </header>

        <div class="fg-insight-grid">
          {stories.slice(0, 2).map((s, idx) => (
            <a class="fg-insight-card" href={s.href}>
              <div class={`fg-ins-thumb ${idx === 0 ? 'is-grad' : 'is-ink'}`}>
                {s.fig ? (
                  <b class="fg-thumb-fig">{s.fig}</b>
                ) : (
                  <svg viewBox="0 0 64 64" width="44" height="44" aria-hidden="true">
                    <path d="M14 14 H50 V50 H38 V34 L20 52 L12 44 L30 26 H14 Z" fill="currentColor" />
                  </svg>
                )}
              </div>
              <span class="fg-ins-date">{date(s.when)} · {s.kind}</span>
              <h3>{s.title}</h3>
              <p>{s.note}</p>
            </a>
          ))}

          <a class="fg-insight-card" href="/watch/">
            <div class="fg-ins-thumb is-dashed">
              <span class="fg-play-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
              </span>
              <span class="fg-thumb-note">Video briefings</span>
            </div>
            <span class="fg-ins-date">YouTube &amp; Social · Series</span>
            <h3>Watch confirmed data explained</h3>
            <p>Not everyone reads a 300-page budget report. As datasets and site visits are verified, we explain them in short videos linked back to the sources here.</p>
          </a>

          <a class="fg-insight-card" href="/about/rules/#labels">
            <div class="fg-ins-thumb is-labels">
              <div class="fg-label-quad">
                <EvidenceLabel kind="verified" />
                <EvidenceLabel kind="audit" />
                <EvidenceLabel kind="official" />
                <EvidenceLabel kind="unverified" />
              </div>
            </div>
            <span class="fg-ins-date">Editorial Standard · 4 Labels</span>
            <h3>How we label every figure</h3>
            <p>Every figure names its report, page and date — separating site-checked facts, Auditor-General findings, official claims and unverified lists.</p>
          </a>
        </div>

        <div class="fg-center-actions">
          <a class="fg-outline-btn" href="/watch/">See all stories</a>
          <a class="fg-cta-btn" href="/about/data/">Browse open data</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BAND 4: FROM THE CALENDAR — split ticket-stub statutory budget cards on topographic paper -->
  <section class="fg-band fg-band-topo" aria-labelledby="cal-h">
    <div class="wrap">
      <header class="fg-sec-head">
        <span class="fg-kicker">From the Calendar</span>
        <h2 id="cal-h">Mark your calendar for <span class="fg-hl">public budget<br />deadlines</span> &amp; hearing milestones</h2>
      </header>

      <ul class="fg-ticket-grid">
        {orderedSteps.map((step, i) => (
          <li class={`fg-ticket${i === 0 ? ' is-next' : ''}`}>
            <div class="fg-ticket-stub">
              <span class="fg-stub-by">By</span>
              <b>{step.d} {shortMonths[step.m]}</b>
              {i === 0
                ? <span class="fg-stub-pill">{step.days === 0 ? 'Today' : `In ${step.days}d`}</span>
                : <span class="fg-stub-yr">{step.year}</span>}
            </div>
            <div class="fg-ticket-body">
              <a href="/money/2025-26/#calendar">{step.what}</a>
              <p>{step.note}</p>
            </div>
          </li>
        ))}
        <li class="fg-ticket">
          <div class="fg-ticket-stub">
            <span class="fg-stub-by">Every</span>
            <b>Quarter</b>
            <span class="fg-stub-yr">s.166(4)</span>
          </div>
          <div class="fg-ticket-body">
            <a href="/money/track/">Quarterly spending reports</a>
            <p>County Treasury and Controller of Budget publish what each of the 24 departments spent.</p>
          </div>
        </li>
      </ul>

      <p class="fg-cal-foot">Deadlines set by the Public Finance Management Act, 2012 (financial year 1 July – 30 June).</p>
      <div class="fg-center-actions">
        <a class="fg-outline-btn" href="/money/2025-26/#calendar">Full timetable</a>
        <a class="fg-cta-btn" href="/money/2025-26/">Explore 2025/26 budget</a>
      </div>
    </div>
  </section>

  <!-- BAND 5: GET INVOLVED — 3 bold colour-blocked square cards (Charcoal, White, Signal Green) -->
  <section class="fg-band fg-band-topo fg-involve-band" aria-labelledby="inv-h">
    <div class="wrap">
      <header class="fg-sec-head">
        <span class="fg-kicker">Get Involved</span>
        <h2 id="inv-h">Help grow <span class="fg-hl">Nyamira Daily</span> and keep<br />every ward’s record accurate</h2>
      </header>

      <div class="fg-trio-blocks">
        <a class="fg-block-card is-charcoal" href="/report/">
          <span class="fg-bc-icon"><Icon name="map" size={24} /></span>
          <h3>Report a place</h3>
          <p>Tell us whether a clinic, school, water point, market or road in your ward is working and when you saw it.</p>
        </a>

        <a class="fg-block-card is-white" href="/community/language/">
          <span class="fg-bc-icon"><Icon name="community" size={24} /></span>
          <h3>Ekegusii &amp; Heritage</h3>
          <p>Record spoken Ekegusii and Abagusii history with full informed consent — contributors keep the rights.</p>
        </a>

        <a class="fg-block-card is-signal" href="/about/careers/">
          <span class="fg-bc-icon"><Icon name="people" size={24} /></span>
          <h3>Join your ward</h3>
          <p>Register interest as a ward correspondent or volunteer, or send us a public document or correction.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Kiswahili: needs native-speaker review -->
  <div class="sw" lang="sw" style="margin:0 auto; max-width:var(--wrap); padding:0 var(--gutter)"><span class="eyebrow">Muhtasari kwa Kiswahili</span><p>Nyamira Daily ni mwongozo wa kiraia wa Kaunti ya Nyamira — kila sehemu ya umma imeorodheshwa, kila shilingi imetajwa chanzo chake, na kila takwimu ina lebo ya ushahidi. Tafuta wodi yako, fuatilia bajeti na mikataba, na usome maelezo kwa lugha nyepesi.</p></div>
</Base>
