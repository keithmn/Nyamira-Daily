---
import Base from '../layouts/Base.astro';
import HeroMap from '../components/HeroMap.astro';
import MyWard from '../components/MyWard.astro';
import NyWatchLogo from '../components/NyWatchLogo.astro';
import EvidenceLabel from '../components/EvidenceLabel.astro';
import Coins from '../components/viz/Coins.astro';
import SplitBar from '../components/viz/SplitBar.astro';
import wards from '../data/wards.json';
import money from '../data/money.json';
import leaders from '../data/leaders.json';

const facilities = wards.reduce((n, w) => n + w.facilities.length, 0);
const health = wards.reduce((n, w) => n + (w.counts.Health ?? 0), 0);
const last = money.years[money.years.length - 1];
const bn = (m) => 'KSh ' + parseFloat((m / 1000).toFixed(2)) + 'B';
const spentPct = Math.round((last.spent / last.budget) * 100);
const gov = leaders.county.find((l) => l.office === 'Governor');
const more = [
  { href: '/government/leaders/', t: 'Who represents you', d: `The Governor (${gov?.name}), Senator, MPs and all 20 ward MCAs, with sources.` },
  { href: '/government/whos-in-charge/', t: 'Who fixes what', d: "A road, a dispensary, a market: is it the county's job or the national government's?" },
  { href: '/data/projects/', t: 'What your ward was promised', d: "Every ward's project budget for 2025/26, and projects that need answers." },
  { href: '/constitution/fourth-schedule/', t: 'What the county must provide', d: 'The 14 jobs the Constitution gives every county government, in plain words.' },
  { href: '/opportunities/', t: 'Jobs, tenders and bursaries', d: 'What is open now, deadlines, and how to register for youth and women tenders (AGPO).' },
  { href: '/learn/fees/', t: 'What the county can charge', d: 'Business permits, market fees, parking and more, from the Finance Act 2025.' },
  { href: '/learn/taking-part/', t: 'Have your say', d: 'How to speak at a budget forum, petition the Assembly or request information.' },
];
---
<Base title="Today" tools={false}>
  <HeroMap slot="hero" />

  <div class="stack-lg" style="padding-top:40px">
    <section class="cols-2" aria-label="Nyamira at a glance">
      <div class="figure">
        <span class="eyebrow">Money · {last.fy}</span>
        <span class="num">{bn(last.spent)}</span>
        <p class="say">spent by the county, out of a <strong>{bn(last.budget)}</strong> budget. <strong class="hot">{bn(last.budget - last.spent)}</strong> was not spent.</p>
        <Coins part={spentPct} unit="KSh " title="Out of every KSh 100 in the budget" goodLabel="was spent" gapLabel="was not spent" />
        <h3 class="mini">Development money: roads, buildings, water</h3>
        <SplitBar title={`Development budget ${last.fy}`} parts={[{ value: last.devAbs, label: 'used', tone: 'good' }, { value: 100 - last.devAbs, label: 'not used', tone: 'gap' }]} />
        <p class="source"><EvidenceLabel kind="official" /> Source: Controller of Budget, FY{last.fy}</p>
        <a href="/data/money/"><strong>See 12 years of county money</strong></a>
      </div>
      <div class="stack">
        <div class="tiles three">
          <a class="tile" href="/ward/"><b>20</b><span>wards, each with an elected MCA</span><EvidenceLabel kind="verified" /></a>
          <a class="tile" href="/data/services/"><b>{facilities}</b><span>public places and services listed</span><EvidenceLabel kind="unverified" /></a>
          <a class="tile" href="/data/services/"><b>{health}</b><span>health facilities listed</span><EvidenceLabel kind="official" /></a>
        </div>
        <p class="small muted">Sources: IEBC ward list and geoBoundaries (wards); the Nyamira Daily list, mostly not yet checked on site (services); Kenya Master Health Facility List, 2017 export (health). <span class="updated">Figures last updated 22 Oct 2026.</span></p>
        <MyWard topic="home" />
      </div>
    </section>

    <section class="cols-2">
      <div class="stack">
        <h2>Find out more</h2>
        <ul class="rows">
          {more.map((m) => (
            <li><a class="row-link" href={m.href}><span><span class="t">{m.t}</span><span class="d">{m.d}</span></span><span class="go" aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
      <div class="stack">
        <section class="nyw nyw-band on-ink stack" aria-labelledby="show">
          <NyWatchLogo on="dark" />
          <span class="eyebrow">Nightly, 10 to 11 pm</span>
          <span class="nyw-badge" data-onair hidden>Live now</span>
          <h2 id="show">NY Watch: the nightly show</h2>
          <p class="muted">Live discussion of the county's facts, with guests. Also released as a podcast.</p>
        </section>
        <div class="sw" lang="sw">
          <span class="eyebrow">Muhtasari kwa Kiswahili</span>
          <p>Nyamira Daily inaeleza kwa lugha rahisi jinsi pesa za kaunti zinavyotumika, huduma zilizopo katika kila wadi, na nani anawajibika. Kila takwimu ina chanzo chake.</p>
        </div>
      </div>
    </section>
  </div>
</Base>
