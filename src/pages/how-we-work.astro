---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import EvidenceLabel from '../components/EvidenceLabel.astro';
import CorrectionLog from '../components/CorrectionLog.astro';
const correctionIntakeEnabled = import.meta.env.PUBLIC_CORRECTION_INTAKE_ENABLED === 'true';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const correctionRetentionDays = Number(import.meta.env.PUBLIC_CORRECTION_RETENTION_DAYS);
const hasCorrectionRetention = Number.isSafeInteger(correctionRetentionDays) && correctionRetentionDays >= 1 && correctionRetentionDays <= 3650;
---
<Base title="How we work">
  <PageHead title="How we work" lead="Our rules for facts, fairness and corrections." tools={false} />
  <div class="stack" style="margin-top:16px">
    <section id="evidence" class="card stack">
      <h2>Evidence labels</h2>
      <p><EvidenceLabel kind="verified" /> We checked it on site or against official records.</p>
      <p><EvidenceLabel kind="audit" /> It comes from an Auditor-General report.</p>
      <p><EvidenceLabel kind="official" /> The government stated it; we have not yet checked it.</p>
      <p><EvidenceLabel kind="unverified" /> It was reported to us or listed somewhere; not yet confirmed.</p>
      <p>A label describes the evidence category, not every part of the check. Where recorded, each detailed evidence note should say what claim was checked, the method, the date, and the responsible person or role. “Verified” never means that a project is operational unless that specific service operation was checked.</p>
      <p class="small muted">The current labels do not yet include those claim-level details for every figure. Missing reviewer, method or check-date information is not inferred.</p>
    </section>
    <section class="card stack">
      <h2>Our rules</h2>
      <ol style="padding-left:20px; margin:0" class="stack">
        <li>Every number has a source a reader can check.</li>
        <li>Allegations are never presented as proven. Clearances and acquittals are reported as prominently as the allegation.</li>
        <li>An unfinished project is labelled "completion not yet verified" until proven otherwise.</li>
        <li>Anyone criticised gets a chance to respond before publication.</li>
        <li>Successes are reported as well as failures.</li>
        <li>No accusations against private individuals, and no names of victims.</li>
      </ol>
    </section>
    <section id="corrections" class="card stack">
      <h2>Corrections</h2>
      <p>Accepted corrections are recorded here with what changed, why, when, and a source. A report is a lead for review, not a verified fact. It will not change the public record by itself.</p>
      {correctionIntakeEnabled && turnstileSiteKey && hasCorrectionRetention ? (
        <form id="correction-form" class="builder" action="/api/corrections" method="post">
          <p class="small muted">Do not include private or sensitive personal information. You do not need to give your name or contact details. Submissions and review notes are kept for up to {correctionRetentionDays} days; deletion may happen on the next service request after that period. Sending a report does not mean it has been checked or that you will receive a reply.</p>
          <label>
            Page or record
            <input class="field" name="page" type="text" maxlength="500" placeholder="/data/health/" required />
            <span class="hint">Use the page path or a public Nyamira Daily URL.</span>
          </label>
          <label>
            What may be wrong?
            <textarea name="details" minlength="10" maxlength="3000" required></textarea>
            <span class="hint">Explain what you saw and what you think needs checking.</span>
          </label>
          <label>
            Public source link (optional)
            <input class="field" name="source" type="url" maxlength="2048" placeholder="https://…" />
          </label>
          <label hidden aria-hidden="true">
            Leave this field empty
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
          <button class="btn" type="submit">Send for review</button>
          <p id="correction-form-status" class="muted" role="status" aria-live="polite"></p>
        </form>
      ) : (
        <p class="muted">Correction submissions are not enabled yet. Do not send information here expecting it to be received. The review database and monitoring arrangements must be configured before intake opens.</p>
      )}
      <CorrectionLog />
    </section>
  </div>
</Base>

{correctionIntakeEnabled && turnstileSiteKey && hasCorrectionRetention && (
  <>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
      const form = document.querySelector('#correction-form');
      const status = document.querySelector('#correction-form-status');
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Sending for review…';
        const button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        try {
          const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
          const result = await response.json();
          if (!response.ok) {
            status.textContent = result.error || 'The report could not be saved.';
            return;
          }
          form.reset();
          const turnstile = Reflect.get(window, 'turnstile');
          if (typeof turnstile?.reset === 'function') turnstile.reset();
          status.textContent = `Saved for review. Reference: ${result.reference}. It has not changed the public record.`;
        } catch {
          status.textContent = 'The report could not be confirmed as saved. Please try again later.';
        } finally {
          button.disabled = false;
        }
      });
    </script>
  </>
)}
