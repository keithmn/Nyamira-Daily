---
// Tell us (decision #127): one page for everything a reader may want to send.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ContactForm from '../../../components/ContactForm.astro';
const ways = [
  ['/report/', 'FIELD CHECK', 'A place you have seen', 'Is the dispensary open? Is the road passable? It goes straight to that place\'s record.'],
  ['/report/clinic/', 'HEALTH VISIT', 'A clinic visit', 'Four quick questions after a visit: medicines, staff, hours and waiting time.'],
  ['/community/share/', 'HERITAGE & EKEGUSII', 'A story, a song or an elder to record', 'For the culture archive. We get in touch before anything is recorded.'],
  ['#message', 'EDITORIAL DESK', 'A tip, a concern or a correction', 'Use the message section below. You can leave your name out.'],
];
---
<Base title="Tell us" description="Tell Gusii Daily about a place, send a tip, a concern, a story or a correction.">
  <PageHead eyebrow="About · Reach the Desk" title="Tell us" lead="What would you like to tell us? Pick one below and we will take you straight to the right place. We read every message and reply as soon as we can." crumbs={[{ href: '/about/', label: 'About' }]} />
  <!-- Kiswahili: needs native-speaker review -->
  <div class="sw" lang="sw"><span class="eyebrow">Muhtasari kwa Kiswahili</span><p>Tuambie kuhusu sehemu ya umma, tuma habari, marekebisho au pendekezo. Unaweza kutuma ujumbe bila kutaja jina lako.</p></div>

  <div class="stack-lg">
    <div class="fg-data-grid">
      {ways.map(([href, tag, t, d]) => (
        <a class="fg-way-card" href={href}>
          <div class="fg-way-top">
            <span class="fg-kicker">{tag}</span>
            <span class="fg-pill-arrow" aria-hidden="true">↗</span>
          </div>
          <h3>{t}</h3>
          <p class="muted">{d}</p>
        </a>
      ))}
    </div>
    <section class="fg-sheet stack" id="message">
      <div class="fg-sec-head" style="margin-bottom:8px">
        <span class="fg-kicker">DIRECT MESSAGE &amp; CORRECTIONS</span>
        <h2>Send a message to <em>Gusii Daily</em></h2>
      </div>
      <ContactForm />
      <p class="small muted" style="text-align:center">A message is a lead for us to check, not a published fact. If we have named you or your organisation, see your <a href="/about/rules/#right-of-reply">right of reply</a>. Accepted corrections are listed in our <a href="/about/rules/#corrections">corrections log</a>. What we keep: <a href="/about/rules/#privacy">privacy</a>.</p>
    </section>
  </div>
</Base>
