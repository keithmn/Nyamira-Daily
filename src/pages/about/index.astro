---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EvidenceLabel from '../../components/EvidenceLabel.astro';
import Icon from '../../components/Icon.astro';

const links = [
  { href: '/about/contact/', label: 'Tell us — report a place, send a tip or correction' },
  { href: '/about/data/', label: 'Open data, CSV downloads, API & source documents' },
  { href: '/about/careers/', label: 'Careers, ward correspondents & culture volunteers' },
  { href: '/about/partners/', label: 'Partner with us (no political funding or clients)' },
  { href: '/about/rules/', label: 'Rules, editorial standards, right of reply & legal' },
  { href: '/about/nyamira/', label: 'About Nyamira County — geography & census' },
];
---
<Base title="About" description="Who Gusii Daily is, how we work, and how to take part.">
  <PageHead
    eyebrow="About Gusii Daily"
    title="The Gusii language and cultural database — plus civic data for every ward"
    lead="Gusii Daily records the Ekegusii language and Abagusii cultural knowledge, and brings scattered county records into one clear place — with sources, evidence labels and informed consent."
  />

  <!-- Kiswahili: needs native-speaker review -->
  <div class="sw" lang="sw"><span class="eyebrow">Muhtasari kwa Kiswahili</span><p>Gusii Daily ni hifadhi ya lugha ya Ekegusii na maarifa ya kitamaduni ya Abagusii, pamoja na data ya kiraia — tunaonyesha ramani ya vituo vya umma, tunafuatilia pesa za kaunti, na kila takwimu inataja chanzo chake. Hatusaidii chama chochote cha kisiasa.</p></div>

  <div class="stack-lg">
    <div class="fg-trio-blocks">
      <a class="fg-block-card is-charcoal" href="/map/">
        <span class="fg-bc-icon"><Icon name="map" size={24} /></span>
        <h3>Map &amp; verify</h3>
        <p>Schools, clinics, water points, markets and roads mapped across all 20 wards and verified through field checks.</p>
      </a>
      <a class="fg-block-card is-white" href="/money/">
        <span class="fg-bc-icon"><Icon name="money" size={24} /></span>
        <h3>Follow the books</h3>
        <p>County budgets, spending, audit findings, procurement and NG-CDF consolidated with sources and kept separate.</p>
      </a>
      <a class="fg-block-card is-signal" href="/watch/">
        <span class="fg-bc-icon"><Icon name="explain" size={24} /></span>
        <h3>Explain plainly</h3>
        <p>Verified records unpacked through videos, explainers and open files — never party-affiliated.</p>
      </a>
    </div>

    <section class="fg-dashed-sheet stack" aria-labelledby="ind">
      <div class="fg-sec-head is-compact">
        <span class="fg-kicker">Independence &amp; Standards</span>
        <h2 id="ind">Every figure carries <span class="fg-hl">its source and one of four labels</span></h2>
      </div>
      <p style="margin-inline:auto;text-align:center">We are non-partisan and editorially independent — not part of the County Government of Nyamira or any political party. When we get something wrong, we publish the correction.</p>
      <div class="chips" style="justify-content:center">
        <EvidenceLabel kind="verified" />
        <EvidenceLabel kind="audit" />
        <EvidenceLabel kind="official" />
        <EvidenceLabel kind="unverified" />
      </div>
      <ul class="fg-pill-grid">
        {links.map((l) => (
          <li><a href={l.href}><span class="fg-ne" aria-hidden="true">↗</span><span>{l.label}</span></a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>
