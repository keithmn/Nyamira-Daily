---
// One page per ward on the Gusii map (decision #134). Wards with full civic coverage (Nyamira) use FullWard;
// wards so far in the IEBC register only (Kisii) use CountyWard, which shows only sourced ward data.
import FullWard from '../../components/ward/FullWard.astro';
import CountyWard from '../../components/ward/CountyWard.astro';
import wards from '../../data/wards.js';
import { registerOnlyWards } from '../../lib/gusii.js';

export function getStaticPaths() {
  return [
    ...wards.map((w) => ({ params: { slug: w.slug }, props: { w } })),
    ...registerOnlyWards.map((r) => ({ params: { slug: r.slug }, props: { r } })),
  ];
}
const { w, r } = Astro.props;
---
{w ? <FullWard w={w} /> : <CountyWard r={r} />}
