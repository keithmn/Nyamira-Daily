---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EvidenceLabel from '../../components/EvidenceLabel.astro';
import WardMap from '../../components/WardMap.astro';
import wards from '../../data/wards.js';
import leaders from '../../data/leaders.json';
import money from '../../data/money.json';
import census from '../../data/census.json';
import { budget2526, forWard, total, kindLabel, fyOrder, sources, watch, pct, statusShort, shortTitle, statusCounts } from '../../lib/projects.js';
import Pictos from '../../components/viz/Pictos.astro';
import { roadsForWard, roadPath, subtypeLabel } from '../../lib/roads.js';
import SplitBar from '../../components/viz/SplitBar.astro';
import HBars from '../../components/viz/HBars.astro';
import EmbedCode from '../../components/EmbedCode.astro';
import CommunityReports from '../../components/CommunityReports.astro';
import AuditFinding from '../../components/data/AuditFinding.astro';
import { forWard as auditFor } from '../../lib/audit.js';
const auditHere = auditFor(Astro.params.slug);
import E from '../../data/elections.json';
const reg22 = E.registeredByWard.find((r) => r.year === 2022 && r.ward === Astro.params.slug);
import { getAlerts } from '../../lib/alerts-data.js';
import { levelLabel } from '../../lib/alerts.js';
import { amountLabel } from '../../lib/project-amounts.js';
const wardAlerts = (await getAlerts()).filter((a) => a.status === 'active' && (a.wards.includes(Astro.params.slug) || a.wards.length === 0));
import { ksh, num } from '../../lib/fmt.js';

export function getStaticPaths() {
  return wards.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}
const { w } = Astro.props;
const mca = leaders.mcas[w.slug];
const mp = leaders.national.find((l) => l.office === `MP, ${w.subCounty}`);
const byCat = w.facilities.reduce((m, f) => { (m[f.category] ??= []).push(f); return m; }, {});
const order = ['Health', 'Education', 'Worship', 'Market', 'Water', 'Public office', 'Community centre', 'Agriculture'];
const last = money.years[money.years.length - 1];
const proj = forWard(w.slug);
const b2526 = budget2526(w.slug);
const roads = total(w.slug, '2023/24', 'contract');
const cw = census.wards.find((x) => x.ward === w.slug);
const flags = watch.filter((x) => x.ward === w.slug);
const byFy = fyOrder.map((fy) => ({ fy, rows: proj.filter((p) => p.fy === fy) })).filter((g) => g.rows.length);
const bn = (m) => 'KSh ' + parseFloat((m / 1000).toFixed(2)) + 'B';
const mcaLine = mca ? mca.name + (mca.party ? ' (' + mca.party + ')' : '') : 'not confirmed';
const catLine = order.filter((c) => byCat[c]).map((c) => c + ' ' + byCat[c].length).join(', ');
const shareText = [
  w.name + ' Ward, ' + w.subCounty + ' - Nyamira Daily',
  'MCA: ' + mcaLine,
  'Services listed: ' + w.facilities.length + ' (' + catLine + ')',
  (b2526 != null ? 'Ward projects budgeted 2025/26: ' + amountLabel(b2526) + '\n' : '') + 'County spent ' + bn(last.spent) + ' in ' + last.fy + '; ' + last.devAbs + '% of the development budget was used.',
  new URL('/ward/' + w.slug + '/', Astro.site).toString(),
].join('\n');
const wa = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
const sc = statusCounts(w.slug);
const roadsHere = roadsForWard(w.slug);
const statusCaveats = [
  sc.undated && `${sc.undated} project${sc.undated === 1 ? ' has' : 's have'} undated percentage observations`,
  sc.conflicts && `${sc.conflicts} project${sc.conflicts === 1 ? ' has' : 's have'} conflicting observations on the latest date`,
  sc.unreported && `${sc.unreported} project${sc.unreported === 1 ? ' has' : 's have'} no supported completion percentage`,
  sc.unidentified && `${sc.unidentified} status record${sc.unidentified === 1 ? ' lacks' : 's lack'} a project ID`,
].filter(Boolean);
const budgets = wards.map((x) => {
  const amount = budget2526(x.slug);
  return { label: x.name, ward: x.slug, value: amount, href: `/ward/${x.slug}/#projects`, display: amountLabel(amount) };
});
---
<Base title={`${w.name} Ward`} alertWard={w.slug}>
  <PageHead eyebrow={`${w.subCounty} sub-county`} title={`${w.name} Ward`} crumbs={[{ href: '/ward/', label: 'Wards' }, { href: `/ward/${w.slug}/`, label: w.name }]} />

  <div class="stack-lg" style="margin-top:8px">
    <div class="ward-top">
      <div class="stack">
    <section class="receipt" aria-label={`${w.name} ward summary`}>
      <span class="eyebrow">Ward receipt · {w.subCounty}</span>
      <h2>{w.name} Ward</h2>
      {wardAlerts.length > 0 && <div class="row"><span>Active alerts</span><span>{wardAlerts.map((a, i) => <>{i > 0 && ', '}<a href={`/alerts/${a.id.toLowerCase()}/`}>{levelLabel[a.level]}: {a.title}</a></>)}</span></div>}
      <div class="row"><span>MCA</span><span>{mca ? mcaLine : 'Not confirmed'}</span></div>
      {mp && <div class="row"><span>MP ({w.subCounty})</span><span>{mp.name}</span></div>}
      <div class="row"><span>Services listed</span><span>{w.facilities.length}</span></div>
      {order.filter((c) => byCat[c]).map((c) => <div class="row sub"><span>{c}</span><span>{byCat[c].length}</span></div>)}
      {b2526 != null && <div class="row"><span>Ward projects budgeted, 2025/26</span><span>{amountLabel(b2526)}</span></div>}
      {roads && <div class="row"><span>Road maintenance contracts, 2023/24</span><span>{amountLabel(roads.amount)}</span></div>}
      {reg22 && <div class="row"><span>Registered voters (IEBC 2022) · <a href={`/government/elections/#ward-${w.slug}`}>results</a></span><span>{num(reg22.registered)}</span></div>}
      {cw?.votersRegisteredEarlier && <div class="row"><span>Registered voters (IEBC 2018 register)</span><span>{num(cw.votersRegisteredEarlier)}</span></div>}
      <div class="row"><span>Whole county spent, {last.fy}</span><span>{bn(last.spent)}</span></div>
      <div class="row"><span>Development budget used</span><span>{last.devAbs}%</span></div>
      <p class="small muted">Sources: MCA from IEBC 2022 results and later by-elections. Ward budget from the county's Programme Based Budget 2025/26 (Table 18); road contracts from the Annual Development Plan 2025/26. Services from the Nyamira Daily list, mostly not yet checked on site. County spending from the Controller of Budget.</p>
      <div class="page-tools">
        <a class="btn" href={wa} rel="noopener">Share this receipt on WhatsApp</a>
        <button class="btn quiet" type="button" data-set-ward={w.slug}>Make {w.name} my ward</button>
        <a class="btn quiet" href={`/ward/${w.slug}/sheet/`}>Print a ward sheet</a>
        <span class="small" data-ward-only={w.slug} hidden><strong>This is your ward.</strong></span>
      </div>
    </section>

    <EmbedCode path={`/embed/ward/${w.slug}/`} title={`${w.name} Ward receipt`} height={520} />
    {mca?.note && <p class="small"><strong>Note on the MCA seat:</strong> {mca.note} {mca.src && <a href={mca.src} rel="noopener">Source</a>}</p>}

    <div class="sw" lang="sw">
      <span class="eyebrow">Muhtasari kwa Kiswahili</span>
      <p>Wadi ya {w.name} iko katika kaunti ndogo ya {w.subCounty}. Mwakilishi wa wadi (MCA) ni {mca?.name ?? 'bado hajathibitishwa'}. Tumeorodhesha huduma {w.facilities.length} katika wadi hii; nyingi bado hazijakaguliwa ana kwa ana.</p>
    </div>

      </div>
    <section class="stack ward-map">
      <h2>Ward map</h2>
      <WardMap mode="ward" slug={w.slug} />
    </section>
    </div>

    <section class="stack">
      <h2>Services in {w.name}</h2>
      <p class="muted small">Listed from public sources. "Unverified" means our correspondents have not yet visited. <span class="updated">Last updated 22 Oct 2026.</span></p>
      <Pictos counts={order.filter((c) => byCat[c]).map((c) => ({ cat: c, n: byCat[c].length, href: `#svc-${c.toLowerCase().split(' ').join('-')}` }))} />
      {order.filter((c) => byCat[c]).map((c) => (
        <details id={`svc-${c.toLowerCase().split(' ').join('-')}`}>
          <summary>{c} ({byCat[c].length})</summary>
          <div class="table-box">
            <table class="cards">
              <thead><tr><th>Name</th><th>Type</th><th>Evidence</th><th>Source</th></tr></thead>
              <tbody>
                {byCat[c].map((f) => (
                  <tr>
                    <td><a href={`/facility/${f.id.toLowerCase()}/`}>{f.name}</a></td>
                    <td data-label="Type">{f.subtype}{f.level ? ` · ${f.level}` : ''}{f.owner ? ` · ${f.owner}` : ''}</td>
                    <td data-label="Evidence"><EvidenceLabel kind={f.evidence} /></td>
                    <td class="small muted" data-label="Source">{f.source}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))}
      {roadsHere.length > 0 && (
        <details id="svc-roads">
          <summary>Roads ({roadsHere.length})</summary>
          <div class="table-box">
            <table class="cards">
              <thead><tr><th>Road</th><th>Type</th><th>Evidence</th></tr></thead>
              <tbody>
                {roadsHere.map((road) => (
                  <tr>
                    <td><a href={roadPath(road.id)}>{road.name}</a></td>
                    <td data-label="Type">{subtypeLabel[road.subtype]}{road.lengthKm != null ? ` · ${road.lengthKm} km` : ''}</td>
                    <td data-label="Evidence"><EvidenceLabel kind={road.projectIds.length ? 'official' : 'audit'} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="small"><a href="/road/">All roads in Nyamira</a></p>
        </details>
      )}
    </section>

    <CommunityReports ward={w.slug} wardName={w.name} />

    {auditHere.length > 0 && (
      <section class="stack" id="audit">
        <h2>What the Auditor-General said about places in {w.name}</h2>
        <p class="muted small">From the Auditor-General's reports on the county. These are the auditor's findings, not court rulings. <a href="/data/money/#audit">All audit findings</a></p>
        <ul class="alist">{auditHere.map((f) => <li><AuditFinding f={f} /></li>)}</ul>
      </section>
    )}

    <section class="stack" id="projects">
      <h2>County projects in {w.name}</h2>
      <p class="muted small">What the county's plans and budgets list for this ward. "Budgeted" is planned money; "Contract sum" is what was signed; "Spent" is what was reported paid. A budget line is not proof that work was done. Read from the county's own documents; we have not visited these sites yet.</p>
      {flags.map((x) => (
        <div class="ask on-ink">
          <span class="eyebrow">Question to ask</span>
          <p><strong>{x.title}:</strong> {x.text}</p>
          <p class="note">A question, not an accusation. Sources: {x.src.map((id, i) => <>{i > 0 && '; '}<a href={sources[id].url} rel="noopener">{shortTitle(sources[id].title)}</a></>)}</p>
        </div>
      ))}
      {(sc.total > 0 || statusCaveats.length > 0) && (
        <div class="figure">
          <h3 class="mini">Latest dated physical progress reported for {sc.total} project IDs in {w.name}</h3>
          {sc.observedFrom && <p class="small muted">{sc.observedFrom === sc.observedThrough ? <>Observation date: <time datetime={sc.observedFrom}>{sc.observedFrom}</time></> : <>Observation dates: <time datetime={sc.observedFrom}>{sc.observedFrom}</time> to <time datetime={sc.observedThrough}>{sc.observedThrough}</time></>}</p>}
          {sc.total > 0 ? (
            <SplitBar title={`Reported progress, ${w.name}`} parts={[{ value: sc.done, label: 'reported 100%', tone: 'good', show: String(sc.done) }, { value: sc.going, label: 'reported 1–99%', tone: 'mid', show: String(sc.going) }, { value: sc.none, label: 'reported 0%', tone: 'gap', show: String(sc.none) }]} />
          ) : (
            <p class="muted">No dated, comparable progress percentages are available in the records checked.</p>
          )}
          <p class="source"><span class="label official">Official claim</span> Counts cover project IDs with status records, not the full project inventory. One entry per reviewed ID, using its latest dated physical-progress percentage. Financial expenditure is not physical progress. {statusCaveats.length > 0 && `${statusCaveats.join('; ')}. `}{sc.sources.length > 0 && <span>Sources: {sc.sources.map((source, i) => <span>{i > 0 && '; '}<a href={sources[source.sourceId].url} rel="noopener">{shortTitle(sources[source.sourceId].title)}</a> (published {sources[source.sourceId].date}){source.pages.length > 0 && `, ${source.pages.join('; ')}`}</span>)}. </span>}These are historical reports, not a current site assessment. A reported completion percentage does not establish that a service is operating. We have not visited these sites.</p>
        </div>
      )}
      {b2526 != null && (
        <details>
          <summary>How {w.name}'s 2025/26 ward budget compares with the other wards</summary>
          <HBars title="Ward project budgets, FY2025/26" rows={budgets} focus={w.slug} />
          <p class="small muted">Source: Programme Based Budget 2025/26, Table 18 (ward-coded lines). KSh 0 is shown only where the source explicitly reports zero; missing amounts are not drawn as zero.</p>
        </details>
      )}
      {byFy.length === 0 && <p class="muted">No ward-tagged projects found yet in the documents we have read.</p>}
      {byFy.map((g, i) => (
        <details open={i === 0}>
          <summary>{g.fy === 'as at 30 Jun 2025' ? 'Status at 30 June 2025' : `FY${g.fy}`} ({g.rows.length})</summary>
          <ul class="prows">{g.rows.map((p) => {
            const pc = pct(p.status);
            const st = statusShort(p.status);
            const rest = p.status && p.status.includes('|') ? p.status.split('|').slice(1).join('|').trim() : '';
            return (
              <li>
                <span class="pn"><a href={`/projects/${p.projectId.toLowerCase()}/`}>{p.name}</a>{p.location && p.location !== `${w.name} Ward` ? ` (${p.location})` : ''}</span>
                <span class="pa">{amountLabel(p.amount)}</span>
                <span class="pm">
                  <span>{kindLabel[p.kind] ?? p.kind}</span>
                  {st && <span class="st">{pc != null && <span class="meter sm" aria-hidden="true" style="display:inline-block;width:72px;vertical-align:middle;margin-right:6px"><i style={`width:${pc}%`}></i></span>}{st}</span>}
                  <span>{p.department}</span>
                  <span><a href={sources[p.sourceId].url} rel="noopener">{shortTitle(sources[p.sourceId].title)}</a> {p.page}</span>
                </span>
                {rest && <span class="pm">{rest}</span>}
              </li>
            );
          })}</ul>
        </details>
      ))}
      <a class="small" href="/data/money/#projects">Compare all wards</a>
    </section>

    {w.places.length > 0 && (
      <section class="stack">
        <h2>Places in {w.name}</h2>
        <p>{w.places.map((p) => p.name).join(' · ')}</p>
      </section>
    )}
  </div>
</Base>
