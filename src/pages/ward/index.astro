---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import wards from '../../data/wards.json';
import WardMap from '../../components/WardMap.astro';
import { subCounties, anchorFor } from '../../nav.js';
---
<Base title="Wards">
  <PageHead eyebrow="Wards" title="Choose your ward" lead="Tap your ward on the map, or pick it from the list. Each ward has one page with its services, projects, money and MCA." tools={false} />
  <div class="stack-lg" style="margin-top:16px">
    <WardMap mode="county" />
    {subCounties.map((s) => (
      <section class="stack" id={anchorFor(s)}>
        <h2>{s}</h2>
        <div class="grid">
          {wards.filter((w) => w.subCounty === s).map((w) => (
            <a class="card" href={`/ward/${w.slug}/`} data-ward-row={w.slug}>
              <h3>{w.name}</h3>
              <span class="small muted">{w.facilities.length} services listed · {w.places.length} places</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
