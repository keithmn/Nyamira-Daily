---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Toggle from '../../components/Toggle.astro';
import Icon from '../../components/Icon.astro';
import wards from '../../data/wards.js';
import leaders from '../../data/leaders.json';
import WardMap from '../../components/WardMap.astro';
import { subCounties, anchorFor } from '../../nav.js';
---
<Base title="All 20 wards of Nyamira County">
  <div class="sec-tea">
    <PageHead eyebrow="All 20 Wards · 4 Constituencies" title="Choose your ward" lead="Nyamira has 20 wards in four constituencies. Tap yours on the map, filter by name, or open a constituency below." tone="tea" tools={false} />
  </div>
  <div class="stack-lg" style="margin-top:16px">
    <div class="cols-2 fg-wards-layout">
      <WardMap mode="county" />
      <div class="stack sec-tea" data-ward-directory>
        <div class="fg-ward-filter">
          <label class="vh" for="ward-filter-q">Filter the 20 wards</label>
          <Icon name="search" size={16} />
          <input id="ward-filter-q" type="search" placeholder="Filter 20 wards by name or constituency..." autocomplete="off" />
        </div>
        {subCounties.map((s, idx) => {
          const mp = leaders.national.find((l) => l.office === `MP, ${s}`);
          const ws = wards.filter((w) => w.subCounty === s);
          return (
            <Toggle id={anchorFor(s)} title={`${s} Constituency`} meta={`${ws.length} wards${mp ? ` · MP ${mp.name}` : ''}`} open={idx === 0}>
              <ul class="fg-pill-stack" style="margin-top:8px">
                {ws.map((w) => (
                  <li data-ward-row={w.slug} data-ward-name={`${w.name} ${s}`.toLowerCase()}>
                    <a class="fg-dir-pill fg-ward-dir-pill" href={`/ward/${w.slug}/`}>
                      <span class="fg-pill-arrow" aria-hidden="true">↗</span>
                      <span class="fg-ward-dir-body">
                        <strong>{w.name}</strong>
                        <small>{w.facilities.length} services listed · {w.places.length} places</small>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </Toggle>
          );
        })}
      </div>
    </div>

    <!-- Kiswahili: needs native-speaker review -->
    <div class="sw" lang="sw"><span class="eyebrow">Muhtasari kwa Kiswahili</span><p>Orodha ya wodi 20 za Kaunti ya Nyamira, zilizopangwa kwa majimbo. Chagua wodi yako ili kuona hospitali, shule, miradi, mikataba na bajeti yake.</p></div>
  </div>
  <script is:inline>
  (function () {
    var q = document.getElementById('ward-filter-q');
    var root = document.querySelector('[data-ward-directory]');
    if (!q || !root) return;
    var toggles = Array.prototype.slice.call(root.querySelectorAll('details'));
    q.addEventListener('input', function () {
      var term = q.value.trim().toLowerCase();
      toggles.forEach(function (det, i) {
        var rows = det.querySelectorAll('[data-ward-name]');
        var visible = 0;
        rows.forEach(function (li) {
          var ok = !term || (li.getAttribute('data-ward-name') || '').indexOf(term) > -1;
          li.hidden = !ok;
          if (ok) visible++;
        });
        det.hidden = Boolean(term) && visible === 0;
        if (term && visible > 0) det.open = true;
        else if (!term) det.open = i === 0;
      });
    });
  })();
  </script>
</Base>
