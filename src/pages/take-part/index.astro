---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { planned } from '../../config.js';
const items = [
  { href: '/ask/', t: 'Ask Nyamira', d: 'Use your right to information: write to the county for official answers, and see what others have asked.' },
  { href: '/report/', t: 'Is it working?', d: 'Report whether a water point, dispensary, streetlight, road or market is working. Clinic checks too.' },
  { href: '/adopt/', t: 'Adopt a project', d: 'Follow one county project in your ward and send a photo each month.' },
  { href: '/take-part/submission/', t: 'Submission helper', d: 'Write a short, clear submission for a budget forum, a county plan or a petition to the Assembly.' },
  { href: '/tools/budget-simulator/', t: 'You run the county', d: 'Share out the 2025/26 budget yourself and see the trade-offs.' },
  { href: '/tools/what-it-builds/', t: 'What could it build?', d: 'What an amount of county money equals in classrooms, boreholes, health blocks and roads.' },
  { href: '/learn/taking-part/', t: 'How to take part', d: 'Budget forums, petitions and information requests, step by step.' },
  { href: '/have-your-say/', t: 'Have your say', d: 'Tell us what you think about the county’s plans.' },
  { href: '/diaspora/', t: 'For the diaspora', d: 'Supporting projects at home transparently.' },
  { href: '/fellowship/', t: 'Fellowship', d: 'For young data journalists in Nyamira.' },
];
---
<Base title="Take part">
  <PageHead eyebrow="Take part" title="Take part" lead="The Constitution gives you the right to information and the right to be heard on how the county is run. These tools help you use them." />
  <ul class="rows" style="margin-top:16px">
    {items.map((m) => (
      <li><a class="row-link" href={m.href}><span><span class="t">{m.t}{planned.has(m.href) && <span class="tag-planned" style="margin-left:8px">Planned</span>}</span><span class="d">{m.d}</span></span><span class="go" aria-hidden="true">→</span></a></li>
    ))}
  </ul>
  <div class="sw" lang="sw" style="margin-top:24px"><span class="eyebrow">Muhtasari kwa Kiswahili</span><p>Katiba inakupa haki ya kupata habari na haki ya kusikilizwa kuhusu jinsi kaunti inavyoendeshwa. Zana hizi zinakusaidia kuzitumia.</p></div>
</Base>
