---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Placeholder from '../../components/Placeholder.astro';
import NyWatchLogo from '../../components/NyWatchLogo.astro';
import { show } from '../../config.js';
import { showStatusText } from '../../lib/show-status.js';
---
<Base title="Show episodes">
  <PageHead eyebrow="Learn" title="Show episodes" lead="Recorded episodes of NY Watch, when verified recordings and links are available." crumbs={[{ href: '/learn/', label: 'Learn' }, { href: '/learn/episodes/', label: 'Show episodes' }]} />
  <div class="nyw" style="margin-top:16px"><NyWatchLogo /></div>
  <p class="muted">{showStatusText(show)}{!(show.status === 'recorded' && show.recordingUrl) && ' No verified recording link is available yet.'}</p>
  {show.status === 'recorded' && show.recordingUrl && <p><a href={show.recordingUrl} rel="noopener">Listen to the recording</a></p>}
  <div style="margin-top:16px"><Placeholder what="This lesson" /></div>
</Base>
