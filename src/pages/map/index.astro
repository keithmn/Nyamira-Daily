---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import AtlasMap from '../../components/AtlasMap.astro';
import EvidenceLabel from '../../components/EvidenceLabel.astro';
import Roads from '../../components/folded/Roads.astro';
import { places, currentState } from '../../lib/places.js';
import { roads } from '../../lib/roads.js';
import wards from '../../data/wards.js';

const facilities = places.filter((p) => p.kind === 'facility');
const checked = facilities.filter((p) => currentState(p).lastChecked).length;
const sectorPills = [
  { href: '/ward/', label: `All ${wards.length} wards` },
  { href: '/map/health/', label: `Health facilities (${facilities.filter((f) => f.type === 'Health').length})` },
  { href: '/map/education/', label: `Schools & education (${facilities.filter((f) => f.type === 'Education').length})` },
  { href: '/money/farming/', label: `Farming & markets (${facilities.filter((f) => f.type === 'Market').length})` },
  { href: '/about/nyamira/', label: 'About Nyamira County' },
  { href: '/administration/', label: 'Who holds each seat' },
];
---
<Base title="Places in Nyamira County" description="Find any ward, school, clinic, market or road in Nyamira. Tap the map to see what is there and what condition it is in.">
  <PageHead
    eyebrow="Geospatial Field Guide"
    title="Explore places, wards & roads across Nyamira"
    lead="Tap any ward or switch to facilities and ward money to inspect schools, clinics, water points, markets and roads — with source and verification status on every listing."
  />

  <div class="stack-lg">
    <ul class="fg-kpi-strip" aria-label="Places summary">
      <li class="fg-ticket-kpi">
        <div class="fg-tk-stub"><b>{wards.length}</b></div>
        <div class="fg-tk-body"><strong>Wards mapped</strong><span>Across 4 constituencies</span></div>
      </li>
      <li class="fg-ticket-kpi">
        <div class="fg-tk-stub"><b>{facilities.length}</b></div>
        <div class="fg-tk-body"><strong>Listed facilities</strong><span>Schools, clinics, water &amp; markets</span></div>
      </li>
      <li class="fg-ticket-kpi">
        <div class="fg-tk-stub"><b>{roads.length}</b></div>
        <div class="fg-tk-body"><strong>County roads</strong><span>Printed status &amp; questions</span></div>
      </li>
      <li class="fg-ticket-kpi">
        <div class="fg-tk-stub"><b>{checked}/{facilities.length}</b></div>
        <div class="fg-tk-body"><strong>Checked on site</strong><span><EvidenceLabel kind="unverified" /></span></div>
      </li>
    </ul>

    <div class="fg-solid-sheet fg-atlas-frame">
      <AtlasMap />
    </div>

    <section class="fg-dashed-sheet stack" aria-labelledby="sec-browse">
      <div class="fg-sec-head is-compact">
        <span class="fg-kicker">Browse by Category</span>
        <h2 id="sec-browse">Jump into a <span class="fg-hl">sector or ward directory</span></h2>
      </div>
      <ul class="fg-pill-grid">
        {sectorPills.map((p) => (
          <li><a href={p.href}><span class="fg-ne" aria-hidden="true">↗</span><span>{p.label}</span></a></li>
        ))}
      </ul>
      <div class="fg-center-actions">
        <a class="fg-cta-btn" href="/report/">Report a place you saw</a>
      </div>
    </section>

    <section class="fg-solid-sheet stack"><Roads /></section>

    <!-- Kiswahili: needs native-speaker review -->
    <div class="sw" lang="sw"><span class="eyebrow">Muhtasari kwa Kiswahili</span><p>Ramani ya vituo vya umma vya Kaunti ya Nyamira — hospitali, shule, masoko, maji na barabara — katika wodi 20. Kila kituo kinaonyesha hali yake na chanzo cha habari.</p></div>
  </div>
</Base>
