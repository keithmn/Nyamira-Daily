---
// Map legend for alert shapes
import { shapePath } from '../lib/alerts.js';
const items = [['emergency', 'Emergency'], ['disruption', 'Disruption'], ['notice', 'Notice']];
---
{items.map(([l, t]) => (
  <span class="key"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path class={`am-shape lv-${l}`} d={shapePath(l, 10, 10.5, 7)} /></svg>{t}</span>
))}
<span class="key"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path class="am-shape approx-key" d={shapePath('notice', 10, 10, 7)} /></svg>Dashed: approximate place</span>
