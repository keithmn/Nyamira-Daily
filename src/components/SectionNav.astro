---
// Horizontal field-guide category tab ribbon across all section pages.
import { sectionFor, stateFor } from '../nav.js';
import { planned } from '../config.js';

interface Props { path: string; variant?: 'bar' | 'rail' | 'switch' }
const { path } = Astro.props;
const sec = path === '/' ? null : sectionFor(path);
const pages = sec ? sec.pages.filter((p) => !planned.has(p.href)) : [];
const show = Boolean(sec && sec.rail !== false && pages.length > 0);
const onHome = Boolean(sec?.href && path === sec.href);
---
{show && (
  <nav class="fg-subnav" aria-label={`${sec.label} pages`}>
    <div class="wrap fg-subnav-inner">
      {sec.href && (
        <a class="fg-tab" href={sec.href} aria-current={onHome ? 'page' : undefined}>
          {sec.label}
        </a>
      )}
      {pages.map((p) => (
        <a class="fg-tab" href={p.href} aria-current={stateFor(p, path)}>{p.label}</a>
      ))}
    </div>
  </nav>
)}
