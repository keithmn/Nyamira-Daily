---
// Service counts as pictures: one icon per place, up to 10 shown, then "+N".
interface Props { counts: { cat: string; n: number; href?: string }[] }
const { counts } = Astro.props;
const icon = {
  Health: 'M9 3h6v6h6v6h-6v6H9v-6H3V9h6z',
  Education: 'M12 3 1 9l11 6 9-4.9V17h2V9zM5 13.2v4L12 21l7-3.8v-4L12 17z',
  Worship: 'M11 2h2v3h3v2h-3v3l6 4v8h-6v-5h-2v5H5v-8l6-4V7H8V5h3z',
  Market: 'M3 4h18l-1.5 6.5a3 3 0 0 1-5.6.7 3 3 0 0 1-3.8 0 3 3 0 0 1-5.6-.7zM4 13.5h2V19h12v-5.5h2V21H4z',
  Water: 'M12 2s7 7.6 7 12.5A7 7 0 0 1 5 14.5C5 9.6 12 2 12 2z',
  'Public office': 'M12 2 2 7v2h20V7zM4 11h3v7H4zm6.5 0h3v7h-3zM17 11h3v7h-3zM2 20h20v2H2z',
  'Community centre': 'M12 3 2 11h3v10h5v-6h4v6h5V11h3z',
  Agriculture: 'M17 3c-6 0-11 4-11 10 0 2 .6 3.6 1.5 5L4 21.5 5.5 23l3.4-3.4A8 8 0 0 0 13 21c6 0 8-6 8-12V3z',
};
const fallback = 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z';
---
<ul class="pictos">
  {counts.map((c) => {
    const Tag = c.href ? 'a' : 'div';
    const shown = Math.min(c.n, 10);
    return (
      <li>
        <Tag class="pc" href={c.href}>
          <span class="pc-icons" aria-hidden="true">
            {Array.from({ length: shown }, () => <svg viewBox="0 0 24 24" width="22" height="22"><path d={icon[c.cat] ?? fallback} /></svg>)}
            {c.n > shown && <span class="pc-more">+{c.n - shown}</span>}
          </span>
          <span class="pc-text"><b>{c.n}</b> {c.cat}</span>
        </Tag>
      </li>
    );
  })}
</ul>
