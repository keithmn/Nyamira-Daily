---
// Service counts as pictures: one icon per place, up to 10 shown, then "+N".
interface Props { counts: { cat: string; n: number; href?: string }[] }
const { counts } = Astro.props;
import Icon from '../Icon.astro';
import { categoryIcon } from '../../lib/icons.js';
---
<ul class="pictos">
  {counts.map((c) => {
    const Tag = c.href ? 'a' : 'div';
    const shown = Math.min(c.n, 10);
    return (
      <li>
        <Tag class="pc" href={c.href}>
          <span class="pc-icons" aria-hidden="true">
            {Array.from({ length: shown }, () => <Icon name={categoryIcon[c.cat] ?? 'source'} size={22} />)}
            {c.n > shown && <span class="pc-more">+{c.n - shown}</span>}
          </span>
          <span class="pc-text"><b>{c.n}</b> {c.cat}</span>
        </Tag>
      </li>
    );
  })}
</ul>
