---
// Shows the "Not updated recently" tag on active alerts more than 72 hours after their last update,
// using the reader's clock (the build also sets it, but the site may not be rebuilt for days).
import { STALE_HOURS } from '../lib/alerts.js';
---
<script is:inline define:vars={{ H: STALE_HOURS }}>
document.querySelectorAll('[data-stale]').forEach(function (el) {
  el.hidden = Date.now() - new Date(el.getAttribute('data-stale')).getTime() <= H * 36e5;
});
</script>
