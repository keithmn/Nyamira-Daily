---
// The site header (decision #60): one glass bar with the logo, the eight sections and the tools.
// Desktop: the sections in a row, no bullets; each opens a mega menu of cards in its colour.
// Phones and tablets: a hamburger opens a sheet with every section and its pages.
// Without JavaScript the desktop sections are plain links and the hamburger still opens (it is a <details>).
import Icon from './Icon.astro';
import { sections, sectionFor, stateFor, anchorFor, sectionTone } from '../nav.js';
import { planned } from '../config.js';
interface Props { path: string }
const { path } = Astro.props;
const section = sectionFor(path);
const state = (s: (typeof sections)[number]) => (s === section ? (s.href === path ? 'page' : 'true') : undefined);
const tone = (s: (typeof sections)[number]) => sectionTone[s.label] ?? 'mist';
const chev = '<svg class="chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>';
---
<header class="site-header">
  <div class="wrap hdr">
    <a class="brand" href="/">
      <!-- Horizontal logo; the symbol alone on very narrow screens. Reverse versions in dark mode. -->
      <span class="logo-h">
        <img class="for-light" src="/brand/Nyamira-Daily_horizontal_full-colour.svg" alt="Nyamira Daily" width="1197" height="228" />
        <img class="for-dark" src="/brand/Nyamira-Daily_horizontal_reverse.svg" alt="Nyamira Daily" width="1197" height="228" />
      </span>
      <span class="logo-s">
        <img class="for-light" src="/brand/Nyamira-Daily_symbol_full-colour.svg" alt="Nyamira Daily" width="216" height="256" />
        <img class="for-dark" src="/brand/Nyamira-Daily_symbol_reverse.svg" alt="Nyamira Daily" width="216" height="256" />
      </span>
    </a>

    <nav class="desk-nav" aria-label="Main sections">
      <ul>
        {sections.map((s) => (
          <li class={`sec-${tone(s)}`}>
            <a class="desk-link" href={s.href} aria-current={state(s)}>{s.label}</a>
            <button class="desk-item" type="button" aria-expanded="false" aria-controls={`mega-${anchorFor(s.label)}`} aria-current={state(s)}>
              {s.label}<Fragment set:html={chev} />
            </button>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr-tools">
      <button class="icon-btn theme-toggle desk-only" type="button" data-theme-toggle aria-pressed="false" aria-label="Dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <a class="icon-btn" href="/search/" aria-label="Search">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
      </a>

      <!-- Phones and tablets: the whole menu in one sheet -->
      <details class="menu sheet">
        <summary class="icon-btn burger" aria-label="Menu">
          <svg class="i-open" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
          <svg class="i-close" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
        </summary>
        <div class="sheet-panel">
          <div class="wrap sheet-inner">
            <form class="sheet-search" action="/search/" method="get" role="search">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
              <label class="vh" for="sheet-q">Search Nyamira Daily</label>
              <input id="sheet-q" name="q" type="search" autocomplete="off" placeholder="Search wards, schools, budgets…" />
            </form>
            {sections.map((s) => (
              <details class={`menu sheet-sec sec-${tone(s)}`} open={state(s) ? true : undefined}>
                <summary aria-current={state(s)}>
                  <Icon name={s.icon} size={24} badge />
                  <span class="ss-text"><b>{s.label}</b><small>{s.desc}</small></span>
                  <Fragment set:html={chev} />
                </summary>
                <div class="ss-body">
                  <a class="ss-go" href={s.href} aria-current={s.href === path ? 'page' : undefined}>{s.overview} <span aria-hidden="true">→</span></a>
                  <ul class="ss-pages">
                    {s.pages.map((p) => (
                      <li>
                        <a href={p.href} aria-current={stateFor(p, path)}><Icon name={p.icon ?? 'source'} size={20} /><span>{p.label}{planned.has(p.href) && <span class="tag-planned">Planned</span>}</span></a>
                        {p.pages && (
                          <div class="chips">
                            {p.pages.map((c) => <a href={c.href} aria-current={stateFor(c, path)}>{c.label}</a>)}
                          </div>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            ))}
            <div class="sheet-util">
              <button class="util-btn theme-toggle" type="button" data-theme-toggle aria-pressed="false">
                <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
                <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                <span class="when-light">Dark mode</span><span class="when-dark">Light mode</span>
              </button>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>

  <!-- Desktop mega menus: one per section, opened by its button in the bar -->
  <div class="megas">
    {sections.map((s) => (
      <div class={`mega sec-${tone(s)}`} id={`mega-${anchorFor(s.label)}`} hidden>
        <div class="wrap mega-inner">
          <div class="mega-intro">
            <Icon name={s.icon} size={30} badge />
            <p class="mega-title">{s.label}</p>
            <p class="mega-desc">{s.desc}</p>
            <a class="mega-go" href={s.href} aria-current={s.href === path ? 'page' : undefined}>{s.overview} <span aria-hidden="true">→</span></a>
          </div>
          <ul class="mega-cards">
            {s.pages.map((p) => (
              <li class={stateFor(p, path) ? 'mcard is-here' : 'mcard'}>
                <a class="mcard-main" href={p.href} aria-current={stateFor(p, path)}>
                  <Icon name={p.icon ?? 'source'} size={22} badge />
                  <span class="mcard-text"><b>{p.label}{planned.has(p.href) && <span class="tag-planned">Planned</span>}</b><small>{p.desc}</small></span>
                </a>
                {p.pages && (
                  <div class="chips">
                    {p.pages.map((c) => <a href={c.href} aria-current={stateFor(c, path)}>{c.label}</a>)}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</header>
