---
// Public facility report form (decision #49). Renders nothing until intake is
// configured, so profiles never show a "coming soon" box.
interface Props { facilityId: string; facilityName: string }
const { facilityId, facilityName } = Astro.props;
const intakeEnabled = import.meta.env.PUBLIC_FACILITY_INTAKE_ENABLED === 'true';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const retentionDays = Number(import.meta.env.PUBLIC_CORRECTION_RETENTION_DAYS);
const hasRetention = Number.isSafeInteger(retentionDays) && retentionDays >= 1 && retentionDays <= 3650;
const enabled = intakeEnabled && turnstileSiteKey && hasRetention;
const statuses = [
  ['reported-available', 'Available'],
  ['reported-unavailable', 'Not available'],
  ['unknown', 'Not sure / could not check'],
];
const reporters = [
  ['resident', 'I live or work nearby'],
  ['field-reporter', 'I am a Nyamira Daily field reporter'],
];
---
{enabled && (
  <section class="card stack" aria-labelledby="facility-report-heading">
    <h2 id="facility-report-heading">Report what you saw</h2>
    <form class="builder" data-facility-report action="/api/facility-observations" method="post">
      <p class="small muted">An editor checks every report before anything is published here. Your report alone does not change this page. Do not include names, phone numbers or other personal details, about yourself or anyone else. Reports are kept for up to {retentionDays} days; deletion may happen on the next service request after that period. You will not receive a reply.</p>
      <input type="hidden" name="facility" value={facilityId} />
      <label>What did you check?<span class="hint">One service or feature of {facilityName}, in your own words.</span><input name="capability" type="text" minlength="2" maxlength="120" required /></label>
      <fieldset class="choice"><legend>What did you find?</legend>{statuses.map(([value, label]) => <label><input type="radio" name="status" value={value} required /> {label}</label>)}</fieldset>
      <label>When did you see this?<input name="observedOn" type="date" required data-max-today /></label>
      <fieldset class="choice"><legend>Who is reporting?</legend>{reporters.map(([value, label]) => <label><input type="radio" name="sourceCategory" value={value} required /> {label}</label>)}</fieldset>
      <label>Anything else? (optional)<span class="hint">What you saw. About the service, not about any person: please don't name staff or anyone else.</span><textarea name="details" maxlength="2000"></textarea></label>
      <label>Public source link (optional)<input name="source" type="url" maxlength="2048" placeholder="https://…" /></label>
      <label hidden aria-hidden="true">Leave this field empty<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
      <button class="btn" type="submit">Send for review</button>
      <p class="muted" data-facility-report-status role="status" aria-live="polite"></p>
    </form>
  </section>
)}

{enabled && (
  <>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
      const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Africa/Nairobi' });
      document.querySelectorAll('[data-max-today]').forEach((input) => { input.setAttribute('max', today); });
      const form = document.querySelector('[data-facility-report]');
      const status = form?.querySelector('[data-facility-report-status]');
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !status) return;
        status.textContent = 'Sending for review…';
        const button = form.querySelector('button[type="submit"]');
        if (button instanceof HTMLButtonElement) button.disabled = true;
        try {
          const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
          const result = await response.json();
          if (!response.ok) {
            status.textContent = result.error || 'The report could not be saved.';
            return;
          }
          form.reset();
          const turnstile = Reflect.get(window, 'turnstile');
          if (typeof turnstile?.reset === 'function') turnstile.reset();
          status.textContent = `Saved for review. Reference: ${result.reference}. It has not changed this page.`;
        } catch {
          status.textContent = 'The report could not be confirmed as saved. Please try again later.';
        } finally {
          if (button instanceof HTMLButtonElement) button.disabled = false;
        }
      });
    </script>
  </>
)}
