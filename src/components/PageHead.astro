---
interface Crumb { href: string; label: string }
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: Crumb[]; tools?: boolean; tone?: string }
import { toneFor } from '../nav.js';
// Every page head is a coloured band in its section's Highlands colour; pass tone="none" for a plain one.
const { eyebrow, title, lead, crumbs = [], tools = true } = Astro.props;
const tone = Astro.props.tone ?? toneFor(Astro.url.pathname);
---
{crumbs.length > 0 && (
  <nav class="breadcrumb" aria-label="Breadcrumb">
    {crumbs.map((c, i) => (<><a href={c.href}>{c.label}</a>{i < crumbs.length - 1 ? ' / ' : ''}</>))}
  </nav>
)}
<header class={`stack page-head${tone && tone !== 'none' ? ` band sec-${tone}` : ''}`} style="padding: 24px 0 8px">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
</header>
