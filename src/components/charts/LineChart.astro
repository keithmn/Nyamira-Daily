---
// Line chart (decision #69). Grey for context, Ink for the series that matters; values labelled at the end of each
// line instead of a legend; faint gridlines and a solid zero line. Optional `gap` shades the space between the
// first two series in light red (money budgeted but not spent). Missing values (null) break the line.
interface Series { name: string; values: (number | null)[]; tone?: 'main' | 'context' | 'good' | 'gap'; end?: string }
interface Props { labels: string[]; series: Series[]; label: string; format?: (v: number) => string; max?: number; gap?: string; ticks?: number[] }
const { labels, series, label, gap } = Astro.props;
const fmt = Astro.props.format ?? ((v: number) => v.toLocaleString('en-KE'));
const W = 640, H = 300, L = 44, R = 112, T = 14, B = 34;
const all = series.flatMap((s) => s.values.filter((v): v is number => v != null));
const rawMax = Astro.props.max ?? Math.max(...all);
const step = (() => { const e = Math.pow(10, Math.floor(Math.log10(rawMax / 4))); for (const m of [1, 2, 2.5, 5, 10]) if (rawMax / (m * e) <= 5) return m * e; return 10 * e; })();
const top = Math.ceil(rawMax / step) * step;
const grid = Array.from({ length: Math.round(top / step) + 1 }, (_, i) => i * step);
const n = labels.length;
const x = (i: number) => L + (n === 1 ? 0 : (i * (W - L - R)) / (n - 1));
const y = (v: number) => T + (H - T - B) * (1 - v / top);
const segs = (vals) => { const out = []; let cur = []; vals.forEach((v, i) => { if (v == null) { if (cur.length) out.push(cur); cur = []; } else cur.push([x(i), y(v)]); }); if (cur.length) out.push(cur); return out; };
const ticks = Astro.props.ticks ?? (n <= 6 ? labels.map((_, i) => i) : [0, Math.round((n - 1) / 3), Math.round((2 * (n - 1)) / 3), n - 1]);
let gapPath = null;
if (gap && series.length >= 2) {
  const a = series[0].values, b = series[1].values;
  const idx = labels.map((_, i) => i).filter((i) => a[i] != null && b[i] != null);
  if (idx.length > 1) gapPath = 'M' + idx.map((i) => `${x(i).toFixed(1)} ${y(a[i]).toFixed(1)}`).join(' L') + ' L' + [...idx].reverse().map((i) => `${x(i).toFixed(1)} ${y(b[i]).toFixed(1)}`).join(' L') + 'Z';
}
// End labels: keep them at least 18 units apart
const ends = series.map((s, j) => { let i = s.values.length - 1; while (i >= 0 && s.values[i] == null) i--; return { j, i, v: s.values[i], yy: i >= 0 ? y(s.values[i]) : 0 }; }).filter((e) => e.i >= 0).sort((a, b) => a.yy - b.yy);
for (let k = 1; k < ends.length; k++) if (ends[k].yy - ends[k - 1].yy < 18) ends[k].yy = ends[k - 1].yy + 18;
const lastIdx = n - 1;
---
<svg class="kc kc-line" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
  {grid.map((g) => (<>
    <line class={g === 0 ? 'kc-zero' : 'kc-grid'} x1={L} x2={W - R + 6} y1={y(g)} y2={y(g)} />
    <text class="kc-yl" x={L - 8} y={y(g) + 4} text-anchor="end">{fmt(g)}</text>
  </>))}
  {gapPath && <path class="kc-gap" d={gapPath}><title>{gap}</title></path>}
  {gapPath && series[0].values[lastIdx] != null && series[1].values[lastIdx] != null && (
    <text class="kc-ann" x={x(lastIdx) - 10} y={(y(series[0].values[lastIdx]) + y(series[1].values[lastIdx])) / 2 + 5} text-anchor="end">{gap}</text>
  )}
  {series.map((s) => segs(s.values).map((pts) => (
    <polyline class={`kc-ln t-${s.tone ?? 'main'}`} points={pts.map((p) => p.map((c) => c.toFixed(1)).join(',')).join(' ')} />
  )))}
  {ends.map((e) => {
    const s = series[e.j];
    return (<>
      <circle class={`kc-pt t-${s.tone ?? 'main'}`} cx={x(e.i)} cy={y(e.v)} r="4.5" />
      <text class={`kc-end t-${s.tone ?? 'main'}`} x={x(e.i) + 10} y={e.yy + 5}>{s.end ?? `${s.name} ${fmt(e.v)}`}</text>
    </>);
  })}
  {ticks.map((i) => <text class="kc-xl" x={x(i)} y={H - 10} text-anchor={i === 0 ? 'start' : i === n - 1 ? 'end' : 'middle'}>{labels[i]}</text>)}
</svg>
