---
// Column chart (decision #69). Light grey columns for context; the columns that matter (`highlight`, default the
// latest) in Ink, or in red when the tone is a gap. Values written on the highlighted columns only.
// Missing values (null) show as a small "n/a" mark, never as zero.
interface Props { labels: string[]; values: (number | null)[]; label: string; format?: (v: number) => string; max?: number; highlight?: number[]; tone?: 'main' | 'gap' | 'good'; also?: number[]; ticks?: number[] }
const { labels, values, label, tone = 'main' } = Astro.props;
const fmt = Astro.props.format ?? ((v: number) => v.toLocaleString('en-KE'));
const n = labels.length;
const hi = Astro.props.highlight ?? [n - 1];
const also = Astro.props.also ?? [];
const W = 640, H = 280, L = 44, R = 10, T = 26, B = 34;
const nums = values.filter((v): v is number => v != null);
const rawMax = Astro.props.max ?? Math.max(...nums, 1);
const step = (() => { const e = Math.pow(10, Math.floor(Math.log10(rawMax / 4))); for (const m of [1, 2, 2.5, 5, 10]) if (rawMax / (m * e) <= 5) return m * e; return 10 * e; })();
const top = Astro.props.max ?? Math.ceil(rawMax / step) * step;
const grid = Array.from({ length: Math.floor(top / step) + 1 }, (_, i) => i * step);
const bw = (W - L - R) / n;
const y = (v: number) => T + (H - T - B) * (1 - v / top);
const ticks = Astro.props.ticks ?? (n <= 6 ? labels.map((_, i) => i) : [0, Math.round((n - 1) / 3), Math.round((2 * (n - 1)) / 3), n - 1]);
---
<svg class="kc kc-col" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
  {grid.map((g) => (<>
    <line class={g === 0 ? 'kc-zero' : 'kc-grid'} x1={L} x2={W - R} y1={y(g)} y2={y(g)} />
    <text class="kc-yl" x={L - 8} y={y(g) + 4} text-anchor="end">{fmt(g)}</text>
  </>))}
  {values.map((v, i) => {
    const cx = L + i * bw + bw / 2, w = Math.min(34, bw * 0.64);
    const on = hi.includes(i), mid = also.includes(i);
    return v == null ? (
      <text class="kc-na" x={cx} y={y(0) - 6} text-anchor="middle">n/a</text>
    ) : (<>
      <rect class={`kc-c${on ? ` on t-${tone}` : mid ? ' mid' : ''}`} x={cx - w / 2} y={y(v)} width={w} height={Math.max(0.5, y(0) - y(v))} rx="2"><title>{`${labels[i]}: ${fmt(v)}`}</title></rect>
      {(on || mid) && <text class={`kc-val${on ? ` t-${tone}` : ''}`} x={cx} y={y(v) - 7} text-anchor="middle">{fmt(v)}</text>}
    </>);
  })}
  {ticks.map((i) => <text class="kc-xl" x={L + i * bw + bw / 2} y={H - 10} text-anchor="middle">{labels[i]}</text>)}
</svg>
