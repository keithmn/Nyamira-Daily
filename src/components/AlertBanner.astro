---
// Banners under the header (spec 1.8 §2.1): active emergencies on every page; active disruptions only on
// the affected wards' pages and on /alerts/. The newest is shown, with "+N more". Readers can dismiss an
// alert's banner; the choice is kept in this browser only.
import { getAlerts } from '../lib/alerts-data.js';
import { shapePath, eat } from '../lib/alerts.js';
import { alertDismissalKey } from '../lib/alert-dismissal.js';
import wards from '../data/wards.json';
interface Props { ward?: string; disruptions?: boolean }
const { ward, disruptions = false } = Astro.props;
const all = (await getAlerts()).filter((a) => a.status === 'active').sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt));
const wn = Object.fromEntries(wards.map((w) => [w.slug, w.name]));
const groups = [
  { level: 'emergency', list: all.filter((a) => a.level === 'emergency') },
  { level: 'disruption', list: all.filter((a) => a.level === 'disruption' && (disruptions || (ward && a.wards.includes(ward)))) },
].filter((g) => g.list.length);
---
{groups.map((g) => (
  <div class={`alert-banner lv-${g.level}`} role="region" aria-label={g.level === 'emergency' ? 'Emergency alert' : 'Disruption'} data-abanner>
    {g.list.map((a, i) => (
      <div class="wrap" data-aid={alertDismissalKey(a)} hidden={i > 0}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path class="am-shape" d={shapePath(g.level, 10, 10.5, 8)} /></svg>
        <span class="ab-text"><a href={`/alerts/${a.id.toLowerCase()}/`}>{a.title}</a>{" "}<span class="ab-meta">· {a.wards.length ? a.wards.map((s) => wn[s] ?? s).join(', ') : 'County-wide'} · checked {a.checkedAt ? eat(a.checkedAt) : 'date not recorded'} · updated <span data-ago={new Date(a.updatedAt).toISOString()}>{eat(a.updatedAt)}</span></span>
          {g.list.length > 1 && <> · <a href="/alerts/" data-more>+{g.list.length - 1} more</a></>}</span>
        <button type="button" data-dismiss={alertDismissalKey(a)}>Hide</button>
      </div>
    ))}
  </div>
))}
{groups.length > 0 && (
  <script is:inline>
  (function () {
    var KEY = 'nd-alerts-hidden', hidden = [];
    try { hidden = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
    function ago(iso) {
      var m = Math.round((Date.now() - new Date(iso).getTime()) / 6e4);
      if (m < 60) return m <= 1 ? 'just now' : m + ' minutes ago';
      var h = Math.round(m / 60); if (h < 48) return h + (h === 1 ? ' hour ago' : ' hours ago');
      return Math.round(h / 24) + ' days ago';
    }
    document.querySelectorAll('[data-ago]').forEach(function (el) { el.textContent = ago(el.getAttribute('data-ago')); });
    function show() {
      document.querySelectorAll('[data-abanner]').forEach(function (b) {
        var items = Array.prototype.slice.call(b.querySelectorAll('[data-aid]'));
        var left = items.filter(function (it) { return hidden.indexOf(it.getAttribute('data-aid')) < 0; });
        items.forEach(function (it) { it.hidden = it !== left[0]; });
        b.hidden = left.length === 0;
        if (left[0]) { var more = left[0].querySelector('[data-more]'); if (more) { more.textContent = '+' + (left.length - 1) + ' more'; more.hidden = left.length < 2; } }
      });
    }
    document.querySelectorAll('[data-dismiss]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        hidden.push(btn.getAttribute('data-dismiss'));
        try { localStorage.setItem(KEY, JSON.stringify(hidden.slice(-50))); } catch (e) {}
        show();
      });
    });
    show();
  })();
  </script>
)}
