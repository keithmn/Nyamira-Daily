---
// Election-period notice (decision #77). Shows only in a build made inside `electionPeriod` (src/config.js), on
// Government, Elections, Leaders and NY Watch pages. The site is static: rebuild it when the period starts and ends.
import { electionPeriod, inElectionPeriod } from '../config.js';
import { date } from '../lib/fmt.js';
const show = inElectionPeriod();
---
{show && (
  <aside class="card stack election-notice" aria-label="Our rules during the election period" style="margin-top:16px">
    <span class="eyebrow">Election period · General Election {date(electionPeriod.electionDate)}</span>
    <p><strong>We carry no paid political content</strong>: no adverts, sponsored posts or paid interviews from any party, candidate or campaign. Every candidate for the same seat gets the same questions and the same space, or none of them appears.</p>
    <p class="small">Figures on this site come from public records, with their source and label. Read <a href="/how-we-work/">how we work</a> and <a href="/who-runs-us/">who runs us</a>.</p>
  </aside>
)}
