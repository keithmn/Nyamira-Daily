---
import money from '../data/money.json';
import ChartFrame from './charts/ChartFrame.astro';
import LineChart from './charts/LineChart.astro';
import ColumnChart from './charts/ColumnChart.astro';
import Illustration from './Illustration.astro';
import EvidenceLabel from './EvidenceLabel.astro';
import SplitBar from './viz/SplitBar.astro';
import EmbedCode from './EmbedCode.astro';
import Toggle from './Toggle.astro';
const ys = money.years;
const last = ys[ys.length - 1];
const bn = (m: number) => 'KSh ' + parseFloat((m / 1000).toFixed(2)) + 'B';
const mn = (m: number) => m >= 1000 ? bn(m) : `KSh ${m.toLocaleString('en-KE', { maximumFractionDigits: 1 })}M`;
const totalSpent = ys.reduce((n, y) => n + y.spent, 0);
const labels = ys.map((y) => y.fy);
const fmtB = (v: number) => (v / 1000).toLocaleString('en-KE', { maximumFractionDigits: 1 });
// Titles that state the finding (decision #69), worked out from the figures so they stay true when data changes.
const pct = (y) => (y.spent / y.budget) * 100;
const sinceWhen = (vals) => {
  const cur = vals[vals.length - 1];
  for (let i = vals.length - 2; i >= 0; i--) if (vals[i] != null && vals[i] <= cur) return i === vals.length - 2 ? null : labels[i];
  return 'start';
};
const spendShare = Math.round(pct(last));
const spendSince = sinceWhen(ys.map(pct));
const leadTitle = `In ${last.fy} the county spent ${spendShare}% of its budget` + (spendSince === 'start' ? `, the lowest share since our records begin in ${labels[0]}` : spendSince ? `, the lowest share since ${spendSince}` : '');
const devSince = sinceWhen(ys.map((y) => y.devAbs));
const devTitle = `Only ${last.devAbs}% of the development budget was used in ${last.fy}` + (devSince === 'start' ? `, the lowest since ${labels[0]}` : devSince ? `, the lowest since ${devSince}` : '');
const devLowIdx = devSince && devSince !== 'start' ? [labels.indexOf(devSince)] : [];
const notSpent = ys.map((y) => y.budget - y.spent);
const yearsTable = (cols, f) => ({ columns: ['Financial year', ...cols], rows: ys.map((y) => [y.fy, ...f(y)]) });
const tLead = yearsTable(['Budget (KSh M)', 'Spent (KSh M)', 'Share spent'], (y) => [y.budget, y.spent, pct(y).toFixed(1) + '%']);
const tDev = yearsTable(['Development budget used'], (y) => [y.devAbs + '%']);
const tNot = yearsTable(['Not spent (KSh M)'], (y) => [y.budget - y.spent]);
const tPend = yearsTable(['Pending bills (KSh M)'], (y) => [y.pending]);
const tOsr = yearsTable(['Target (KSh M)', 'Collected (KSh M)'], (y) => [y.osrTarget, y.osr]);
const fmtBn = (v) => fmtB(v * 1000);
const fmtPct = (v) => v + '%';
const sLead = [{ name: 'Budget', tone: 'context', values: ys.map((y) => y.budget / 1000), end: 'Budget ' + parseFloat((last.budget / 1000).toFixed(2)) }, { name: 'Spent', tone: 'main', values: ys.map((y) => y.spent / 1000), end: 'Spent ' + parseFloat((last.spent / 1000).toFixed(2)) }];
const sOsr = [{ name: 'Target', tone: 'context', values: ys.map((y) => y.osrTarget), end: 'Target ' + Math.round(last.osrTarget) }, { name: 'Collected', tone: 'good', values: ys.map((y) => y.osr), end: 'Collected ' + Math.round(last.osr) }];
const notSpentBn = notSpent.map((v) => v / 1000);
const devVals = ys.map((y) => y.devAbs);
const pendVals = ys.map((y) => y.pending);
const gapLabel = bn(last.budget - last.spent) + ' not spent';
const notTitle = 'KSh ' + fmtB(notSpent[notSpent.length - 1]) + ' billion of the ' + last.fy + ' budget was not spent';
const date = new Date(money.updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<div class="stack-lg" style="margin-top:24px">
  <section class="money-lead">
    <div class="figure lead-fig">
      <span class="eyebrow">Last full year · {last.fy}</span>
      <span class="num is-lead">{bn(last.spent)}</span>
      <p class="say">spent by the county, out of its final approved/revised budget of <strong>{bn(last.budget)}</strong>. The difference was <strong class="hot">{bn(last.budget - last.spent)}</strong>; this is not a measure of cash releases or proof that all budgeted funds were available to spend.</p>
      <Illustration id="money" tone="harvest" />
      <p class="source"><EvidenceLabel kind="official" /> Source: Controller of Budget, FY{last.fy} report</p>
    </div>
    <ChartFrame title={leadTitle} sub={`Final approved/revised budget and actual spending, KSh billion, ${labels[0]} to ${last.fy}`}
      evidence="official" source="Controller of Budget, County Budget Implementation Review Reports" note="The shaded gap is budget minus spending. It is not a measure of the cash the county received."
      table={tLead} csvName="nyamira-budget-and-spending">
      <LineChart label={`Budget and spending, ${labels[0]} to ${last.fy}, KSh billion`} labels={labels} format={fmtBn} gap={gapLabel} series={sLead} />
    </ChartFrame>
  </section>

  <section class="fig-row" aria-label="Other key figures">
    <div class="figure">
      <span class="eyebrow">Since devolution began</span>
      <span class="num">{bn(totalSpent)}</span>
      <p class="say">spent over 12 years, {labels[0]} to {last.fy} (each year's actual spending added up).</p>
      <p class="source"><EvidenceLabel kind="official" /> Source: Controller of Budget annual reports</p>
    </div>
    <div class="figure">
      <span class="eyebrow">Unpaid bills · {last.fy}</span>
      <span class="num hot">{mn(last.pending)}</span>
      <p class="say">owed to suppliers and contractors at the end of the year.</p>
      <p class="small muted">{last.pendingNote}</p>
      <p class="source"><EvidenceLabel kind="official" /> Source: Controller of Budget, FY{last.fy} report</p>
    </div>
    <div class="figure">
      <span class="eyebrow">Raised locally · {last.fy}</span>
      <span class="num">{mn(last.osr)}</span>
      <p class="say">from fees, rates and permits, against a target of <strong>{mn(last.osrTarget)}</strong>.</p>
      <SplitBar title={`Own-source revenue ${last.fy}`} parts={[{ value: last.osr, label: 'collected', tone: 'good', show: mn(last.osr) }, { value: Math.max(0, last.osrTarget - last.osr), label: 'short of target', tone: 'gap', show: mn(last.osrTarget - last.osr) }]} />
      <p class="small muted">{last.osrNote}</p>
      <p class="source"><EvidenceLabel kind="official" /> Source: Controller of Budget, FY{last.fy} report</p>
    </div>
  </section>

  <ChartFrame title={devTitle} sub={`Share of the development budget (roads, buildings, water) spent each year, %, ${labels[0]} to ${last.fy}`}
    evidence="official" source="Controller of Budget, County Budget Implementation Review Reports" note={`Most county money goes on salaries and running costs. Development spending in ${last.fy}: ${bn(last.dev)}.`}
    table={tDev} csvName="nyamira-development-budget-used">
    <ColumnChart label={`Share of the development budget used each year, ${labels[0]} to ${last.fy}`} labels={labels} values={devVals} max={100} format={fmtPct} tone="gap" also={devLowIdx} />
  </ChartFrame>

  <p class="callout"><span><strong>What did the Auditor-General find?</strong> See the audit opinion on the county's accounts for every year, and the findings behind it: <a href="#audit">What the Auditor-General found</a>.</span></p>

  <div class="sw" lang="sw">
    <span class="eyebrow">Muhtasari kwa Kiswahili</span>
    <p>Mwaka wa fedha {last.fy}, kaunti ya Nyamira ilitumia {bn(last.spent)} kati ya bajeti ya {bn(last.budget)}. Ni asilimia {last.devAbs} tu ya bajeti ya maendeleo iliyotumika. Takwimu hizi ni kutoka kwa Msimamizi wa Bajeti (Controller of Budget).</p>
  </div>

  <Toggle id="charts" title="Twelve years in charts" meta="Money not spent, unpaid bills, local revenue">
  <div class="stack-lg">
    <ChartFrame title={notTitle} sub="Final approved/revised budget minus reported actual spending, KSh billion, by financial year"
      evidence="official" source="Nyamira Daily, from the Controller of Budget's figures" note="Worked out by Nyamira Daily. This difference is not a cash-release figure."
      table={tNot} csvName="nyamira-budget-not-spent">
      <ColumnChart label="Budget not spent each year, KSh billion" labels={labels} values={notSpentBn} format={fmtBn} tone="gap" />
    </ChartFrame>
    <ChartFrame title="Unpaid bills at the end of each year" sub="Pending bills reported by the Controller of Budget, KSh million. Years marked n/a were not reported."
      evidence="official" source="Controller of Budget, County Budget Implementation Review Reports" note="Reports count pending bills differently from year to year; see the notes in the table below."
      table={tPend} csvName="nyamira-pending-bills">
      <ColumnChart label="Pending bills reported at year end, KSh million" labels={labels} values={pendVals} tone="gap" />
    </ChartFrame>
    <ChartFrame title="Money the county raised itself, against its own target" sub="Own-source revenue target and amount collected, KSh million, by financial year"
      evidence="official" source="Controller of Budget, County Budget Implementation Review Reports" note="From FY2022/23 this includes hospital fees, so later years are not directly comparable with earlier ones."
      table={tOsr} csvName="nyamira-own-source-revenue">
      <LineChart label="Own-source revenue target and collected, KSh million" labels={labels}
        series={sOsr} />
    </ChartFrame>
  </div>
  </Toggle>

  <details>
    <summary>See the detail: every figure, with its source</summary>
    <p class="small muted" style="margin:4px 0 12px">{money.note} All amounts in KSh.</p>
    <div class="table-box">
      <table class="cards">
        <thead><tr><th>Year</th><th class="num">Approved/revised budget</th><th class="num">Actual expenditure</th><th class="num">Development expenditure</th><th class="num">Dev. budget used</th><th class="num">Own-source revenue collected</th><th class="num">Equitable share reported</th><th class="num">Pending bills</th><th>Source</th></tr></thead>
        <tbody>
          {ys.map((y) => (
            <tr>
              <td>{y.fy}</td>
              <td class="num" data-label="Approved/revised budget">{mn(y.budget)}</td>
              <td class="num" data-label="Actual expenditure">{mn(y.spent)}</td>
              <td class="num" data-label="Development expenditure">{mn(y.dev)}</td>
              <td class="num" data-label="Dev. budget used">{y.devAbs}%</td>
              <td class="num" data-label="Raised locally">{mn(y.osr)}{y.osrNote ? ' *' : ''}</td>
              <td class="num" data-label="Equitable share reported">{mn(y.eqShare)}</td>
              <td class="num" data-label="Pending bills">{y.pending != null ? mn(y.pending) : 'Not reported'}{y.pendingNote ? ' *' : ''}</td>
              <td data-label="Source"><a href={y.src} rel="noopener">CoB {y.fy}</a> <span class="small muted">{y.page}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="small" style="margin-top:12px">
      {ys.filter((y) => y.osrNote || y.pendingNote).map((y) => (
        <li><strong>{y.fy}:</strong> {y.osrNote} {y.pendingNote}</li>
      ))}
    </ul>
  </details>

  <section class="stack">
    <h2>Read these figures with care</h2>
    <ul>{money.caveats.map((c) => <li>{c}</li>)}</ul>
    <p class="updated">Last updated {date}. Spotted an error? See <a href="/how-we-work/#corrections">corrections</a>.</p>
  </section>

  <EmbedCode path="/embed/money/" title="Nyamira County money" height={640} />
</div>
