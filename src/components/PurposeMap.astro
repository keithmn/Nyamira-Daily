---
// One county map, drawn for one purpose (decision #55). Each purpose has its own colours and key,
// so a reader never confuses them:
// - navigate:   find your ward. Sub-counties in four greens; every ward is a link.
// - facilities: what our facility list holds. Wards shaded by how many facilities are listed (Rain blues).
//               No points: a facility gets a map point only once its location is reviewed (ledger item 6).
// - alerts:     civic alerts. A neutral map; only alert marks carry colour (red = emergency, decision #25).
// Works without JavaScript; the facilities map's category buttons need it and default to "All".
import geo from '../data/geo.json';
import nb from '../data/neighbours.json';
import wards from '../data/wards.js';
import Icon from './Icon.astro';
import AlertMarks from './AlertMarks.astro';
import AlertKey from './AlertKey.astro';
import { subCounties } from '../nav.js';
import { categoryIcon } from '../lib/icons.js';
interface Props { mode: 'navigate' | 'facilities' | 'alerts'; alerts?: any[]; id?: string }
const { mode, alerts = [], id = `pm-${mode}` } = Astro.props;
const bySlug = Object.fromEntries(wards.map((w) => [w.slug, w]));
const subIdx = Object.fromEntries(subCounties.map((s, i) => [s, i + 1]));
const cats = Object.keys(categoryIcon).filter((c) => wards.some((w) => w.counts[c]));
const total = (w, c = null) => (c ? w.counts[c] ?? 0 : w.facilities.length);
const maxAll = Math.max(...wards.map((w) => total(w)));
// Five steps, upper bounds as shares of the largest ward count (so the key always reads in real numbers)
const step = (n, max) => (n === 0 ? 0 : Math.min(5, Math.ceil((n / max) * 5)));
const bounds = [1, 2, 3, 4, 5].map((k) => Math.ceil((k / 5) * maxAll));
const facData = JSON.stringify(Object.fromEntries(wards.map((w) => [w.slug, { all: w.facilities.length, ...w.counts }]))).split('<').join('\\u003c');
const titles = {
  navigate: ['map', 'Find your ward', 'Every ward links to its page: its MCA, money, projects and services.'],
  facilities: ['health', 'What our facility list holds', 'Darker wards have more facilities in our list. The list is incomplete, so a pale ward may just be less documented.'],
  alerts: ['alert', 'Civic alerts', 'Confirmed emergencies, disruptions and notices, placed where they happen. Red means an emergency, nothing else.'],
};
const [icon, title, purpose] = titles[mode];
const label = mode === 'navigate' ? 'Map of Nyamira County with its 20 wards, coloured by sub-county; each ward links to its page.'
  : mode === 'facilities' ? 'Map of Nyamira County shading each ward by the number of facilities in the Nyamira Daily list.'
  : `Map of Nyamira County showing ${alerts.length} current alert${alerts.length === 1 ? '' : 's'}.`;
---
<section class={`pmap pm-${mode}`} id={id} aria-labelledby={`${id}-t`}>
  <header class="pm-head">
    <Icon name={icon} size={24} badge />
    <div><h2 id={`${id}-t`}>{title}</h2><p class="small">{purpose}</p></div>
  </header>

  {mode === 'facilities' && (
    <div class="pm-cats chips" role="group" aria-label="Show one kind of facility" data-pm-cats hidden>
      <button type="button" class="chip" aria-pressed="true" data-cat="all">All</button>
      {cats.map((c) => <button type="button" class="chip" aria-pressed="false" data-cat={c}><Icon name={categoryIcon[c]} size={16} />{c}</button>)}
    </div>
  )}

  <svg viewBox="-60 -40 720 1030" role="img" aria-label={label}>
    <defs><clipPath id={`${id}-clip`}><rect x="-60" y="-40" width="720" height="1030" rx="20" /></clipPath></defs>
    <g class="pm-nb" clip-path={`url(#${id}-clip)`} aria-hidden="true">
      {Object.entries(nb.counties).filter(([n]) => n !== 'Nyamira').map(([, c]) => <path d={c.d} />)}
    </g>
    {Object.entries(geo.wards).map(([s, g]) => {
      const w = bySlug[s];
      const n = total(w);
      const href = mode === 'facilities' ? `/ward/${s}/#services` : `/ward/${s}/`;
      const cls = mode === 'navigate' ? `pm-w sc${subIdx[w.subCounty]}` : mode === 'facilities' ? `pm-w f${step(n, maxAll)}` : 'pm-w';
      return (
        <a href={href} data-w={s}>
          <title>{mode === 'facilities' ? `${w.name}: ${n} listed` : w.name}</title>
          <path class={cls} d={g.d} />
        </a>
      );
    })}
    {mode !== 'alerts' && Object.entries(geo.wards).map(([s, g]) => (
      <g class="pm-lab" aria-hidden="true">
        <text x={g.cx} y={g.cy}>{bySlug[s].name}</text>
        {mode === 'facilities' && <text class="pm-n" x={g.cx} y={Number(g.cy) + 26} data-n={s}>{total(bySlug[s])}</text>}
      </g>
    ))}
    {mode === 'alerts' && <AlertMarks alerts={alerts} r={16} />}
  </svg>

  <div class="pm-key small">
    {mode === 'navigate' && subCounties.map((s) => <span class="key"><i class={`pm-sw sc${subIdx[s]}`}></i>{s}</span>)}
    {mode === 'facilities' && (
      <>
        <span class="key"><i class="pm-sw f0"></i>0</span>
        {bounds.map((b, i) => <span class="key"><i class={`pm-sw f${i + 1}`}></i>{i === 0 ? `1–${b}` : `${bounds[i - 1] + 1}–${b}`}</span>)}
        <span class="key" data-pm-scale>Facilities listed per ward</span>
      </>
    )}
    {mode === 'alerts' && (alerts.length ? <AlertKey /> : <span class="key"><Icon name="check" size={18} />No current alerts on the map. <a href="/alerts/">See the alerts record</a></span>)}
  </div>
  {mode === 'facilities' && <p class="source small">Source: the Nyamira Daily facility list (247 records, mostly unverified; see <a href="/data/open-data/">Open data</a>). Ward boundaries: geoBoundaries (CC BY 4.0).</p>}
  {mode !== 'facilities' && <p class="source small">Ward and county boundaries: geoBoundaries (CC BY 4.0).</p>}
  {mode === 'facilities' && <script is:inline type="application/json" data-pm-fac set:html={facData}></script>}
</section>
