---
// Field-guide home hero inspired by civictech.guide: luminous soft-mint topographic wash, giant dark charcoal
// headline, 2x2 live metric grid, graphic Nyamira 20-ward interactive map with geometric arrow motif, and an
// overlapping floating white ward-picker card with crisp charcoal offset shadow. Zero raw colours; real data only.
import geo from '../data/geo.json';
import nb from '../data/neighbours.json';
import wards from '../data/wards.js';
import leaders from '../data/leaders.json';
import { places } from '../lib/places.js';
import { budget2526 } from '../lib/projects.js';
import { roads } from '../lib/roads.js';
import { contracts } from '../lib/contracts.js';
import money from '../lib/county-money.js';
import { ksh } from '../lib/fmt.js';
import { subCounties } from '../nav.js';
import { lead } from '../lib/now.js';

const facilities = places.filter((p) => p.kind === 'facility');
const last = money.years[money.years.length - 1];
const bn = (m) => 'KSh ' + parseFloat((m / 1000).toFixed(2)) + 'B';
const subClass = { Borabu: 's1', 'Kitutu Masaba': 's2', 'North Mugirango': 's3', 'West Mugirango': 's4' };
const nbLabels = [['Homa Bay', -110, 190], ['Kericho', 610, 80], ['Bomet', 630, 560], ['Kisii', -60, 620]];

const info = Object.fromEntries(wards.map((w) => {
  const b = budget2526(w.slug);
  const mca = leaders.mcas[w.slug];
  return [w.slug, {
    n: w.name,
    s: w.subCounty,
    f: w.facilities.length,
    b: b == null ? null : ksh(b),
    m: mca?.name ?? null,
  }];
}));

const leadW = lead && info[lead.ward] ? { slug: lead.ward, name: info[lead.ward].name, cx: Number(geo.wards[lead.ward].cx), cy: Number(geo.wards[lead.ward].cy), title: lead.headline } : null;
const dataJson = JSON.stringify(info).split('<').join('\\u003c');
---
<section class="fg-hero" aria-label="Nyamira County civic field guide">
  <div class="wrap fg-hero-grid">
    <!-- Left column: directional arrow stamp + display headline + 2x2 figure grid -->
    <div class="fg-hero-left">
      <div class="fg-title-wrap">
        <svg class="fg-title-arrow" viewBox="0 0 96 96" aria-hidden="true">
          <path d="M16 16 H80 V80 H58 V53 L26 85 L11 70 L43 38 H16 Z" fill="currentColor" />
        </svg>
        <h1>Discover Nyamira’s living field guide to places, money &amp; community.</h1>
      </div>

      <div class="fg-stat-quad" aria-label="Records in the guide">
        <div class="fg-sq-item">
          <b class="fg-sq-num">{facilities.length}</b>
          <strong class="fg-sq-label">listed public places</strong>
          <p class="fg-sq-sub">
            Browse <a href="/map/health/">Health</a>, <a href="/map/education/">Schools</a>, <a href="/money/farming/">Farming</a> &amp; <a href="/map/">Map</a>
          </p>
        </div>

        <div class="fg-sq-item">
          <b class="fg-sq-num">{bn(last.budget)}</b>
          <strong class="fg-sq-label">county budget ({last.fy})</strong>
          <p class="fg-sq-sub">
            Follow <a href="/money/2025-26/departments/">24 departments</a> &amp; <a href="/money/track/">what was spent</a>
          </p>
        </div>

        <div class="fg-sq-item">
          <b class="fg-sq-num">{contracts.length.toLocaleString('en-GB')}</b>
          <strong class="fg-sq-label">contracts &amp; NG-CDF</strong>
          <p class="fg-sq-sub">
            County tenders &amp; national money in <a href="/money/contracts/">separate lists</a>
          </p>
        </div>

        <div class="fg-sq-item">
          <b class="fg-sq-num">{roads.length}</b>
          <strong class="fg-sq-label">county roads tracked</strong>
          <p class="fg-sq-sub">
            Across all <a href="/ward/">20 wards</a> with status &amp; <a href="/report/">site checks</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Right column: graphic interactive county map + outlined arrow motif + overlapping white ward card -->
    <div class="fg-hero-right">
      <div class="fg-map-stage">
        <svg class="fg-corner-arrow" viewBox="0 0 110 110" aria-hidden="true">
          <path d="M92 32 L52 72 H88 V94 H16 V22 H38 V58 L78 18 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
        </svg>

        <div class="fg-map-frame">
          <span class="fg-map-caption">Tap or point at any of Nyamira’s 20 wards</span>
          <svg class="fg-hero-svg" viewBox="-150 -40 860 1030" preserveAspectRatio="xMidYMid meet" aria-label={`Interactive map of Nyamira County's 20 wards. Each ward links to its page${leadW ? `; a dot marks ${leadW.name}` : ''}.`}>
            <g class="fg-nb" aria-hidden="true">
              {Object.entries(nb.counties).filter(([n]) => n !== 'Nyamira').map(([, c]) => <path d={c.d} />)}
              {nbLabels.map(([n, x, y]) => <text x={x} y={y}>{n}</text>)}
            </g>
            <g class="fg-county">
              {Object.entries(geo.wards).map(([slug, w]) => (
                <a href={`/ward/${slug}/`} data-w={slug} aria-label={`${w.name} Ward, ${info[slug].s}`}>
                  <path class={`fg-w ${subClass[info[slug].s]}`} d={w.d} />
                </a>
              ))}
            </g>
            <g class="fg-towns" aria-hidden="true">
              <circle cx="297" cy="316" r="8" /><text x="297" y="346">Nyamira</text>
              <circle cx="352" cy="383" r="7" /><text x="369" y="389" class="left">Kebirigo</text>
              <circle cx="322" cy="708" r="7" /><text x="339" y="714" class="left">Keroka</text>
            </g>
            {leadW && (
              <a href={`/ward/${leadW.slug}/`} class="fg-pulse" aria-label={leadW.title ? `${leadW.name}: ${leadW.title}` : leadW.name}>
                <circle class="fg-ring" cx={leadW.cx} cy={leadW.cy} r="12" />
                <circle class="fg-dot" cx={leadW.cx} cy={leadW.cy} r="7" />
              </a>
            )}
            <g class="fg-tip" data-tip hidden aria-hidden="true">
              <rect rx="16" ry="16" height="36" />
              <text y="24" />
            </g>
          </svg>
        </div>

        <!-- Overlapping pure-white floating ward-finder card with hard offset shadow -->
        <div class="fg-float-card" data-card aria-live="polite">
          <strong class="fg-fc-title" data-fc-title>Know your ward. Follow the money.</strong>
          <p class="fg-fc-sub" data-fc-sub>Pick your ward to inspect its clinics, schools, budget &amp; MCA.</p>
          <label class="fg-fc-select">
            <span class="vh">Choose your ward</span>
            <select data-ward-pick data-hero-pick>
              <option value="">Choose your ward...</option>
              {subCounties.map((s) => (
                <optgroup label={`${s} Constituency`}>
                  {wards.filter((w) => w.subCounty === s).map((w) => <option value={w.slug}>{w.name}</option>)}
                </optgroup>
              ))}
            </select>
          </label>
          <a class="fg-fc-btn" data-fc-btn href="/ward/">Browse all 20 wards <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline type="application/json" data-wards set:html={dataJson} />
</section>

<script is:inline>
(function () {
  var hero = document.querySelector('.fg-hero'); if (!hero) return;
  var info = JSON.parse(hero.querySelector('[data-wards]').textContent);
  var svg = hero.querySelector('.fg-hero-svg');
  var tip = hero.querySelector('[data-tip]'), tipR = tip.querySelector('rect'), tipT = tip.querySelector('text');
  var titleEl = hero.querySelector('[data-fc-title]');
  var subEl = hero.querySelector('[data-fc-sub]');
  var btnEl = hero.querySelector('[data-fc-btn]');
  var links = Array.prototype.slice.call(svg.querySelectorAll('[data-w]'));
  var bySlug = {}; links.forEach(function (a) { bySlug[a.getAttribute('data-w')] = a; });
  var fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  var shown = '', saved = '';
  try { saved = localStorage.getItem('nd-ward') || ''; } catch (e) {}

  function setCard(slug) {
    var d = slug && info[slug];
    if (!d) {
      titleEl.textContent = 'Know your ward. Follow the money.';
      subEl.textContent = 'Pick your ward to inspect its clinics, schools, budget & MCA.';
      btnEl.href = '/ward/';
      btnEl.innerHTML = 'Browse all 20 wards <span aria-hidden="true">\u2192</span>';
      return;
    }
    titleEl.textContent = d.n + ' Ward';
    var parts = [d.s, d.f + ' places listed'];
    if (d.b) parts.push(d.b + ' ward budget');
    if (d.m) parts.push('MCA: ' + d.m);
    subEl.textContent = parts.join(' \u00b7 ');
    btnEl.href = '/ward/' + slug + '/';
    btnEl.innerHTML = 'Open ' + d.n + ' <span aria-hidden="true">\u2192</span>';
  }

  function showTip(slug) {
    var a = bySlug[slug], d = info[slug];
    if (!a || !d) { tip.setAttribute('hidden', ''); return; }
    tipT.textContent = d.n;
    tip.removeAttribute('hidden');
    var w = Math.max(104, tipT.getComputedTextLength() + 34), b = a.getBBox();
    var cx = Math.max(w / 2 - 120, Math.min(680 - w / 2, b.x + b.width / 2));
    var y = b.y > 48 ? b.y - 42 : b.y + b.height + 8;
    tipR.setAttribute('x', cx - w / 2); tipR.setAttribute('y', y); tipR.setAttribute('width', w);
    tipT.setAttribute('x', cx); tipT.setAttribute('y', y + 24);
  }

  function on(slug) {
    if (shown && bySlug[shown]) bySlug[shown].classList.remove('is-on');
    shown = slug;
    if (slug && bySlug[slug]) {
      svg.querySelector('.fg-county').appendChild(bySlug[slug]);
      bySlug[slug].classList.add('is-on');
      showTip(slug);
    } else {
      tip.setAttribute('hidden', '');
    }
    setCard(slug || saved);
  }

  function markSaved(slug) {
    links.forEach(function (a) { a.classList.toggle('mine', a.getAttribute('data-w') === slug); });
    saved = slug;
    if (slug && bySlug[slug]) svg.querySelector('.fg-county').appendChild(bySlug[slug]);
    setCard(slug);
  }

  links.forEach(function (a) {
    var slug = a.getAttribute('data-w');
    if (fine) {
      a.addEventListener('pointerenter', function () { on(slug); });
      a.addEventListener('pointerleave', function () { on(''); });
    } else {
      a.addEventListener('click', function (e) { if (shown !== slug) { e.preventDefault(); on(slug); } });
    }
    a.addEventListener('focus', function () { on(slug); });
    a.addEventListener('blur', function () { on(''); });
  });

  if (saved && info[saved]) markSaved(saved);
  document.addEventListener('nd-ward', function (e) { markSaved(e.detail || ''); });
})();
</script>
