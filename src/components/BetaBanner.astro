---
import { beta } from '../config.js';
---
{beta && (
  <aside class="beta-banner" role="status">
    <div class="beta-banner-inner">
      <span><strong>Public beta.</strong> We are verifying data across all pages. Every figure shows its source and evidence label. If something is wrong, <a href="/about/contact/">tell us</a> — corrections are published.</span>
      <button class="beta-banner-dismiss" aria-label="Dismiss notice">&#x2715;</button>
    </div>
  </aside>
)}

<style>
  .beta-banner {
    background: var(--nd-green-soft); border-bottom: 1.5px solid var(--nd-green);
    font-size: 0.8125rem; line-height: 1.45; color: var(--nd-charcoal);
  }
  .beta-banner-inner {
    max-width: var(--max); margin: 0 auto;
    display: flex; align-items: center; gap: 12px;
    padding: 6px 16px;
  }
  .beta-banner a { color: var(--nd-green-deep); font-weight: 700; }
  .beta-banner-dismiss {
    background: none; border: none; cursor: pointer; color: var(--nd-charcoal);
    font-size: 1rem; padding: 4px 8px; min-width: 32px; min-height: 32px; flex: none;
  }
</style>

<script>
  try {
    const banner = document.querySelector('.beta-banner');
    if (banner) {
      const dismissed = localStorage.getItem('nd-beta-dismiss') === '1';
      if (dismissed) banner.style.display = 'none';
      banner.querySelector('.beta-banner-dismiss')?.addEventListener('click', () => {
        try { localStorage.setItem('nd-beta-dismiss', '1'); } catch {}
        banner.style.display = 'none';
      });
    }
  } catch {}
</script>
