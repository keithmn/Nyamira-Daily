---
// "Is it working?" and Clinic check forms. Nothing is stored here: the form writes a structured message
// that opens in WhatsApp (contact.whatsapp) or points to the report form (reportFormUrl).
// TODO(service): receiving, checking and storing reports.
import wards from '../data/wards.js';
import { subCounties } from '../nav.js';
import { contact, reportFormUrl, canReport } from '../config.js';
interface Props { clinic?: boolean }
const { clinic = false } = Astro.props;
const places = Object.fromEntries(wards.map((w) => [w.name, [...new Set([
  ...w.facilities.filter((f) => !clinic || f.category === 'Health').map((f) => f.name),
  ...(clinic ? [] : w.places.map((p) => p.name)),
])].sort()]));
const data = JSON.stringify({ places, wa: contact.whatsapp, clinic }).split('<').join('\\u003c');
const cats = [['water', 'Water point'], ['health', 'Dispensary or health centre'], ['streetlight', 'Streetlight'], ['road', 'Road or bridge'], ['market', 'Market facility']];
---
<form class="builder" data-report onsubmit="return false">
  {!clinic && <label>What are you reporting on?<select name="category">{cats.map(([v, t]) => <option value={t}>{t}</option>)}</select></label>}
  <label>Ward
    <select name="ward" required><option value="">Choose</option>{subCounties.map((s) => <optgroup label={s}>{wards.filter((w) => w.subCounty === s).map((w) => <option>{w.name}</option>)}</optgroup>)}</select>
  </label>
  <label>{clinic ? 'Which health facility?' : 'Which place?'}<span class="hint">Choose from our list, or type the name.</span><input name="place" list="rep-places" autocomplete="off" /><datalist id="rep-places"></datalist></label>
  {!clinic && (
    <fieldset class="choice"><legend>Is it working?</legend>
      {['Working', 'Partly working', 'Not working', 'Closed', 'Not sure / could not check'].map((s) => <label><input type="radio" name="status" value={s} required /> {s}</label>)}
    </fieldset>
  )}
  {clinic && (
    <>
      <fieldset class="choice"><legend>Were the medicines you needed available?</legend>{['Yes', 'Some missing', 'None', 'Not sure / not checked'].map((s) => <label><input type="radio" name="medicines" value={s} required /> {s}</label>)}</fieldset>
      <fieldset class="choice"><legend>Was a health worker on duty?</legend>{['Yes', 'No', 'Not sure / not checked'].map((s) => <label><input type="radio" name="staff" value={s} required /> {s}</label>)}</fieldset>
      <fieldset class="choice"><legend>Was it open at its stated hours?</legend>{['Yes', 'No', 'Not sure / not checked'].map((s) => <label><input type="radio" name="openHours" value={s} required /> {s}</label>)}</fieldset>
      <fieldset class="choice"><legend>How long did you wait?</legend>{['Under 30 min', '30 to 60 min', '1 to 2 hours', 'Over 2 hours', 'Did not wait / not sure'].map((s) => <label><input type="radio" name="waiting" value={s} required /> {s}</label>)}</fieldset>
    </>
  )}
  <label>Short note<span class="hint">What you saw and when. About the service, not about any person: please don't name staff or anyone else.</span><textarea name="note"></textarea></label>
  <label>Your message<textarea class="out" id="rep-out" readonly></textarea></label>
  {canReport ? (
    <div class="page-tools">
      {contact.whatsapp ? <a class="btn" data-send href={`https://wa.me/${contact.whatsapp}`} rel="noopener">Send on WhatsApp</a> : <a class="btn" href={reportFormUrl} rel="noopener">Open the report form</a>}
      <span class="small muted">{contact.whatsapp ? 'You can add a photo in WhatsApp after the message.' : 'Copy your message into the form.'}</span>
    </div>
  ) : (
    <p class="callout"><span>No reporting channel is configured. Nothing you enter here is sent or stored; copy the draft yourself if you need to keep it.</span></p>
  )}
</form>
<script is:inline type="application/json" id="rep-data" set:html={data}></script>
<script is:inline>
(function () {
  var f = document.querySelector('[data-report]'); if (!f) return;
  var D = JSON.parse(document.getElementById('rep-data').textContent);
  var out = document.getElementById('rep-out'), dl = document.getElementById('rep-places'), send = f.querySelector('[data-send]');
  function v(n) { var el = f.elements[n]; if (!el) return ''; return (el.value || '').trim(); }
  function fill() {
    dl.textContent = '';
    (D.places[v('ward')] || []).forEach(function (n) { var o = document.createElement('option'); o.value = n; dl.appendChild(o); });
  }
  function build() {
    var lines = [D.clinic ? 'CLINIC CHECK for Nyamira Daily' : 'IS IT WORKING? report for Nyamira Daily'];
    if (!D.clinic) lines.push('Category: ' + v('category'));
    lines.push('Ward: ' + (v('ward') || '?'), 'Place: ' + (v('place') || '?'));
    if (D.clinic) {
      lines.push('Medicines available: ' + (v('medicines') || '?'), 'Health worker on duty: ' + (v('staff') || '?'),
        'Open at stated hours: ' + (v('openHours') || '?'), 'Waiting time: ' + (v('waiting') || '?'));
    } else lines.push('Status: ' + v('status'));
    lines.push('Date seen: ' + new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Africa/Nairobi' }));
    if (v('note')) lines.push('Note: ' + v('note'));
    out.value = lines.join('\n');
    if (send) send.href = 'https://wa.me/' + D.wa + '?text=' + encodeURIComponent(out.value);
  }
  f.addEventListener('change', function (e) { if (e.target.name === 'ward') fill(); build(); });
  f.addEventListener('input', build);
  f.addEventListener('click', function (e) {
    if (send && e.target.closest('[data-send]') && !f.reportValidity()) e.preventDefault();
  });
  fill(); build();
})();
</script>
