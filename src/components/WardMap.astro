---
// Inline SVG ward maps built at build time: no map library, no downloads,
// works on any phone and without JavaScript.
// mode "county": all 20 wards, each one a link to its ward page.
// mode "ward": zoomed to one ward, neighbours faint, OpenStreetMap points shown.
import geo from '../data/geo.json';
import wards from '../data/wards.json';
interface Props { mode: 'county' | 'ward'; slug?: string }
const { mode, slug } = Astro.props;
const sub = Object.fromEntries(wards.map((w) => [w.slug, w.subCounty]));
const subClass = { 'Borabu': 's1', 'Kitutu Masaba': 's2', 'North Mugirango': 's3', 'West Mugirango': 's4' };
const list = Object.entries(geo.wards);
const me = slug ? geo.wards[slug] : null;
const vb = mode === 'ward' && me ? me.vb : `0 0 ${geo.w} ${geo.h}`;
const r = me ? me.span * 0.014 : 4;
const cats = [
  { key: 'school', label: 'School' }, { key: 'health', label: 'Health' }, { key: 'worship', label: 'Place of worship' },
  { key: 'market', label: 'Market or shop' }, { key: 'place', label: 'Village or centre' },
];
const present = me ? cats.filter((c) => me.points.some((p) => p.cat === c.key)) : [];
---
<figure class={`wardmap ${mode}`}>
  <svg viewBox={vb} role="img" aria-label={mode === 'county' ? 'Map of Nyamira County showing its 20 wards. Tap a ward to open its page.' : `Map of ${me?.name} ward`}>
    {list.map(([s, w]) => mode === 'county' ? (
      <a href={`/ward/${s}/`} aria-label={`${w.name} ward`}>
        <path d={w.d} class={`ward ${subClass[sub[s]]}`} data-ward-row={s}><title>{w.name} ({sub[s]})</title></path>
      </a>
    ) : (
      s !== slug && <a href={`/ward/${s}/`} tabindex="-1"><path d={w.d} class="ward other"><title>{w.name}</title></path></a>
    ))}
    {mode === 'ward' && me && <path d={me.d} class="ward this" />}
    {mode === 'county' && list.map(([s, w]) => (
      <text x={w.cx} y={w.cy} class="wlabel" text-anchor="middle" dominant-baseline="middle">{w.name}</text>
    ))}
    {mode === 'ward' && me && list.filter(([s]) => s !== slug).map(([s, w]) => (
      <text x={w.cx} y={w.cy} class="wlabel faint" text-anchor="middle" style={`font-size:${me.span * 0.035}px`}>{w.name}</text>
    ))}
    {mode === 'ward' && me && me.points.map((p) => (
      <circle cx={p.x} cy={p.y} r={r} class={`pt ${p.cat}`}><title>{p.name}</title></circle>
    ))}
  </svg>
  {mode === 'county' ? (
    <figcaption class="small muted">
      <span class="key"><i class="s1"></i>Borabu</span>
      <span class="key"><i class="s2"></i>Kitutu Masaba</span>
      <span class="key"><i class="s3"></i>North Mugirango</span>
      <span class="key"><i class="s4"></i>West Mugirango</span>
      <span>Ward boundaries: geoBoundaries (CC BY 4.0), checked against the IEBC ward list.</span>
    </figcaption>
  ) : (
    <figcaption class="small muted">
      {present.length > 0 ? present.map((c) => <span class="key"><i class={`dot ${c.key}`}></i>{c.label}</span>) : <span>No mapped points yet.</span>}
      <span>Dots show only the {me?.points.length} named places already on OpenStreetMap, not everything in the ward. Boundaries: geoBoundaries (CC BY 4.0). Points: © OpenStreetMap contributors.</span>
    </figcaption>
  )}
</figure>
