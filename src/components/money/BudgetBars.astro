---
// Money infographic: budget against spending, one axis, two series (green, then seed brown).
// Values are the same figures as the headline above; bar lengths are proportional to the budget.
import { budgetYear, track, FY } from '../../lib/county-budget.js';
import { ksh } from '../../lib/fmt.js';

const y = budgetYear();
const t = track();
const total = y.total.value;
const spent = t.county.spent.value;
const share = Math.max(0, Math.min(100, Math.round((spent * 100) / total)));
---
<figure class="budget-bars" aria-label={`Budget and spending bars, ${FY}`}>
  <figcaption class="eyebrow">Budget against spending · {FY}</figcaption>
  <div class="bb-row">
    <span class="bb-label">Budget</span>
    <div class="bb-track"><div class="bb-fill bb-budget" style="width:100%"></div></div>
    <span class="bb-value">{ksh(total)}</span>
  </div>
  <div class="bb-row">
    <span class="bb-label">Spent</span>
    <div class="bb-track"><div class="bb-fill bb-spent" style={`width:${share}%`}></div></div>
    <span class="bb-value">{ksh(spent)} <span class="muted">({share}%)</span></span>
  </div>
  <p class="bb-source small muted">Bars share one scale, starting at zero. Source: county year-end report and Controller of Budget (see the figures above).</p>
</figure>

<style>
  .budget-bars { margin: 0; padding: 24px; border-radius: 20px; background: var(--nd-white); border: 1px solid var(--line); box-shadow: 0 1px 2px rgb(17 17 17 / 0.06), 0 10px 28px -12px rgb(17 17 17 / 0.16); display: flex; flex-direction: column; gap: 16px; }
  .bb-row { display: grid; grid-template-columns: 90px 1fr; grid-template-areas: "label track" "value value"; gap: 6px 14px; align-items: center; }
  .bb-label { grid-area: label; font-weight: 700; font-size: 15px; }
  .bb-track { grid-area: track; height: 22px; border-radius: 999px; background: var(--nd-paper); overflow: hidden; }
  .bb-fill { height: 100%; border-radius: 999px; }
  .bb-budget { background: var(--nd-green); }
  .bb-spent { background: var(--nd-brown); }
  .bb-value { grid-area: value; font-family: var(--title-font); font-weight: 600; font-size: 20px; }
  .bb-value .muted { font-family: var(--font); font-weight: 500; font-size: 14px; }
  .bb-source { margin: 0; }
  @media (min-width: 600px) { .bb-row { grid-template-columns: 90px 1fr auto; grid-template-areas: "label track value"; } }
</style>
