---
import '../styles/global.css';
import { toneFor } from '../nav.js';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionTabs from '../components/SectionTabs.astro';

import PageTools from '../components/PageTools.astro';
import AlertBanner from '../components/AlertBanner.astro';
interface Props { title: string; description?: string; tools?: boolean; image?: string; imageAlt?: string; alertWard?: string; showDisruptions?: boolean; noindex?: boolean }
const {
  title,
  description = 'Nyamira Daily: facts about Nyamira County, its money, services, laws and leaders, in plain language.',
  tools = true,
  image,
  imageAlt = 'Nyamira Daily',
  alertWard,
  showDisruptions = false,
  noindex = false,
} = Astro.props;

// Navigation (src/nav.js, SiteHeader.astro, SectionTabs.astro) works from this page's address.
const path = Astro.url.pathname;
const isHome = path === '/';
const pageTitle = title === 'Today' ? 'Nyamira Daily' : `${title} · Nyamira Daily`;

// Sharing (WhatsApp, Facebook, X): pages without their own image use the default card.
const shareTitle = title === 'Today' ? 'Nyamira Daily' : title;
const pageUrl = new URL(path, Astro.site).toString();
const shareImage = new URL(image ?? '/brand/og-default.png', Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="preload" href="/brand/fonts/VarelaRound-Latin.woff2" as="font" type="font/woff2" crossorigin />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="preload" href="/brand/fonts/LeagueSpartan-Medium.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#111111" /><!-- Ink; meta tags can't read CSS tokens -->
  <script is:inline>
  // Light or dark, set before the page draws: the reader's choice from the header toggle (saved in this
  // browser), otherwise the phone's setting. Choosing the same as the phone clears the saved choice.
  (function () {
    var KEY = 'nd-theme', root = document.documentElement;
    root.classList.add('js'); // JavaScript is running: show the section menus and the theme toggle
    var media = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
    function saved() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function phone() { return media && media.matches ? 'dark' : 'light'; }
    function show(theme) {
      root.setAttribute('data-theme', theme);
      var buttons = document.querySelectorAll('[data-theme-toggle]');
      for (var i = 0; i < buttons.length; i++) buttons[i].setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
    }
    function apply() { show(saved() || phone()); }
    apply();
    document.addEventListener('DOMContentLoaded', apply);
    if (media && media.addEventListener) media.addEventListener('change', apply);
    document.addEventListener('click', function (e) {
      if (!e.target.closest || !e.target.closest('[data-theme-toggle]')) return;
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      try { if (next === phone()) localStorage.removeItem(KEY); else localStorage.setItem(KEY, next); } catch (err) {}
      show(next);
    });
  })();
  </script>
  <link rel="icon" href="/brand/Nyamira-Daily_favicon.ico" sizes="32x32" />
  <link rel="icon" href="/brand/Nyamira-Daily_icon-square_on-black.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/brand/Nyamira-Daily_icon-square_on-black-180px.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Nyamira Daily" />
  <meta property="og:title" content={shareTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={shareImage} />
  {!image && <meta property="og:image:width" content="1200" />}
  {!image && <meta property="og:image:height" content="630" />}
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={shareTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImage} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <script is:inline>
  // Kiswahili summaries (decision #69): hidden behind one switch when JavaScript runs; the choice is remembered.
  (function () { var r = document.documentElement; r.classList.add('sw-js'); try { if (localStorage.getItem('nd-sw') === '1') r.classList.add('sw-on'); } catch (e) {} })();
  </script>
</head>
<body id="top">
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader path={path} />
  <SectionTabs path={path} />
  <AlertBanner ward={alertWard} disruptions={showDisruptions} />

  <main id="main" class={`sec-${toneFor(path)}`}>
    <slot name="hero" />
    <div class="wrap">
      <slot />
      {tools && <PageTools title={title} />}
    </div>
  </main>

  <!-- Footer: always Ink. Who we are, one action, one row of links, then the labels and credits. -->
  <SiteFooter />
  <script is:inline>
  (function () {
    var r = document.documentElement, has = document.querySelector('main .sw');
    var btns = Array.prototype.slice.call(document.querySelectorAll('[data-sw-switch]'));
    function show() { var on = r.classList.contains('sw-on'); btns.forEach(function (b) { b.setAttribute('aria-pressed', String(on)); b.textContent = on ? 'Hide Kiswahili' : 'Soma kwa Kiswahili'; }); }
    if (!has) return;
    btns.forEach(function (b) { b.hidden = false; b.addEventListener('click', function () { r.classList.toggle('sw-on'); try { localStorage.setItem('nd-sw', r.classList.contains('sw-on') ? '1' : '0'); } catch (e) {} show(); }); });
    show();
  })();
  </script>
  <script is:inline>
  (function () {
    var KEY = 'nd-ward', ward = '';
    try { ward = localStorage.getItem(KEY) || ''; } catch (e) {}
    var picks = all('[data-ward-pick]');
    function all(sel) { return Array.prototype.slice.call(document.querySelectorAll(sel)); }
    function apply() {
      document.documentElement.setAttribute('data-ward', ward);
      picks.forEach(function (p) { p.value = ward; });
      all('[data-ward-only]').forEach(function (el) { el.hidden = el.getAttribute('data-ward-only') !== ward; });
      all('[data-ward-row]').forEach(function (el) { el.classList.toggle('mine', el.getAttribute('data-ward-row') === ward); });
      all('[data-set-ward]').forEach(function (el) { el.hidden = el.getAttribute('data-set-ward') === ward; });
    }
    function choose(w) { ward = w; try { localStorage.setItem(KEY, w); } catch (e) {} apply(); }
    picks.forEach(function (p) { p.addEventListener('change', function () { choose(p.value); document.dispatchEvent(new CustomEvent('nd-ward', { detail: ward })); }); });
    all('[data-set-ward]').forEach(function (el) { el.addEventListener('click', function () { choose(el.getAttribute('data-set-ward')); }); });
    apply();

    // Toggles: a link to #something opens the toggle (and any toggle around it) so the target is visible
    function openTo() {
      var id = decodeURIComponent(location.hash.slice(1)); if (!id) return;
      var el = document.getElementById(id); if (!el) return;
      for (var n = el; n; n = n.parentElement) if (n.tagName === 'DETAILS') n.open = true;
      el.scrollIntoView();
    }
    openTo(); window.addEventListener('hashchange', openTo);

    // Secondary bar: on phones it scrolls sideways; centre the current tab if it starts off screen
    all('.tabs-scroll').forEach(function (bar) {
      var cur = bar.querySelector('[aria-current]');
      if (cur && cur.offsetLeft + cur.offsetWidth > bar.clientWidth) bar.scrollLeft = cur.offsetLeft - (bar.clientWidth - cur.offsetWidth) / 2;
    });

    // Desktop mega menus: a section button opens its panel under the bar; clicking it again, clicking
    // elsewhere or pressing Escape closes it. Only one is open at a time.
    var items = all('.desk-item');
    function megaOf(b) { return document.getElementById(b.getAttribute('aria-controls')); }
    function closeMegas(except) {
      items.forEach(function (b) {
        if (b === except) return;
        b.setAttribute('aria-expanded', 'false');
        megaOf(b).hidden = true;
      });
    }
    items.forEach(function (b) {
      b.addEventListener('click', function () {
        var open = b.getAttribute('aria-expanded') === 'true';
        closeMegas(b);
        b.setAttribute('aria-expanded', open ? 'false' : 'true');
        megaOf(b).hidden = open;
      });
    });
    document.addEventListener('click', function (e) {
      if (e.target.closest('.mega a') || (!e.target.closest('.desk-item') && !e.target.closest('.mega'))) closeMegas();
    });

    // Phones: the menu sheet holds the page still behind it while it is open
    var sheet = document.querySelector('details.sheet');
    if (sheet) sheet.addEventListener('toggle', function () { document.documentElement.classList.toggle('sheet-open', sheet.open); });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var open = items.filter(function (b) { return b.getAttribute('aria-expanded') === 'true'; })[0];
      if (open) { closeMegas(); open.focus(); }
      if (sheet && sheet.open) { sheet.open = false; sheet.querySelector('summary').focus(); }
    });
  })();
  </script>
</body>
</html>
