---
import '../styles/global.css';
import wards from '../data/wards.json';
import { sections, sectionFor, stateFor, subCounties, anchorFor, toneFor, sectionTone } from '../nav.js';
const dotStyle = (label) => { const t = sectionTone[label] ?? 'mist'; return t === 'mist' ? '--dot: var(--hl-mist); --dot-ring: var(--hl-tea)' : `--dot: var(--hl-${t})`; };

import PageTools from '../components/PageTools.astro';
import AlertBanner from '../components/AlertBanner.astro';
import { hasContact, planned } from '../config.js';
interface Props { title: string; description?: string; tools?: boolean; image?: string; imageAlt?: string; alertWard?: string; showDisruptions?: boolean }
const {
  title,
  description = 'Nyamira Daily: facts about Nyamira County, its money, services, laws and leaders, in plain language.',
  tools = true,
  image,
  imageAlt = 'Nyamira Daily',
  alertWard,
  showDisruptions = false,
} = Astro.props;

// Navigation (src/nav.js): the section this page is in. aria-current is "page" on the exact page
// and "true" on the section or entry that contains it.
const path = Astro.url.pathname;
const section = sectionFor(path);
const sectionState = (s: (typeof sections)[number]) => (s === section ? (s.href === path ? 'page' : 'true') : undefined);
const isHome = path === '/';
const pageTitle = title === 'Today' ? 'Nyamira Daily' : `${title} · Nyamira Daily`;

// Sharing (WhatsApp, Facebook, X): pages without their own image use the default card.
const shareTitle = title === 'Today' ? 'Nyamira Daily' : title;
const pageUrl = new URL(path, Astro.site).toString();
const shareImage = new URL(image ?? '/brand/og-default.png', Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="preload" href="/brand/fonts/VarelaRound-Latin-Title.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="preload" href="/brand/fonts/LeagueSpartan-Medium.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#111111" /><!-- Ink; meta tags can't read CSS tokens -->
  <script is:inline>
  // Light or dark, set before the page draws: the reader's choice from the header toggle (saved in this
  // browser), otherwise the phone's setting. Choosing the same as the phone clears the saved choice.
  (function () {
    var KEY = 'nd-theme', root = document.documentElement;
    root.classList.add('js'); // JavaScript is running: show the section menus and the theme toggle
    var media = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
    function saved() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function phone() { return media && media.matches ? 'dark' : 'light'; }
    function show(theme) {
      root.setAttribute('data-theme', theme);
      var buttons = document.querySelectorAll('[data-theme-toggle]');
      for (var i = 0; i < buttons.length; i++) buttons[i].setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
    }
    function apply() { show(saved() || phone()); }
    apply();
    document.addEventListener('DOMContentLoaded', apply);
    if (media && media.addEventListener) media.addEventListener('change', apply);
    document.addEventListener('click', function (e) {
      if (!e.target.closest || !e.target.closest('[data-theme-toggle]')) return;
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      try { if (next === phone()) localStorage.removeItem(KEY); else localStorage.setItem(KEY, next); } catch (err) {}
      show(next);
    });
  })();
  </script>
  <link rel="icon" href="/brand/Nyamira-Daily_favicon.ico" sizes="32x32" />
  <link rel="icon" href="/brand/Nyamira-Daily_icon-square_on-black.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/brand/Nyamira-Daily_icon-square_on-black-180px.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Nyamira Daily" />
  <meta property="og:title" content={shareTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={shareImage} />
  {!image && <meta property="og:image:width" content="1200" />}
  {!image && <meta property="og:image:height" content="630" />}
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={shareTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImage} />
  <meta name="twitter:image:alt" content={imageAlt} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <div class="bar">
        <div class="brand-slot">
          <a class="brand" href="/">
            <!-- Horizontal logo; the symbol alone when this slot is under 160px wide. Reverse versions in dark mode. -->
            <span class="logo-h">
              <img class="for-light" src="/brand/Nyamira-Daily_horizontal_full-colour.svg" alt="Nyamira Daily" width="1197" height="228" loading="lazy" />
              <img class="for-dark" src="/brand/Nyamira-Daily_horizontal_reverse.svg" alt="Nyamira Daily" width="1197" height="228" loading="lazy" />
            </span>
            <span class="logo-s">
              <img class="for-light" src="/brand/Nyamira-Daily_symbol_full-colour.svg" alt="Nyamira Daily" width="216" height="256" loading="lazy" />
              <img class="for-dark" src="/brand/Nyamira-Daily_symbol_reverse.svg" alt="Nyamira Daily" width="216" height="256" loading="lazy" />
            </span>
          </a>
        </div>
        <!-- Your ward: one picker for the whole site (see the script at the bottom). On phones it gets its own row. -->
        <div class={`ward-pick${isHome ? ' on-home' : ''}`}>
          <label class="ward-pill">
            <svg class="pin" viewBox="0 0 200 240" width="14" height="17" aria-hidden="true" focusable="false"><path d="M100 226C62 182 30 150 30 104 30 58 63 24 100 24s70 34 70 80c0 46-32 78-70 122z" fill="var(--nd-green)" /><circle cx="100" cy="102" r="34" fill="var(--nd-ink)" /></svg>
            <span>Your ward</span>
            <select id="ward-pick" data-ward-pick>
              <option value="">Whole county</option>
              {subCounties.map((s) => (
                <optgroup label={s}>
                  {wards.filter((w) => w.subCounty === s).map((w) => <option value={w.slug}>{w.name}</option>)}
                </optgroup>
              ))}
            </select>
          </label>
          {wards.map((w) => <a class="ward-open" data-ward-only={w.slug} hidden href={`/ward/${w.slug}/`}>Open {w.name}</a>)}
        </div>
        <div class="tools">
          <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Dark mode">
            <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </button>
          <a class="icon-btn" href="/search/" aria-label="Search">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
          </a>
          <details class="menu">
            <summary class="icon-btn ink"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg><span class="vh">Menu</span></summary>
            <div class="menu-panel stack">
              <label class="small" for="lang">Language</label>
              <select id="lang" class="lang" aria-label="Choose language">
                <option>English</option>
                <option disabled>Kiswahili (coming soon)</option>
                <option disabled>Ekegusii (coming soon)</option>
              </select>
              {hasContact && <a href="/tell-us/">Tell us about a project or problem</a>}
              {hasContact && <a href="/subscribe/">Get updates on WhatsApp</a>}
              <a href="/data/open-data/">Download the data</a>
              <a href="/about/">About Nyamira Daily</a>
              <a href="/how-we-work/">How we work</a>
            </div>
          </details>
        </div>
      </div>
    </div>
    <!-- Section bar: pills. With JavaScript each section is a button that opens a list of everything in it;
         without, each is a plain link to the section's page, which lists the same pages. -->
    <nav class="primary-nav" aria-label="Main sections">
      <div class="wrap">
        <div class="nav">
          {sections.map((s) => (
            <>
              <a class="nav-link" style={dotStyle(s.label)} href={s.href} aria-current={sectionState(s)}>{s.label}</a>
              <button class="nav-toggle" style={dotStyle(s.label)} type="button" aria-expanded="false" aria-controls={`menu-${anchorFor(s.label)}`} aria-current={sectionState(s)}>
                {s.label}<svg class="chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
            </>
          ))}
        </div>
      </div>
      <div class="nav-panels">
        {sections.map((s) => (
          <div class={`nav-panel sec-${sectionTone[s.label] ?? 'mist'}`} id={`menu-${anchorFor(s.label)}`} hidden>
            <div class="wrap">
              <ul class="menu-grid">
                <li class="menu-overview"><a href={s.href} aria-current={s.href === path ? 'page' : undefined}>{s.overview}</a></li>
                {s.pages.map((p) => (
                  <li>
                    {p.pages ? (
                      <details class="menu-group" open={stateFor(p, path) ? true : undefined}>
                        <summary aria-current={stateFor(p, path)}>{p.label}</summary>
                        <ul class="menu-sub">
                          <li><a href={p.href} aria-current={p.href === path ? 'page' : undefined}>About {p.label.replace(' Constituency', '')}</a></li>
                          {p.pages.map((c) => (
                            <li><a href={c.href} aria-current={stateFor(c, path)}>{c.label}{planned.has(c.href) && <span class="tag-planned">Planned</span>}</a></li>
                          ))}
                        </ul>
                      </details>
                    ) : (
                      <a href={p.href} aria-current={stateFor(p, path)}>{p.label}{planned.has(p.href) && <span class="tag-planned">Planned</span>}</a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </nav>
  </header>
  <AlertBanner ward={alertWard} disruptions={showDisruptions} />

  <main id="main" class={`sec-${toneFor(path)}`}>
    <slot name="hero" />
    <div class="wrap">
      <slot />
      {tools && <PageTools title={title} />}
    </div>
  </main>

  <!-- Footer: always Ink. Who we are, one action, one row of links, then the labels and credits. -->
  <footer class="site-footer">
    <div class="wrap">
      <div class="foot-top">
        <div class="foot-id">
          <img class="footer-logo" src="/brand/Nyamira-Daily_horizontal_reverse.svg" alt="Nyamira Daily" width="1197" height="228" loading="lazy" />
          <p><strong>Independent.</strong> Not affiliated with the County Government of Nyamira.</p>
        </div>
        <a class="pill-btn" href="/how-we-work/#corrections">Spotted a mistake? Tell us <span aria-hidden="true">→</span></a>
      </div>
      <nav class="foot-links" aria-label="Footer">
        <a href="/about/">About us</a>
        <a href="/how-we-work/">How we work</a>
        <a href="/how-we-work/#corrections">Corrections</a>
        <a href="/data/open-data/">Download the data</a>
        {hasContact && <a href="/subscribe/">WhatsApp and SMS updates</a>}
        {hasContact && <a href="/tell-us/">Report a project or problem</a>}
        <a href="/search/">Search</a>
      </nav>
      <div class="foot-fine">
        <p class="foot-labels"><span>Every figure carries a label:</span> <span class="label verified">Verified</span> <span class="label audit">Audit finding</span> <span class="label official">Official claim</span> <span class="label unverified">Unverified</span> <a href="/how-we-work/">What they mean</a></p>
        <p>© {new Date().getFullYear()} Nyamira Daily · Maps: geoBoundaries (CC BY 4.0), © OpenStreetMap contributors</p>
      </div>
    </div>
  </footer>
  <script is:inline>
  (function () {
    var KEY = 'nd-ward', ward = '';
    try { ward = localStorage.getItem(KEY) || ''; } catch (e) {}
    var picks = all('[data-ward-pick]');
    function all(sel) { return Array.prototype.slice.call(document.querySelectorAll(sel)); }
    function apply() {
      document.documentElement.setAttribute('data-ward', ward);
      picks.forEach(function (p) { p.value = ward; });
      all('[data-ward-only]').forEach(function (el) { el.hidden = el.getAttribute('data-ward-only') !== ward; });
      all('[data-ward-row]').forEach(function (el) { el.classList.toggle('mine', el.getAttribute('data-ward-row') === ward); });
      all('[data-set-ward]').forEach(function (el) { el.hidden = el.getAttribute('data-set-ward') === ward; });
    }
    function choose(w) { ward = w; try { localStorage.setItem(KEY, w); } catch (e) {} apply(); }
    picks.forEach(function (p) { p.addEventListener('change', function () { choose(p.value); document.dispatchEvent(new CustomEvent('nd-ward', { detail: ward })); }); });
    all('[data-set-ward]').forEach(function (el) { el.addEventListener('click', function () { choose(el.getAttribute('data-set-ward')); }); });
    apply();

    // Toggles: a link to #something opens the toggle (and any toggle around it) so the target is visible
    function openTo() {
      var id = decodeURIComponent(location.hash.slice(1)); if (!id) return;
      var el = document.getElementById(id); if (!el) return;
      for (var n = el; n; n = n.parentElement) if (n.tagName === 'DETAILS') n.open = true;
      el.scrollIntoView();
    }
    openTo(); window.addEventListener('hashchange', openTo);

    // On phones the primary bar scrolls sideways: centre the current section if it starts off screen
    all('.nav').forEach(function (bar) {
      var cur = all('.nav [aria-current]').filter(function (el) { return el.offsetParent !== null; })[0];
      if (cur && cur.offsetLeft + cur.offsetWidth > bar.clientWidth) bar.scrollLeft = cur.offsetLeft - (bar.clientWidth - cur.offsetWidth) / 2;
    });

    // Section menus: tapping a section opens the list of its pages below the bar; tapping it again,
    // tapping elsewhere or pressing Escape closes it. Only one is open at a time.
    var toggles = all('.nav-toggle');
    var siteMenu = document.querySelector('details.menu');
    function panelOf(t) { return document.getElementById(t.getAttribute('aria-controls')); }
    function closeMenus(except) {
      toggles.forEach(function (t) {
        if (t === except) return;
        t.setAttribute('aria-expanded', 'false');
        panelOf(t).hidden = true;
      });
    }
    toggles.forEach(function (t) {
      t.addEventListener('click', function () {
        var open = t.getAttribute('aria-expanded') === 'true';
        closeMenus(t);
        t.setAttribute('aria-expanded', open ? 'false' : 'true');
        panelOf(t).hidden = open;
        if (!open && siteMenu) siteMenu.open = false;
      });
    });
    if (siteMenu) siteMenu.addEventListener('toggle', function () { if (siteMenu.open) closeMenus(); });
    document.addEventListener('click', function (e) {
      if (e.target.closest('.nav-panel a') || (!e.target.closest('.nav-toggle') && !e.target.closest('.nav-panel'))) closeMenus();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var open = toggles.filter(function (t) { return t.getAttribute('aria-expanded') === 'true'; })[0];
      if (open) { closeMenus(); open.focus(); }
    });
  })();
  </script>
</body>
</html>
