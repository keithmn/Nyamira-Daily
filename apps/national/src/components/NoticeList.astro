---
// Notices from official documents, each with its dates, where, the law it cites and a link to the notice itself.
// Closed ones carry a "Closed" tag; nothing here is a date from a newspaper or a guess (decision #103).
import { longDate } from '@kbe/engine/fmt';
import { t } from '../i18n/index.js';

interface Props { list: any[]; closed?: boolean; lang?: 'en' | 'sw' }
const { list, closed = false, lang = 'en' } = Astro.props;
const when = (n) => n.dates.map((d) => longDate(d, lang)).join(', ');
---
<ol class="cal-list">
  {list.map((n) => (
    <li class="cal-item">
      <p class="cal-when">{when(n)}{closed ? <> <span class="tag">{t(lang, 'notice.closed')}</span></> : <span data-days-until={n.dates[0]} data-text={t(lang, 'cal.days', { n: '{n}' })}></span>}</p>
      <p class="cal-name" lang="en">{n.title}</p>
      <p class="small">{t(lang, `notice.kind.${n.kind}`, { who: n.organiser })} <span lang="en">{n.where}.</span></p>
      <p class="small muted" lang="en">{n.law}.</p>
      <p class="small"><a href={n.source.url} rel="noopener">{t(lang, 'notice.source')}</a></p>
    </li>
  ))}
</ol>
