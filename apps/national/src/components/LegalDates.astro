---
// The dates the law fixes, soonest first, each linked to its section of the PFM Act. The count of days is worked out again
// in the browser, so a page built weeks ago still counts from today.
import { t } from '../i18n/index.js';
import { legalCalendar } from '../lib/calendar.js';

interface Props { lang?: 'en' | 'sw' }
const { lang = 'en' } = Astro.props;
const dates = legalCalendar(lang);
---
<ol class="cal-list">
  {dates.map((d) => (
    <li class="cal-item">
      <p class="cal-when">{d.when}<span data-days-until={d.date} data-text={d.daysText}></span></p>
      <p class="cal-name">{d.name}</p>
      <p class="small">{d.what} <a href={d.doc.url} rel="noopener">{t(lang, 'cal.law', { page: d.page })}</a></p>
    </li>
  ))}
</ol>
