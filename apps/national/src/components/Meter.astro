---
// One county against the all-county figure. Both values are also printed, so the tick is never the only cue.
interface Props { value: number; mark: number; name: string; markName: string; label: string }
const { value, mark, name, markName, label } = Astro.props;
---
<div class="meter" role="img" aria-label={label}><span class="m-fill" style={`width:${value}%`}></span><span class="m-tick" style={`left:${mark}%`}></span></div>
<p class="m-key"><span><b>{value}%</b> {name}</span><span><b>{mark}%</b> {markName}</span></p>
