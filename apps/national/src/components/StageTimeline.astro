---
// Where the budget is now. Ticks, a ring and words carry the state, so it never rests on colour alone. Phones show the
// dots and one line of text, and there is no sideways scroll.
import { t } from '../i18n/index.js';
import { FY } from '../lib/figures.js';
import { timeline } from '../lib/stages.js';

interface Props { lang?: 'en' | 'sw' }
const { lang = 'en' } = Astro.props;
---
<div class="stack gap-s">
  <ol class="stage" aria-label={t(lang, 'stage.line.fy', { fy: FY })}>
    {timeline(lang).map((s) => (
      <li class={s.state === 'done' ? 'done' : undefined} aria-current={s.state === 'now' ? 'step' : undefined}>
        <span class="dot"></span>
        <span class="stage-parts"><b>{s.name}</b>{s.sub}</span>
        <span class="vh">{s.said}</span>
      </li>
    ))}
  </ol>
  <p class="stage-now">{t(lang, 'stage.nowLine')}</p>
</div>
