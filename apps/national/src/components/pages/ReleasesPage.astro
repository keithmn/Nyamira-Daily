---
// The changelog: one entry per data release, newest first, with what it added, changed and removed (build brief 4.6)
import { longDate, num } from '@kbe/engine/fmt';
import { t } from '../../i18n/index.js';
import { releases } from '../../lib/releases.js';
import { href } from '../../lib/routes.js';
import Breadcrumbs from '../Breadcrumbs.astro';

interface Props { lang?: 'en' | 'sw' }
const { lang = 'en' } = Astro.props;
const list = releases();
---
<div class="wrap"><Breadcrumbs lang={lang} trail={[{ name: t(lang, 'data.title'), path: '/data/' }, { name: t(lang, 'releases.title') }]} /></div>
<section class="band">
  <div class="wrap stack gap-l">
    <div class="page-head"><h1>{t(lang, 'releases.title')}</h1><p>{t(lang, 'releases.line')}</p></div>
    <ol class="cal-list">
      {list.map((r) => (
        <li class="cal-item">
          <p class="cal-when"><a href={href(lang, `/data/releases/${r.date}/`)}>{longDate(r.date, lang)}</a></p>
          <p>{t(lang, 'releases.counts', { figures: num(r.counts.figures), added: num(r.counts.added), changed: num(r.counts.changed), removed: num(r.counts.removed) })}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
