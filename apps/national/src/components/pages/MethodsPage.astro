---
// How each number we work out is made (build brief 5.13): the formula in words, and the code and test that hold it to that
import { t } from '../../i18n/index.js';
import Breadcrumbs from '../Breadcrumbs.astro';

interface Props { lang?: 'en' | 'sw' }
const { lang = 'en' } = Astro.props;
const METHODS = [
  ['gross', 'lib/votes.js'], ['sector', 'lib/votes.js'], ['change', 'lib/votes.js, @kbe/engine/compare'], ['stages', '@kbe/engine/compare'],
  ['hundred', 'lib/budget.js'], ['absorption', 'scripts/national/double-entry.mjs'], ['wages', 'scripts/national/build-figures.mjs'],
  ['rules', 'lib/rules.js'], ['projects', 'lib/projects.js'], ['taxes', 'lib/split.js'], ['days', 'lib/calendar.js'],
];
---
<div class="wrap"><Breadcrumbs lang={lang} trail={[{ name: t(lang, 'data.title'), path: '/data/' }, { name: t(lang, 'methods.title') }]} /></div>
<section class="band">
  <div class="wrap stack gap-l">
    <div class="page-head"><h1>{t(lang, 'methods.title')}</h1><p>{t(lang, 'methods.line')}</p></div>
    <dl class="methods">
      {METHODS.map(([key, code]) => (
        <div class="method">
          <dt>{t(lang, `methods.${key}`)}</dt>
          <dd><p>{t(lang, `methods.${key}.how`)}</p><p class="small muted">{t(lang, 'methods.code')} <code>{code}</code></p></dd>
        </div>
      ))}
    </dl>
    <p class="small muted">{t(lang, 'methods.never')}</p>
  </div>
</section>
