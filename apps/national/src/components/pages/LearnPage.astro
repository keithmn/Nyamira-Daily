---
// Learn: the explainers, then the glossary, the calendar and Your taxes
import { t } from '../../i18n/index.js';
import { explainers } from '../../lib/learn.js';
import { href } from '../../lib/routes.js';
import Breadcrumbs from '../Breadcrumbs.astro';

interface Props { lang?: 'en' | 'sw' }
const { lang = 'en' } = Astro.props;
const list = explainers();
---
<div class="wrap"><Breadcrumbs lang={lang} trail={[{ name: t(lang, 'nav.learn') }]} /></div>
<section class="band">
  <div class="wrap stack gap-l">
    <div class="page-head"><h1>{t(lang, 'learn.title')}</h1><p>{t(lang, 'learn.line', { n: list.length })}</p></div>
    {lang === 'sw' && <p class="small muted">{t(lang, 'learn.inEnglish')}</p>}
    <ol class="file-list learn-list">
      {list.map((e) => <li><a href={href(lang, `/learn/${e.slug}/`)} lang="en">{e.title}</a> <span class="small muted">{t(lang, 'learn.minutes', { n: e.minutes })}</span></li>)}
    </ol>
  </div>
</section>
<section class="band alt">
  <div class="wrap btn-row">
    <a class="btn quiet" href={href(lang, '/learn/glossary/')}>{t(lang, 'glossary.title')}</a>
    <a class="btn quiet" href={href(lang, '/learn/calendar/')}>{t(lang, 'cal.pageTitle')}</a>
    <a class="btn quiet" href={href(lang, '/tools/your-taxes/')}>{t(lang, 'taxes.title')}</a>
  </div>
</section>
