---
// The budget year: where FY2026/27 stands, and the dates the law fixes for the next one. County calendars are not loaded.
import { t } from '../../i18n/index.js';
import { allNotices, today } from '../../lib/figures.js';
import { upcoming } from '../../lib/notices.js';
import { href } from '../../lib/routes.js';
import Breadcrumbs from '../Breadcrumbs.astro';
import LegalDates from '../LegalDates.astro';
import NoticeList from '../NoticeList.astro';
import StageTimeline from '../StageTimeline.astro';

interface Props { lang?: 'en' | 'sw' }
const { lang = 'en' } = Astro.props;
const announcedDates = upcoming(allNotices(), today(), ['deadline']);
---
<div class="wrap"><Breadcrumbs lang={lang} trail={[{ name: t(lang, 'nav.learn'), path: '/learn/' }, { name: t(lang, 'cal.pageTitle') }]} /></div>
<section class="band">
  <div class="wrap stack gap-l">
    <div class="page-head"><h1>{t(lang, 'cal.pageTitle')}</h1><p>{t(lang, 'cal.pageLine')}</p></div>
    <StageTimeline lang={lang} />
  </div>
</section>
<section class="band alt" aria-labelledby="h-dates">
  <div class="wrap stack">
    <div class="band-head"><h2 id="h-dates">{t(lang, 'cal.title')}</h2><p>{t(lang, 'cal.line')}</p></div>
    {announcedDates.length > 0 && <><h3>{t(lang, 'notice.announcedTitle')}</h3><p>{t(lang, 'notice.announcedLine')}</p><NoticeList list={announcedDates} lang={lang} /></>}
    <h3>{t(lang, 'cal.lawTitle')}</h3>
    <LegalDates lang={lang} />
    <p class="small muted">{t(lang, 'cal.countyNote')}</p>
    <div class="btn-row"><a class="btn quiet" href={href(lang, '/have-your-say/')}>{t(lang, 'say.title')}</a></div>
  </div>
</section>
