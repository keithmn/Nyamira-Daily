---
// Search runs in the browser over one small file, so it needs no server. Nothing a reader types leaves their phone.
import { t } from '../../i18n/index.js';
import { YEAR, href } from '../../lib/routes.js';
import Breadcrumbs from '../Breadcrumbs.astro';
import SearchBox from '../SearchBox.astro';

interface Props { lang?: 'en' | 'sw' }
const { lang = 'en' } = Astro.props;
---
<div class="wrap">
  <Breadcrumbs lang={lang} trail={[{ name: t(lang, 'search.title') }]} />
  <div class="page-head"><h1>{t(lang, 'search.title')}</h1></div>
</div>
<section class="band">
  <div class="wrap stack gap-l" data-search data-index={href('en', `/data/search-${lang}.json`)} data-count={t(lang, 'search.results', { n: '{n}' })} data-one={t(lang, 'search.result')} data-none={t(lang, 'search.none')} data-types={JSON.stringify(Object.fromEntries(['county', 'sector', 'vote', 'programme'].map((k) => [k, t(lang, `search.type.${k}`)])))}>
    <SearchBox lang={lang} />
    <p class="no-js-note"><a href={href(lang, YEAR)}>{t(lang, 'search.noJs')}</a></p>
    <p role="status" data-search-count class="small muted"></p>
    <ul class="results" data-search-results></ul>
  </div>
</section>
