---
// Have your say (build brief 5.10): the next hearing only from an official notice, the dates the law fixes, and a
// memorandum builder. The builder sends nothing and keeps nothing; the reader copies the text and sends it themselves.
import { longDate } from '@kbe/engine/fmt';
import { t } from '../../i18n/index.js';
import { today } from '../../lib/figures.js';
import { memorandum } from '../../lib/memo.js';
import { memoTopics, memoWords } from '../../lib/memoTopics.js';
import Breadcrumbs from '../Breadcrumbs.astro';
import LegalDates from '../LegalDates.astro';

interface Props { lang?: 'en' | 'sw' }
const { lang = 'en' } = Astro.props;
const topics = memoTopics(lang), w = memoWords(lang);
const example = memorandum({ topic: topics.whole, from: '', date: longDate(today(), lang), ask: '', w });
const data = { w, lang, topics: [topics.whole, ...topics.votes, ...topics.counties] };
---
<div class="wrap"><Breadcrumbs lang={lang} trail={[{ name: t(lang, 'say.title') }]} /></div>
<section class="band">
  <div class="wrap stack gap-l">
    <div class="page-head"><h1>{t(lang, 'say.title')}</h1><p>{t(lang, 'say.line')}</p></div>
    <article class="card stack">
      <h2>{t(lang, 'say.nextTitle')}</h2>
      <p class="say-none">{t(lang, 'say.none')}</p>
      <p class="small muted">{t(lang, 'say.noneWhy')}</p>
    </article>
  </div>
</section>
<section class="band alt" aria-labelledby="h-dates">
  <div class="wrap stack">
    <div class="band-head"><h2 id="h-dates">{t(lang, 'cal.title')}</h2><p>{t(lang, 'cal.line')}</p></div>
    <LegalDates lang={lang} />
  </div>
</section>
<section class="band" aria-labelledby="h-memo" data-memo-builder>
  <div class="wrap stack gap-l">
    <div class="band-head"><h2 id="h-memo">{t(lang, 'memo.title')}</h2><p>{t(lang, 'memo.line')}</p></div>
    <form class="memo-form js-only stack" data-memo-form>
      <label for="memo-topic">{t(lang, 'memo.topic')}</label>
      <select id="memo-topic" name="topic">
        <option value="budget">{topics.whole.label}</option>
        <optgroup label={t(lang, 'memo.votes')}>{topics.votes.map((v) => <option value={v.id}>{v.label}</option>)}</optgroup>
        <optgroup label={t(lang, 'memo.counties')}>{topics.counties.map((c) => <option value={c.id}>{c.label}</option>)}</optgroup>
      </select>
      <label for="memo-from">{t(lang, 'memo.fromLabel')}</label>
      <input id="memo-from" name="from" autocomplete="name" />
      <label for="memo-ask">{t(lang, 'memo.askLabel')}</label>
      <textarea id="memo-ask" name="ask" rows="5"></textarea>
    </form>
    <div class="stack">
      <h3>{t(lang, 'memo.result')}</h3>
      <pre class="memo" data-memo tabindex="0" aria-label={t(lang, 'memo.result')}>{example}</pre>
      <div class="btn-row js-only"><button class="btn" type="button" data-copy={example} data-memo-copy data-done={t(lang, 'memo.copied')} data-fail={t(lang, 'fig.copyFailed')}>{t(lang, 'memo.copy')}</button></div>
      <p class="small muted">{t(lang, 'memo.private')}</p>
    </div>
  </div>
  <script type="application/json" data-memo-data set:html={JSON.stringify(data)}></script>
</section>
<script>import '../../scripts/memo.js';</script>
