---
// The first screen of the home page: where the budget is, the one number, and the reader's county. Phase 4 adds the rest.
import { fig, FY } from '../lib/figures.js';
import { money } from '@kbe/engine/fmt';
import { t } from '../i18n/index.js';
import CountyPicker from './CountyPicker.astro';
import FigureMeta from './FigureMeta.astro';
import SourceLine from './SourceLine.astro';
import StageTimeline from './StageTimeline.astro';

interface Props { lang?: 'en' | 'sw' }
const { lang = 'en' } = Astro.props;
const total = fig('statement.total.expenditure');
// The word sits smaller than the number, wherever each language puts it: KSh 4.82 trillion, KSh trilioni 4.82
const parts = money(total.value, total.unit, lang).split(' ');
const isWord = (p) => p !== 'KSh' && Number.isNaN(Number(p));
---
<section class="hero on-panel" aria-labelledby="h-hero">
  <div class="wrap hero-in">
    <StageTimeline lang={lang} />
    <div class="hero-grid">
      <div class="stack">
        <span class="eyebrow">{t(lang, 'hero.eyebrow', { fy: FY })}</span>
        <h1 id="h-hero" class="hero-num">{parts.map((p, i) => <>{i > 0 && ' '}{isWord(p) ? <small>{p}</small> : p}</>)}</h1>
        <p class="hero-line">{t(lang, 'hero.line')}</p>
        <FigureMeta label={total.label} stage={total.stage} lang={lang} />
        <SourceLine doc={total.doc} page={total.page} lang={lang} />
      </div>
      <CountyPicker lang={lang} />
    </div>
  </div>
</section>
