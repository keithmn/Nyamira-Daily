---
// The Kiswahili twin, which is how each component's long-Kiswahili state is seen. Left out of production builds.
import ComponentLibrary from '../../../components/ComponentLibrary.astro';
import { t } from '../../../i18n/index.js';
import Base from '../../../layouts/Base.astro';

export function getStaticPaths() {
  return import.meta.env.DEV || __KBE_PREVIEW__ ? [{ params: { page: 'components' } }] : [];
}
---
<Base lang="sw" path="/dev/components/" title={t('sw', 'meta.components')} noindex><ComponentLibrary lang="sw" /></Base>
