---
import { COUNTIES } from '@kbe/engine/counties';
import View from '../../../../../components/pages/CountySheet.astro';
import { t } from '../../../../../i18n/index.js';
import Sheet from '../../../../../layouts/Sheet.astro';

export function getStaticPaths() {
  return COUNTIES.map((c) => ({ params: { county: c.slug } }));
}
const { county } = Astro.params;
---
<Sheet lang="sw" title={t('sw', 'sheet.title', { name: COUNTIES.find((c) => c.slug === county).name })}><View lang="sw" slug={county} /></Sheet>
