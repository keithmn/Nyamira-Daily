---
import View from '../../../components/pages/CountyPage.astro';
import { t } from '../../../i18n/index.js';
import Base from '../../../layouts/Base.astro';
import { COUNTIES } from '@kbe/engine/counties';

export function getStaticPaths() {
  return COUNTIES.map((c) => ({ params: { county: c.slug } }));
}
const { county } = Astro.params;
---
<Base path={`/counties/${county}/`} title={t('en', 'county.title', { name: COUNTIES.find((c) => c.slug === county).name })}><View slug={county} /></Base>
