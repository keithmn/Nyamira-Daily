{
  "name": "nyamira-daily",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "pages:dev": "wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply nyamira-corrections --local",
    "db:migrate:remote": "wrangler d1 migrations apply nyamira-corrections --remote",
    "test": "node --test",
    "check:launch": "node scripts/check-launch.mjs",
    "check:national": "node scripts/national/check-national.mjs",
    "check:national:all": "npm run check:national && npm test && npm run test:national:site && npm audit",
    "release:national": "node scripts/national/release.mjs",
    "dev:national": "npm run dev -w @kbe/national",
    "build:national": "npm run build -w @kbe/national",
    "test:national:site": "npm run test:site -w @kbe/national",
    "test:national:visual": "npm run test:visual -w @kbe/national"
  },
  "dependencies": {
    "astro": "7.4.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "wrangler": "4.156.1"
  }
}
