{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyamira-daily",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-26",
  // The public address the build needs (scripts/site-config.js). Cloudflare Pages reads build variables from this file.
  "vars": { "ND_SITE_URL": "https://gusiidaily.org" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nyamira-corrections",
      "database_id": "1dc6105c-ebe4-4cee-bae7-a6313905d98e",
      "migrations_dir": "migrations"
    }
  ]
}
